mixin VariantCard
  .card&attributes(attributes)
    .card-body
      h4.card-title.mb-4 Product Details
      
      //- Electronics specific fields
      .product-type-fields.electronics-fields.d-none
        h5.mb-3 Specifications
        .row.g-3
          .col-12
            h6.text-body-highlight Processor
            input.form-control.mb-2(type='text' name='specifications.processor.name' placeholder='Processor Name')
            input.form-control.mb-2(type='number' name='specifications.processor.cores' placeholder='Number of Cores')
            input.form-control.mb-2(type='text' name='specifications.processor.speed' placeholder='Processor Speed')
            input.form-control.mb-2(type='text' name='specifications.processor.architecture' placeholder='Architecture')

          .col-12
            h6.text-body-highlight Memory
            input.form-control.mb-2(type='number' name='specifications.memory.ram' placeholder='RAM')
            select.form-select.mb-2(name='specifications.memory.ramUnit')
              option(value='GB') GB
              option(value='TB') TB
            input.form-control.mb-2(type='number' name='specifications.memory.storage' placeholder='Storage')
            select.form-select.mb-2(name='specifications.memory.storageUnit')
              option(value='GB') GB
              option(value='TB') TB
            select.form-select.mb-2(name='specifications.memory.storageType')
              option(value='SSD') SSD
              option(value='HDD') HDD
              option(value='Other') Other

          .col-12
            h6.text-body-highlight Display
            input.form-control.mb-2(type='number' name='specifications.display.size' placeholder='Display Size')
            input.form-control.mb-2(type='text' name='specifications.display.resolution' placeholder='Resolution')
            input.form-control.mb-2(type='text' name='specifications.display.technology' placeholder='Display Technology')
            input.form-control.mb-2(type='number' name='specifications.display.refreshRate' placeholder='Refresh Rate (Hz)')
            input.form-control.mb-2(type='number' name='specifications.display.brightness' placeholder='Brightness (nits)')
            .form-check.mb-3
              input.form-check-input(type='checkbox' name='specifications.display.hdr' id='hdrSupport')
              label.form-check-label(for='hdrSupport') HDR Support

          .col-12
            h6.text-body-highlight Ports
            .ports-container
              .port-item.mb-2
                input.form-control.mb-2(type='text' name='specifications.ports[0].type' placeholder='Port Type')
                input.form-control.mb-2(type='number' name='specifications.ports[0].quantity' placeholder='Quantity')
            button.btn.btn-phoenix-primary.w-100.mb-3.add-port-btn(type='button') Add Port

          .col-12
            h6.text-body-highlight Weight
            .row.g-2.mb-3
              .col-6
                input.form-control(type='number' name='weight.value' placeholder='Weight')
              .col-6
                select.form-select(name='weight.unit')
                  option(value='kg') kg
                  option(value='g') g
                  option(value='lb') lb

          .col-12
            h6.text-body-highlight Warranty
            input.form-control.mb-2(type='number' name='warranty.duration' placeholder='Warranty Duration (months)')
            input.form-control.mb-2(type='text' name='warranty.type' placeholder='Warranty Type')

        h5.mb-3.mt-3 Variants
        .variants-container
          .variant-item.mb-3
            input.form-control.mb-2(type='text' name='variants[0].color' placeholder='Color')
            input.form-control.mb-2(type='text' name='variants[0].colorHex' placeholder='Color Hex Code')
            input.form-control.mb-2(type='text' name='variants[0].sku' placeholder='SKU')
        button.btn.btn-phoenix-primary.w-100.add-variant-btn(type='button') Add Variant

      //- Clothing specific fields
      .product-type-fields.clothing-fields.d-none
        h5.mb-3 Clothing Details
        .row.g-3
          .col-12
            input.form-control.mb-2(
              type='text' 
              name='material' 
              placeholder='Material'
            )
            
            h6.text-body-highlight Material Composition
            .material-composition-container.mb-3
              .input-group.mb-2
                input.form-control(
                  type='text' 
                  name='materialComposition[0].material' 
                  placeholder='Material'
                )
                input.form-control(
                  type='number' 
                  name='materialComposition[0].percentage' 
                  placeholder='Percentage'
                  min='0'
                  max='100'
                )
            button.btn.btn-phoenix-primary.w-100.mb-3.add-composition-btn(type='button') Add Material Composition

            h6.text-body-highlight Care Instructions
            .care-instructions-container.mb-3
              .input-group.mb-2
                input.form-control(type='text' name='care[0]' placeholder='Care Instruction')
                button.btn.btn-outline-danger(type='button' onclick='this.closest(".input-group").remove()') ×
            button.btn.btn-phoenix-primary.w-100.mb-3.add-care-btn(type='button') Add Care Instruction

            input.form-control.mb-2(type='text' name='fit' placeholder='Fit Type')
            input.form-control.mb-2(type='text' name='season' placeholder='Season')
            select.form-select.mb-2(name='gender')
              option(value='') Select gender...
              option(value='men') Men
              option(value='women') Women
              option(value='unisex') Unisex
              option(value='kids') Kids
            
        h5.mb-3.mt-3 Variants
        .variants-container
          .variant-item.mb-3
            input.form-control.mb-2(type='text' name='variants[0].size' placeholder='Size')
            input.form-control.mb-2(type='text' name='variants[0].color' placeholder='Color')
            input.form-control.mb-2(type='text' name='variants[0].colorHex' placeholder='Color Hex Code')
            input.form-control.mb-2(type='text' name='variants[0].sku' placeholder='SKU')
        button.btn.btn-phoenix-primary.w-100.add-variant-btn(type='button') Add Variant

      //- Furniture specific fields
      .product-type-fields.furniture-fields.d-none
        h5.mb-3 Furniture Details
        .row.g-3
          .col-12
            h6.text-body-highlight Dimensions
            .row.g-2
              .col-4
                input.form-control.mb-2(type='number' name='dimensions.length' placeholder='Length')
              .col-4
                input.form-control.mb-2(type='number' name='dimensions.width' placeholder='Width')
              .col-4
                input.form-control.mb-2(type='number' name='dimensions.height' placeholder='Height')
            select.form-select.mb-3(name='dimensions.unit')
              option(value='cm') cm
              option(value='in') in

            h6.text-body-highlight Weight
            .row.g-2.mb-3
              .col-6
                input.form-control(type='number' name='weight.value' placeholder='Weight')
              .col-6
                select.form-select(name='weight.unit')
                  option(value='kg') kg
                  option(value='lb') lb
            
            h6.text-body-highlight Materials
            .materials-container
              .material-item.mb-2
                input.form-control.mb-2(type='text' name='materials[0].type' placeholder='Material Type')
                input.form-control.mb-2(type='text' name='materials[0].description' placeholder='Material Description')
            button.btn.btn-phoenix-primary.w-100.mb-3.add-material-btn(type='button') Add Material

            h6.text-body-highlight Assembly
            .form-check.mb-2
              input.form-check-input(type='checkbox' name='assembly.required' id='assemblyRequired')
              label.form-check-label(for='assemblyRequired') Assembly Required
            input.form-control.mb-2(type='text' name='assembly.estimatedTime' placeholder='Estimated Assembly Time')
            .form-check.mb-3
              input.form-check-input(type='checkbox' name='assembly.toolsIncluded' id='toolsIncluded')
              label.form-check-label(for='toolsIncluded') Tools Included

            h6.text-body-highlight Warranty
            input.form-control.mb-2(type='number' name='warranty.duration' placeholder='Warranty Duration (months)')
            input.form-control.mb-2(type='text' name='warranty.coverage' placeholder='Warranty Coverage')

        h5.mb-3.mt-3 Variants
        .variants-container
          .variant-item.mb-3
            input.form-control.mb-2(type='text' name='variants[0].color' placeholder='Color')
            input.form-control.mb-2(type='text' name='variants[0].colorHex' placeholder='Color Hex Code')
            input.form-control.mb-2(type='text' name='variants[0].sku' placeholder='SKU')
        button.btn.btn-phoenix-primary.w-100.add-variant-btn(type='button') Add Variant

        h5.mb-3.mt-3 Additional Details
        input.form-control.mb-2(type='text' name='style' placeholder='Style')
        input.form-control.mb-2(type='text' name='capacity' placeholder='Capacity')
        input.form-control.mb-2(type='text' name='roomType' placeholder='Room Types (comma-separated)')

        
