extends ../../../../layouts/LayoutTheme
include ../../../../layouts/LayoutCardAuth

block wrapperContent
  +LayoutCardBasic({img:37, page: 'sign-up'})
    .auth-form-box
      .text-center.mb-7
        a(href=`${CWD}${paths['default-dashboard']}`).d-flex.flex-center.text-decoration-none.mb-4
          +Logo({text:false,width:58}).fw-bolder.fs-3.d-inline-block
        h3.text-body-highlight Create Admin Account
        p.text-body-tertiary Join the e-commerce admin team
      
      //- Remove social buttons for admin registration
      .position-relative
        hr.bg-body-secondary.mt-5.mb-4
        .divider-content-center.bg-body-emphasis Enter your information
      
      form#adminSignUpForm
        .row.g-3.mb-3
          .col-sm-6
            label.form-label(for='firstName') First Name
            input#firstName.form-control(type='text' placeholder='John' required)
          .col-sm-6
            label.form-label(for='lastName') Last Name
            input#lastName.form-control(type='text' placeholder='Doe' required)
        
        .mb-3
          label.form-label(for='email') Email address
          .form-icon-container
            input#email.form-control.form-icon-input(type='email' placeholder='admin@example.com' required)
            span.fas.fa-envelope.text-body.fs-9.form-icon
        
        .mb-3
          label.form-label(for='phone') Phone Number
          .form-icon-container
            input#phone.form-control.form-icon-input(type='tel' placeholder='+1234567890' required)
            span.fas.fa-phone.text-body.fs-9.form-icon
        
        .mb-3
          label.form-label(for='role') Role
          select#role.form-select(required disabled)
            option(value='store_owner' selected) Store Owner
        
        .mb-3
          label.form-label(for='position') Position (Optional)
          input#position.form-control(type='text' placeholder='Store Manager')
        
        .mb-3
          label.form-label(for='department') Department (Optional)
          input#department.form-control(type='text' placeholder='Sales')
        
        .mb-3
          label.form-label(for='password') Password
          .form-icon-container(data-password)
            input#password.form-control.form-icon-input.pe-6(type='password' placeholder='Password' data-password-input required)
            span.fas.fa-key.text-body.fs-9.form-icon
            button.btn.px-3.py-0.h-100.position-absolute.top-0.end-0.fs-7.text-body-tertiary(type='button' data-password-toggle)
              span.uil.uil-eye.show
              span.uil.uil-eye-slash.hide
        
        .mb-3
          label.form-label(for='confirmPassword') Confirm Password
          .form-icon-container(data-password)
            input#confirmPassword.form-control.form-icon-input.pe-6(type='password' placeholder='Confirm Password' data-password-input required)
            span.fas.fa-key.text-body.fs-9.form-icon
            button.btn.px-3.py-0.h-100.position-absolute.top-0.end-0.fs-7.text-body-tertiary(type='button' data-password-toggle)
              span.uil.uil-eye.show
              span.uil.uil-eye-slash.hide
        
        .mb-3
          .form-check
            input#terms.form-check-input(type='checkbox' required)
            label.form-check-label(for='terms')
              | I agree to the 
              a(href='#') terms and conditions
              |  and 
              a(href='#') privacy policy
        
        button.btn.btn-primary.w-100.mb-3(type='submit') Create Account
        
        //- Loading spinner (hidden by default)
        .text-center.mb-3.d-none#loadingSpinner
          .spinner-border.spinner-border-sm.text-primary.me-2(role='status')
          span Creating account...
        
        //- Error message container
        .alert.alert-danger.d-none#errorMessage(role='alert')
          span#errorText
        
        //- Success message container
        .alert.alert-success.d-none#successMessage(role='alert')
          span#successText
      
      .text-center
        a.fs-9.fw-bold(href='/admin/auth/sign-in') Already have an account? Sign in

block append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('adminSignUpForm');
      const loadingSpinner = document.getElementById('loadingSpinner');
      const errorMessage = document.getElementById('errorMessage');
      const successMessage = document.getElementById('successMessage');
      const errorText = document.getElementById('errorText');
      const successText = document.getElementById('successText');
      
      // Hide messages initially
      function hideMessages() {
        errorMessage.classList.add('d-none');
        successMessage.classList.add('d-none');
      }
      
      // Show error message
      function showError(message) {
        hideMessages();
        errorText.textContent = message;
        errorMessage.classList.remove('d-none');
      }
      
      // Show success message
      function showSuccess(message) {
        hideMessages();
        successText.textContent = message;
        successMessage.classList.remove('d-none');
      }
      
      // Show/hide loading spinner
      function setLoading(loading) {
        if (loading) {
          loadingSpinner.classList.remove('d-none');
          form.querySelector('button[type="submit"]').disabled = true;
        } else {
          loadingSpinner.classList.add('d-none');
          form.querySelector('button[type="submit"]').disabled = false;
        }
      }
      
      // Password validation
      function validatePassword(password) {
        const minLength = 6;
        const hasUpperCase = /[A-Z]/.test(password);
        const hasLowerCase = /[a-z]/.test(password);
        const hasNumbers = /\d/.test(password);
        
        if (password.length < minLength) {
          return 'Password must be at least 6 characters long';
        }
        if (!hasUpperCase || !hasLowerCase) {
          return 'Password must contain both uppercase and lowercase letters';
        }
        if (!hasNumbers) {
          return 'Password must contain at least one number';
        }
        return null;
      }
      
      // Handle form submission
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const firstName = document.getElementById('firstName').value;
        const lastName = document.getElementById('lastName').value;
        const email = document.getElementById('email').value;
        const phone = document.getElementById('phone').value;
        const role = 'store_owner'; // Fixed role for sign-up
        const position = document.getElementById('position').value;
        const department = document.getElementById('department').value;
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const terms = document.getElementById('terms').checked;
        
        // Basic validation
        if (!firstName || !lastName || !email || !phone || !password || !confirmPassword) {
          showError('Please fill in all required fields');
          return;
        }
        
        if (!email.includes('@')) {
          showError('Please enter a valid email address');
          return;
        }
        
        if (password !== confirmPassword) {
          showError('Passwords do not match');
          return;
        }
        
        const passwordError = validatePassword(password);
        if (passwordError) {
          showError(passwordError);
          return;
        }
        
        if (!terms) {
          showError('Please agree to the terms and conditions');
          return;
        }
        
        setLoading(true);
        hideMessages();
        
        try {
          const response = await fetch('/api/v1/users/register', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              name: `${firstName} ${lastName}`,
              email: email,
              password: password,
              phone: phone,
              role: role,
              position: position || undefined,
              department: department || undefined,
              isAdmin: false
            })
          });
          
          const data = await response.json();
          
          if (response.ok && data.success) {
            showSuccess('Account created successfully! Redirecting to create store...');
            
            // Store the user email for future use
            if (data.user && data.user.email) {
              localStorage.setItem('userEmail', data.user.email);
            }
            
            // Redirect to create store page after a short delay
            setTimeout(() => {
              window.location.href = '/admin/create-store';
            }, 2000);
            
          } else {
            showError(data.message || 'Account creation failed. Please try again.');
          }
          
        } catch (error) {
          console.error('Sign up error:', error);
          showError('Network error. Please try again.');
        } finally {
          setLoading(false);
        }
      });
      
      // Check if user is already logged in
      const token = localStorage.getItem('adminToken');
      if (token) {
        // Redirect to admin index if already logged in
        window.location.href = '/admin/';
      }
    }); 