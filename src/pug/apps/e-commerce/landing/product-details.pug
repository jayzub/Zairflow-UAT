extends ../../../layouts/LayoutEcommerce
//- extends ../../../layouts/LayoutTheme
include ../../../mixins/e-commerce/Topbar
include ../../../mixins/e-commerce/Navbar
include ../../../mixins/e-commerce/homepage/Category
include ../../../mixins/e-commerce/homepage/TopDeals
include ../../../mixins/e-commerce/homepage/TopElectronics
include ../../../mixins/e-commerce/homepage/BestOffers
include ../../../mixins/e-commerce/homepage/Cta
include ../../../mixins/e-commerce/homepage/common
include ../../../mixins/common/Rating
include ../../../mixins/e-commerce/product-details/Reviews
include ../../../mixins/e-commerce/product-details/Details
include ../../../mixins/e-commerce/product-details/SimilarProducts
include ../../../mixins/e-commerce/product-details/ProductDetailsCard
include ../../../mixins/dashboard/common


append variables
  - var disableNavigationType = true;
  - var disableHorizontalNavbarShape = true;
  - var disableVerticalNavbarAppearance = true;
  - var disableHorizontalNavbarAppearance = true;


prepend styles
  link(href=`${CWD}vendors/swiper/swiper-bundle.min.css`, rel='stylesheet')
  link(href=`${CWD}vendors/dropzone/dropzone.css`, rel='stylesheet')
  link(href=`${CWD}vendors/glightbox/glightbox.min.css`, rel='stylesheet')

prepend scripts
  script(src=`${CWD}vendors/swiper/swiper-bundle.min.js`)
  script(src=`${CWD}vendors/dropzone/dropzone-min.js`)
  script(src=`${CWD}vendors/rater-js/index.js`)
  script(src=`${CWD}vendors/glightbox/glightbox.min.js`) 

block ecomContent

  .pt-5.pb-9
    +Section(null,'container-small').py-0
      nav.mb-3(aria-label='breadcrumb')
        ol.breadcrumb.mb-0
          - var crumbItems = (typeof breadcrumbs !== 'undefined' && breadcrumbs) ? breadcrumbs : []
          if crumbItems && crumbItems.length
            each crumb, idx in crumbItems
              if idx === crumbItems.length - 1
                li.breadcrumb-item.active(aria-current='page')= crumb.label
              else
                li.breadcrumb-item
                  a(href=crumb.href || '#!')= crumb.label
          else if product && product.productType
            // Fallback: productType only
            li.breadcrumb-item.active(aria-current='page')= product.productType
      +Details(product)
    +Section(null,'container-small').py-0
      ul#productTab.nav.nav-underline.fs-9.mb-4(role='tablist')
        li.nav-item
          a#description-tab.nav-link.active(data-bs-toggle='tab' href='#tab-description' role='tab' aria-controls='tab-description' aria-selected='true') Description
        li.nav-item
          a#specification-tab.nav-link(data-bs-toggle='tab' href='#tab-specification' role='tab' aria-controls='tab-specification' aria-selected='false') Specification
        li.nav-item
          a#reviews-tab.nav-link(data-bs-toggle='tab' href='#tab-reviews' role='tab' aria-controls='tab-reviews' aria-selected='false') Ratings &amp; Reviews
      .row.gx-3.gy-7
        .col-12.col-lg-7.col-xl-8 
          #productTabContent.tab-content
            #tab-description.tab-pane.pe-lg-6.pe-xl-12.fade.show.active.text-body-emphasis(role='tabpanel' aria-labelledby='description-tab')
              if product && product.description
                p.mb-5!= product.description
              if product && product.image && product.image.url
                a(href=product.image.url data-gallery=`gallery-description`)
                  img.img-fluid.mb-5.rounded-3(src=product.image.url, alt="")
            #tab-specification.tab-pane.pe-lg-6.pe-xl-12.fade(role='tabpanel' aria-labelledby='specification-tab')
              if product && product.specificationSections
                each section in product.specificationSections
                  h3.mb-0.ms-4.fw-bold= section.title
                  table.table
                    thead
                      tr
                        th(style='width: 40%') 
                        th(style='width: 60%')
                    tbody
                      each spec in section.specs
                        tr
                          td.bg-body-highlight.align-middle
                            h6.mb-0.text-body.text-uppercase.fw-bolder.px-4.fs-9.lh-sm= spec.label
                          td.px-5.mb-0= spec.value
            #tab-reviews.tab-pane.fade(role='tabpanel' aria-labelledby='reviews-tab')
              .bg-body-emphasis.rounded-3.p-4.border.border-translucent
                .row.g-3.justify-content-between.mb-4
                  .col-auto
                    .d-flex.align-items-center.flex-wrap
                      h2.fw-bolder.me-3 #{product ? product.rating || 0 : 0}
                        span.fs-8.text-body-quaternary.fw-bold /5
                      .me-3
                        +Rating(product ? product.rating || 0 : 0).fs-6
                      p.text-body.mb-0.fw-semibold.fs-7 #{product ? product.numReviews || 0 : 0} ratings and #{product && product.reviews ? product.reviews.length : 0} reviews
                  .col-auto
                    button.btn.btn-primary.rounded-pill(data-bs-toggle="modal" data-bs-target="#reviewModal") Rate this product

                // Review Modal
                #reviewModal.modal.fade(tabindex='-1' aria-hidden='true')
                  .modal-dialog.modal-dialog-centered
                    .modal-content.p-4
                      .d-flex.flex-between-center.mb-2
                        h5.modal-title.fs-8.mb-0 Your rating
                        button.btn.p-0.fs-10(type='button' data-bs-dismiss='modal' aria-label='Close') &times;

                      form#reviewForm(action=`/api/products/${product ? product._id || '' : ''}/reviews` method='POST')
                        .mb-3(data-rater!={starSize:32, step: .5})
                          input#rating(type='hidden' name='rating' required)
                        .mb-3
                          h5.text-body-highlight.mb-3 Review Title
                          input#reviewTitle.form-control(type='text' name='title' required placeholder='Brief summary of your review')
                        .mb-3
                          h5.text-body-highlight.mb-3 Your review
                          textarea#reviewComment.form-control(name='comment' rows='5' placeholder='Write your review' required)

                        .dropzone.dropzone-multiple.p-0.mb-3#review-images(data-dropzone)
                          .fallback
                            input(name='images' type='file' multiple accept='image/*')
                          .dz-preview.d-flex.flex-wrap
                          .dz-message.text-body-tertiary.text-opacity-85.fw-bold.fs-9.p-4(data-dz-message) 
                            | Drag your photos here 
                            span.text-body-secondary or 
                            button.btn.btn-link.p-0(type='button') Browse from device 
                            br
                            img.mt-3(src=`${CWD}assets/img/icons/image-icon.png`, width=24 alt="").me-2

                        .d-sm-flex.flex-between-center
                          .form-check.flex-1
                            input#reviewAnonymously.form-check-input(type='checkbox' name='anonymous')
                            label.form-check-label.mb-0.text-body-emphasis.fw-semibold(for='reviewAnonymously')
                              | Review anonymously
                          button.btn.ps-0(type='button' data-bs-dismiss='modal') Close
                          button.btn.btn-primary.rounded-pill(type='submit') Submit Review

                // Reviews List
                if product && product.reviews && product.reviews.length > 0
                  .mt-4
                    each review in product.reviews
                      .review.border-bottom.border-translucent.py-3
                        .d-flex.mb-3
                          if review.user && review.user.avatar
                            img.rounded-circle.me-2(src=review.user.avatar width='40' height='40' alt=review.user.name)
                          else
                            .rounded-circle.bg-body-tertiary.d-flex.align-items-center.justify-content-center.me-2(style='width: 40px; height: 40px')
                              i(data-feather='user')
                          .flex-1
                            .d-flex.justify-content-between.align-items-center
                              h6.mb-0= review.user ? review.user.name : 'Anonymous'
                              small.text-body-quaternary= new Date(review.dateCreated).toLocaleDateString()
                            +Rating(review.rating).fs-7
                            if review.title
                              h6.mt-2.mb-1.fw-bold= review.title
                            p.mb-0.text-body= review.comment
                            if review.images && review.images.length > 0
                              .review-images.mt-2
                                each image in review.images
                                  a(href=image data-gallery=`gallery-${review._id}`)
                                    img.img-fluid.rounded.me-2(src=image width='60' height='60' alt='Review image')
                else
                  .text-center.py-6
                    img(src=`${CWD}assets/img/icons/review-empty.png` alt='No reviews' width='120')
                    h5.mt-3 No reviews yet
                    p.text-body-quaternary Be the first to review this product
        .col-12.col-lg-5.col-xl-4
          +ProductDetailsCard
  +Section.py-0.mb-9
    +SimilarProducts(relatedProducts)
