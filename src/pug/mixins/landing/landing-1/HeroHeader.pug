mixin HeroHeader
	section.bg-body-emphasis.pb-8#home
		.container-small.hero-header-container.px-lg-7.px-xxl-3
			.row.align-items-center
				.col-12.col-lg-auto.order-0.order-md-1.text-end.order-1
					.position-relative.p-5.p-md-7.d-lg-none
						+Background({
							image: `${CWD}assets/img/bg/bg-23.png`,
							attrs: {
								style: {
									'background-size': 'contain'
								}
							}
						})
						.position-relative
							img.w-100.shadow-lg.d-dark-none.rounded-2(src=`${CWD}assets/img/bg/bg-31.png` alt='hero-header')
							img.w-100.shadow-lg.d-light-none.rounded-2(src=`${CWD}assets/img/bg/bg-30.png` alt='hero-header')
					.hero-image-container.position-absolute.top-0.bottom-0.end-0.d-none.d-lg-block
						.position-relative.h-100.w-100
							.position-absolute.h-100.top-0.d-flex.align-items-center.end-0.hero-image-container-bg
								img.pt-7.pt-md-0.w-100(src=`${CWD}assets/img/bg/bg-1-2.png` alt='hero-header')
							.position-absolute.h-100.top-0.d-flex.align-items-center.end-0
								img.pt-7.pt-md-0.w-100.shadow-lg.d-dark-none.rounded-2(src=`${CWD}assets/img/bg/bg-28.png` alt='hero-header')
								img.pt-7.pt-md-0.w-100.shadow-lg.d-light-none.rounded-2(src=`${CWD}assets/img/bg/bg-29.png` alt='hero-header')

				.col-12.col-lg-6.text-lg-start.text-center.pt-8.pb-6.order-0.position-relative
					h1.fs-3.fs-lg-2.fs-md-1.fs-lg-2.fs-xl-1.fs.fw-black.mb-4
						span.text-primary.me-3 Griffin
						| Multi-Tenant
						br
						| E-Commerce Platform
					p.mb-5 The ultimate solution for businesses looking to scale their e-commerce operations. Launch multiple stores, manage inventory, and grow your business with our powerful multi-tenant platform.
					.mb-4
						span.badge.bg-primary-subtle.text-primary.me-2.mb-2
							i.fas.fa-rocket.me-1
							| Launch in Minutes
						span.badge.bg-success-subtle.text-success.me-2.mb-2
							i.fas.fa-shield-alt.me-1
							| Enterprise Security
						span.badge.bg-warning-subtle.text-warning.me-2.mb-2
							i.fas.fa-chart-line.me-1
							| Advanced Analytics
					a.btn.btn-lg.btn-primary.rounded-pill.me-3(href=`/admin/auth/sign-up` role='button') Start Free Trial
					a.btn.btn-link.me-2.fs-8.p-0(href='#demo' role='button') Watch Demo
						span.fa-solid.fa-angle-right.ms-2.fs-9