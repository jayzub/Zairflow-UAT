extends ../../layouts/LayoutComponent

append variables

  -
    var pageHeader = {
      title: 'Interactions',
      description: 'Utility classes that change how users interact with contents of a website.',
      url: `https://getbootstrap.com/docs/${bootstrapVersion}/utilities/interactions/`,
      linkText: 'Interactions on Bootstrap'
    }
  -
    var rightNav = [
      {
        name: 'Text selection',
        id: '#text-selection',
      },
      {
        name: 'Pointer events',
        id: '#pointer-events',
      },
    ]

block component
  .mb-9
    +ComponentCard({
      title: 'Text selection',
      description: `Change the way in which the content is selected when the user interacts with it.`,
      anchor:true,
      descriptionClass:'mt-2'

    }).my-5
      .text-center.py-8
        h4.text-body-secondary Text Selection
        p.text-body-quaternary Text selection functionality has been simplified for e-commerce focus.

    +ComponentCard({
      title: 'Pointer events',
      description: 'Bootstrap provides <code>.pe-none</code> and <code>.pe-auto</code> classes to prevent or add element interactions.',
      anchor:true,
      descriptionClass:'mt-2'
    }).my-5
      .text-center.py-8
        h4.text-body-secondary Pointer Events
        p.text-body-quaternary Pointer events functionality has been simplified for e-commerce focus.

