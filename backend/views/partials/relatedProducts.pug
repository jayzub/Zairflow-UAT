section.sec-relate-product.bg0.p-t-45.p-b-105
  .container
    .p-b-45
      h3.ltext-106.cl5.txt-center Related Products
    
    //- Related Products Carousel
    .wrap-slick2
      .slick2
        if relatedProducts.length > 0
          each product in relatedProducts
            .item-slick2.p-l-15.p-r-15.p-t-15.p-b-15
              .block2
                .block2-pic.hov-img0
                  if product.image
                    a(href=`${API_URL}/products/${product._id}`)
                      img(src=`/${product.image}` alt=product.name)
                  
                  a.block2-btn.flex-c-m.stext-103.cl2.size-102.bg0.bor2.hov-btn1.p-lr-15.trans-04.js-show-modal1(href=`/product/${product._id}`)
                    | Quick View
                
                .block2-txt.flex-w.flex-t.p-t-14
                  .block2-txt-child1.flex-col-l
                    a.stext-104.cl4.hov-cl1.trans-04.js-name-b2.p-b-6(href=`/product/${product._id}`)
                      = product.name
                    
                    span.stext-105.cl3
                      | $#{product.price}
                  
                  .block2-txt-child2.flex-r.p-t-3
                    a.btn-addwish-b2.dis-block.pos-relative.js-addwish-b2(href='#')
                      img.icon-heart1.dis-block.trans-04(src='/images/icons/icon-heart-01.png' alt='ICON')
                      img.icon-heart2.dis-block.trans-04.ab-t-l(src='/images/icons/icon-heart-02.png' alt='ICON')
        else
          p.text-center No related products available. 