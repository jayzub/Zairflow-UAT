mixin ProfileCard(customerName, customerAvatar, joinedDate, totalSpent, lastOrderDate, totalOrders)
  - customerName = customerName || 'Customer'
  - customerAvatar = customerAvatar || `${CWD}assets/img/team/15.webp`
  - joinedDate = joinedDate || '—'
  - totalSpent = totalSpent != null ? '$' + Number(totalSpent).toFixed(0) : '$0'
  - lastOrderDate = lastOrderDate || '—'
  - totalOrders = totalOrders != null ? totalOrders : 0
  .card&attributes(attributes)
    .card-body
      .border-bottom.border-dashed.pb-4
        .row.align-items-center.g-3.g-sm-5.text-center.text-sm-start
          .col-12.col-sm-auto
            input#avatarFile.d-none(type="file")
            label.cursor-pointer.avatar.avatar-5xl(for="avatarFile")
              img.rounded-circle(src=customerAvatar, alt="")
          .col-12.col-sm-auto.flex-1
            h3= customerName
            p.text-body-secondary= 'Joined ' + joinedDate
            div
              a.me-2(href='#!')
                span.fab.fa-linkedin-in.text-body-quaternary.text-opacity-75.text-primary-hover
              a.me-2(href='#!')
                span.fab.fa-facebook.text-body-quaternary.text-opacity-75.text-primary-hover
              a(href='#!')
                span.fab.fa-twitter.text-body-quaternary.text-opacity-75.text-primary-hover

      //- .card-footer.border-0
      .d-flex.flex-between-center.pt-4
        div
          h6.mb-2.text-body-secondary Total Spent
          h4.fs-7.text-body-highlight.mb-0= totalSpent
        .text-end
          h6.mb-2.text-body-secondary Last Order
          h4.fs-7.text-body-highlight.mb-0= lastOrderDate
        .text-end
          h6.mb-2.text-body-secondary Total Orders
          h4.fs-7.text-body-highlight.mb-0= totalOrders 

mixin AddressCard(addressLine, customerEmail, customerPhone, defaultAddress)
  - addressLine = addressLine || 'No address set'
  - customerEmail = customerEmail || ''
  - customerPhone = customerPhone || ''
  - defaultAddress = defaultAddress || null
  - var defaultAddressJson = defaultAddress ? JSON.stringify(defaultAddress) : 'null'
  .card(data-address-card data-default-address=defaultAddressJson)&attributes(attributes)
    .card-body
      .border-bottom.border-dashed
        .d-flex.align-items-center.justify-content-between.flex-wrap.gap-2
          h4.mb-3.mb-0 Default Address
          .d-flex.gap-2
            if defaultAddress && defaultAddress._id
              button.btn.btn-link.p-0(type='button' data-action='edit-address' aria-label='Edit address')
                span.fas.fa-edit.fs-9.text-body-quaternary
            button.btn.btn-link.p-0(type='button' data-action='add-address' aria-label='Add address')
              span.fas.fa-plus.fs-9.text-body-quaternary.me-1
              span.d-none.d-sm-inline Add address

      .pt-4.mb-7.mb-lg-4.mb-xl-7
        .row.justify-content-between
          .col-auto
            h5.text-body-highlight Address
          .col-auto
            p.text-body-secondary= addressLine
      //- .card-footer.border-0
      .border-top.border-dashed.pt-4
        .row.flex-between-center.mb-2
          .col-auto
            h5.text-body-highlight.mb-0 Email
          .col-auto
            if customerEmail
              a.lh-1(href="mailto:" + customerEmail)= customerEmail
            else
              span.text-body-tertiary —
        .row.flex-between-center
          .col-auto
            h5.text-body-highlight.mb-0 Phone
          .col-auto
            if customerPhone
              a(href="tel:" + customerPhone)= customerPhone
            else
              span.text-body-tertiary —

    //- Address form modal (edit or add)
    #addressFormModal.modal.fade(tabindex='-1' aria-labelledby='addressFormModalLabel' aria-hidden='true' data-address-form-modal)
      .modal-dialog.modal-dialog-centered
        .modal-content
          .modal-header
            h5#addressFormModalLabel.modal-title Edit address
            button.btn.btn-close.p-1(type='button' data-bs-dismiss='modal' aria-label='Close')
          .modal-body
            form#addressForm(data-address-form)
              input#addressFormId(type='hidden' name='addressId' value='')
              .mb-3
                label.form-label(for='addressFormStreet') Street
                input#addressFormStreet.form-control(type='text' name='street' required placeholder='Street address')
              .mb-3
                label.form-label(for='addressFormApartment') Apartment / Suite
                input#addressFormApartment.form-control(type='text' name='apartment' placeholder='Apt, suite, etc.')
              .row.g-3.mb-3
                .col-6
                  label.form-label(for='addressFormCity') City
                  input#addressFormCity.form-control(type='text' name='city' required placeholder='City')
                .col-3
                  label.form-label(for='addressFormState') State
                  input#addressFormState.form-control(type='text' name='state' required placeholder='State')
                .col-3
                  label.form-label(for='addressFormZip') Zip
                  input#addressFormZip.form-control(type='text' name='zipCode' required placeholder='Zip')
              .mb-3
                label.form-label(for='addressFormCountry') Country
                input#addressFormCountry.form-control(type='text' name='country' required placeholder='Country' value='US')
              .mb-3
                label.form-label(for='addressFormPhone') Phone
                input#addressFormPhone.form-control(type='tel' name='phone' placeholder='Phone')
              .mb-3
                label.form-label(for='addressFormType') Address type
                select#addressFormType.form-select(name='type')
                  option(value='both') Shipping &amp; Billing
                  option(value='shipping') Shipping only
                  option(value='billing') Billing only
              .form-check.mb-3
                input#addressFormIsDefault.form-check-input(type='checkbox' name='isDefault' value='1')
                label.form-check-label(for='addressFormIsDefault') Set as default address
          .modal-footer
            button.btn.btn-phoenix-secondary(type='button' data-bs-dismiss='modal') Cancel
            button.btn.btn-phoenix-primary(type='submit' form='addressForm') Save address
