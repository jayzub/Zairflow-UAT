extends ../../../layouts/LayoutEcommerce
include ../../../mixins/e-commerce/cart/CartTable
include ../../../mixins/e-commerce/cart/SummaryCard

append variables
  - var disableNavigationType = true;
  - var disableHorizontalNavbarShape = true;
  - var disableVerticalNavbarAppearance = true;
  - var disableHorizontalNavbarAppearance = true;
  - var cartScopeType = typeof cartScopeType !== 'undefined' ? cartScopeType : 'marketplace';
  - var cartStoreId = typeof cartStoreId !== 'undefined' ? cartStoreId : '';

block ecomContent
  +Section(null,'container-small cart').pt-5.pb-9(data-cart-page data-cart-scope-type=cartScopeType data-cart-store-id=cartStoreId)
    nav.mb-3(aria-label='breadcrumb')
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a(href=(typeof isCustomerStorefront !== 'undefined' && isCustomerStorefront) ? '/home' : '#!') Home
        li.breadcrumb-item.active(aria-current='page') Cart
    h2.mb-6 Cart
    #cartSignInRequired.alert.alert-info(style='display: none;')
      | Please
      a.ms-1#cartSignInLink(href='/customers/sign-in') sign in
      |  to view your cart.
    #cartContent.row.g-5(style='display: none;')
      .col-12.col-lg-8
        +CartTable([])
      .col-12.col-lg-4
        +CartSummaryCard(cartScopeType, cartStoreId)

append scripts
  script.
    (function() {
      var page = document.querySelector('[data-cart-page]');
      if (!page) return;
      var scopeType = page.getAttribute('data-cart-scope-type') || 'marketplace';
      var storeId = page.getAttribute('data-cart-store-id') || '';
      var token = typeof localStorage !== 'undefined' && localStorage.getItem('customerToken');
      var apiBase = '/api/customers';

      function cartUrl() {
        var q = 'scopeType=' + encodeURIComponent(scopeType);
        if (scopeType === 'store' && storeId) q += '&storeId=' + encodeURIComponent(storeId);
        return apiBase + '/cart?' + q;
      }
      function cartApiUrl(path) {
        var q = 'scopeType=' + encodeURIComponent(scopeType);
        if (scopeType === 'store' && storeId) q += '&storeId=' + encodeURIComponent(storeId);
        return apiBase + path + '?' + q;
      }

      function parsePrice(value) {
        if (value == null) return null;
        if (typeof value === 'number' && !isNaN(value)) return value;
        if (typeof value === 'string') return parseFloat(value) || null;
        if (typeof value === 'object' && value.$numberDecimal != null) return parseFloat(value.$numberDecimal) || null;
        return null;
      }

      function formatPrice(p) {
        var n = parsePrice(p);
        return n != null && !isNaN(n) ? n.toFixed(2) : '0.00';
      }

      function itemPrice(item) {
        if (item.unitPrice != null && typeof item.unitPrice === 'number' && item.unitPrice > 0) return item.unitPrice;
        var product = item.product || {};
        var opts = item.options || {};
        var variants = product.variants;
        if (variants && Array.isArray(variants) && variants.length > 0) {
          var color = (opts.color != null && opts.color !== '') ? String(opts.color).trim() : '';
          var size = (opts.size != null && opts.size !== '') ? String(opts.size).trim() : '';
          var v = null;
          if (color && size) v = variants.find(function(x) { return String(x.color || '').trim() === color && String(x.size || '').trim() === size; });
          if (!v && color) v = variants.find(function(x) { return String(x.color || '').trim() === color; });
          if (!v && size) v = variants.find(function(x) { return String(x.size || '').trim() === size; });
          if (v) {
            var vReg = parsePrice(v.price);
            var vSale = parsePrice(v.salePrice);
            if (vSale != null && vSale > 0 && (vReg == null || vSale < vReg)) return vSale;
            return vReg != null ? vReg : 0;
          }
        }
        var reg = parsePrice(product.price);
        var sale = parsePrice(product.salePrice);
        if (sale != null && sale > 0 && (reg == null || sale < reg)) return sale;
        return reg != null ? reg : 0;
      }

      function itemOriginalPrice(item) {
        if (item.unitOriginalPrice != null && typeof item.unitOriginalPrice === 'number' && item.unitOriginalPrice >= 0) return item.unitOriginalPrice;
        var product = item.product || {};
        var opts = item.options || {};
        var variants = product.variants;
        if (variants && Array.isArray(variants) && variants.length > 0) {
          var color = (opts.color != null && opts.color !== '') ? String(opts.color).trim() : '';
          var size = (opts.size != null && opts.size !== '') ? String(opts.size).trim() : '';
          var v = null;
          if (color && size) v = variants.find(function(x) { return String(x.color || '').trim() === color && String(x.size || '').trim() === size; });
          if (!v && color) v = variants.find(function(x) { return String(x.color || '').trim() === color; });
          if (!v && size) v = variants.find(function(x) { return String(x.size || '').trim() === size; });
          if (v) { var vReg = parsePrice(v.price); return vReg != null ? vReg : 0; }
        }
        return parsePrice(product.price) != null ? parsePrice(product.price) : itemPrice(item);
      }

      function renderCart(cart) {
        var tbody = document.getElementById('cart-table-body');
        var subtotalEl = document.getElementById('cart-items-subtotal');
        var subtotalRow = document.getElementById('cart-items-subtotal-row');
        var summaryItemsSubtotal = document.getElementById('cart-summary-items-subtotal');
        var summaryDiscount = document.getElementById('cart-summary-discount');
        var summarySubtotal = document.getElementById('cart-summary-subtotal');
        var summaryTotal = document.getElementById('cart-summary-total');
        if (!tbody) return;
        var items = (cart && cart.items) || [];
        var itemsSubtotal = 0;
        var discountTotal = 0;
        var subtotal = 0;
        tbody.innerHTML = '';
        items.forEach(function(item) {
          var price = itemPrice(item);
          var originalPrice = itemOriginalPrice(item);
          var qty = Math.max(1, parseInt(item.quantity, 10) || 1);
          var total = price * qty;
          var lineOriginal = originalPrice * qty;
          var lineDiscount = Math.max(0, (originalPrice - price) * qty);
          itemsSubtotal += lineOriginal;
          discountTotal += lineDiscount;
          subtotal += total;
          var product = item.product || {};
          var name = product.name || 'Product';
          var imgUrl = (product.image && product.image.url) ? product.image.url : '';
          var color = (item.options && item.options.color) ? item.options.color : '-';
          var size = (item.options && item.options.size) ? item.options.size : '-';
          var onSale = originalPrice > price;
          var priceCell = onSale
            ? '<div class="d-flex flex-column align-items-end"><span class="text-body-tertiary text-decoration-line-through">$' + formatPrice(originalPrice) + '</span><span class="text-body fw-semibold">$' + formatPrice(price) + '</span></div>'
            : '<span class="text-body fw-semibold">$' + formatPrice(price) + '</span>';
          var row = document.createElement('tr');
          row.className = 'cart-table-row btn-reveal-trigger';
          row.setAttribute('data-item-id', item._id);
          row.innerHTML =
            '<td class="align-middle white-space-nowrap py-0">' +
              '<a href="/products/' + (product._id || '') + '" class="d-block border border-translucent rounded-2">' +
              '<img src="' + (imgUrl || '') + '" alt="" width="53" onerror="this.style.display=\'none\'">' +
              '</a></td>' +
            '<td class="products align-middle"><a class="fw-semibold mb-0 line-clamp-2" href="/products/' + (product._id || '') + '">' + name + '</a></td>' +
            '<td class="color align-middle white-space-nowrap fs-9 text-body">' + color + '</td>' +
            '<td class="size align-middle white-space-nowrap text-body-tertiary fs-9 fw-semibold">' + size + '</td>' +
            '<td class="price align-middle fs-9 text-end">' + priceCell + '</td>' +
            '<td class="quantity align-middle fs-8 ps-5">' +
              '<div class="input-group input-group-sm flex-nowrap" data-quantity>' +
              '<button type="button" class="btn btn-sm px-2" data-type="minus">-</button>' +
              '<input class="form-control text-center input-spin-none bg-transparent border-0 px-0" type="number" min="1" value="' + qty + '" aria-label="Quantity">' +
              '<button type="button" class="btn btn-sm px-2" data-type="plus">+</button></div></td>' +
            '<td class="total align-middle fw-bold text-body-highlight text-end" data-line-total>$' + formatPrice(total) + '</td>' +
            '<td class="align-middle white-space-nowrap text-end pe-0 ps-3">' +
              '<button type="button" class="btn btn-sm text-body-tertiary text-opacity-85 text-body-tertiary-hover me-2 cart-remove-item" data-item-id="' + item._id + '"><span class="fas fa-trash"></span></button></td>';
          tbody.appendChild(row);
          var qtyInput = row.querySelector('input[type="number"]');
          var minusBtn = row.querySelector('[data-type="minus"]');
          var plusBtn = row.querySelector('[data-type="plus"]');
          function updateQty() {
            var newQty = Math.max(1, parseInt(qtyInput.value, 10) || 1);
            fetch(cartApiUrl('/cart/items/' + item._id), {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
              credentials: 'same-origin',
              body: JSON.stringify({ quantity: newQty })
            }).then(function(r) {
              if (r.ok) return r.json();
              return r.json().then(function(e) { throw new Error(e.error || 'Update failed'); });
            }).then(function(data) {
              var lineTotal = row.querySelector('[data-line-total]');
              if (lineTotal) lineTotal.textContent = '$' + formatPrice(price * newQty);
              if (data && data.data) renderCart(data.data);
            }).catch(function(e) { alert(e.message || 'Could not update quantity'); });
          }
          if (minusBtn) minusBtn.addEventListener('click', function() { qtyInput.value = Math.max(1, (parseInt(qtyInput.value, 10) || 1) - 1); updateQty(); });
          if (plusBtn) plusBtn.addEventListener('click', function() { qtyInput.value = (parseInt(qtyInput.value, 10) || 1) + 1; updateQty(); });
          if (qtyInput) qtyInput.addEventListener('change', function() { updateQty(); });
          var removeBtn = row.querySelector('.cart-remove-item');
          if (removeBtn) removeBtn.addEventListener('click', function() {
            fetch(cartApiUrl('/cart/items/' + item._id), { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token }, credentials: 'same-origin' })
              .then(function(r) { if (r.ok) return r.json(); return r.json().then(function(e) { throw new Error(e.error); }); })
              .then(function(data) { if (data && data.data) renderCart(data.data); else loadCart(); })
              .catch(function(e) { alert(e.message || 'Could not remove item'); });
          });
        });
        if (subtotalEl) subtotalEl.textContent = '$' + formatPrice(subtotal);
        if (subtotalRow) subtotalRow.style.display = items.length ? '' : 'none';
        var summarySaleDiscount = document.getElementById('cart-summary-sale-discount');
        var summaryTax = document.getElementById('cart-summary-tax');
        var summaryShipping = document.getElementById('cart-summary-shipping');
        var promoDiscount = (cart.promoDiscount != null) ? Number(cart.promoDiscount) : 0;
        var estimatedTax = (cart.estimatedTax != null) ? Number(cart.estimatedTax) : 0;
        var estimatedShipping = (cart.estimatedShipping != null) ? Number(cart.estimatedShipping) : 0;
        var cartTotal = (cart.total != null) ? Number(cart.total) : subtotal;
        if (summaryItemsSubtotal) summaryItemsSubtotal.textContent = '$' + formatPrice(itemsSubtotal);
        if (summarySaleDiscount) summarySaleDiscount.textContent = discountTotal > 0 ? '-$' + formatPrice(discountTotal) : '$0.00';
        if (summaryDiscount) summaryDiscount.textContent = promoDiscount > 0 ? '-$' + formatPrice(promoDiscount) : '$0.00';
        if (summaryTax) summaryTax.textContent = '$' + formatPrice(estimatedTax);
        if (summaryShipping) summaryShipping.textContent = '$' + formatPrice(estimatedShipping);
        if (summaryTotal) summaryTotal.textContent = '$' + formatPrice(cartTotal);
        var checkoutBtn = document.getElementById('cartCheckoutBtn');
        if (checkoutBtn) {
          checkoutBtn.href = '/checkout?scopeType=' + encodeURIComponent(scopeType) + (scopeType === 'store' && storeId ? '&storeId=' + encodeURIComponent(storeId) : '');
          checkoutBtn.style.display = items.length ? '' : 'none';
          checkoutBtn.disabled = items.length === 0;
        }
        var promoInputGroup = document.getElementById('cartPromoInputGroup');
        var promoApplied = document.getElementById('cartPromoApplied');
        var promoCodeDisplay = document.getElementById('cartPromoCodeDisplay');
        if (cart.appliedPromoCode) {
          if (promoInputGroup) promoInputGroup.classList.add('d-none');
          if (promoApplied) { promoApplied.classList.remove('d-none'); promoApplied.classList.add('d-flex'); }
          if (promoCodeDisplay) promoCodeDisplay.textContent = 'Promo: ' + cart.appliedPromoCode;
        } else {
          if (promoInputGroup) promoInputGroup.classList.remove('d-none');
          if (promoApplied) { promoApplied.classList.add('d-none'); promoApplied.classList.remove('d-flex'); }
          if (promoCodeDisplay) promoCodeDisplay.textContent = '';
        }
      }

      function loadCart() {
        if (!token) {
          document.getElementById('cartSignInRequired').style.display = 'block';
          document.getElementById('cartContent').style.display = 'none';
          return;
        }
        document.getElementById('cartSignInRequired').style.display = 'none';
        document.getElementById('cartContent').style.display = 'flex';
        fetch(cartUrl(), { headers: { 'Authorization': 'Bearer ' + token }, credentials: 'same-origin' })
          .then(function(r) {
            if (r.status === 401) {
              token = null;
              window.location.href = '/customers/sign-in?redirect=' + encodeURIComponent(window.location.href);
              return null;
            }
            if (!r.ok) throw new Error('Could not load cart');
            return r.json();
          })
          .then(function(json) {
            if (json && json.data) renderCart(json.data);
          })
          .catch(function(e) { console.error(e); });
      }

      loadCart();

      var promoApplyBtn = document.getElementById('cartPromoApply');
      var promoInput = document.getElementById('cartPromoInput');
      var promoRemoveBtn = document.getElementById('cartPromoRemove');
      if (promoApplyBtn && promoInput) {
        promoApplyBtn.addEventListener('click', function() {
          var code = (promoInput.value || '').trim();
          if (!code) { alert('Enter a promo code'); return; }
          promoApplyBtn.disabled = true;
          var q = 'scopeType=' + encodeURIComponent(scopeType);
          if (scopeType === 'store' && storeId) q += '&storeId=' + encodeURIComponent(storeId);
          fetch(apiBase + '/cart/promo?' + q, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
            credentials: 'same-origin',
            body: JSON.stringify({ code: code })
          }).then(function(r) {
            if (r.ok) return r.json();
            return r.json().then(function(e) { throw new Error(e.error || 'Invalid promo'); });
          }).then(function(json) {
            if (json && json.data) renderCart(json.data);
          }).catch(function(e) { alert(e.message || 'Could not apply promo'); })
            .finally(function() { promoApplyBtn.disabled = false; });
        });
      }
      if (promoRemoveBtn) {
        promoRemoveBtn.addEventListener('click', function() {
          var q = 'scopeType=' + encodeURIComponent(scopeType);
          if (scopeType === 'store' && storeId) q += '&storeId=' + encodeURIComponent(storeId);
          fetch(apiBase + '/cart/promo?' + q, {
            method: 'DELETE',
            headers: { 'Authorization': 'Bearer ' + token },
            credentials: 'same-origin'
          }).then(function(r) {
            if (r.ok) return r.json();
            return r.json().then(function(e) { throw new Error(e.error); });
          }).then(function(json) {
            if (json && json.data) renderCart(json.data);
          }).catch(function(e) { alert(e.message || 'Could not remove promo'); });
        });
      }
    })();
