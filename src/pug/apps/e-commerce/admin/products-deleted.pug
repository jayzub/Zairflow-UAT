extends ../../../layouts/LayoutTheme
include ../../../mixins/dashboard/common
include ../../../mixins/e-commerce/ProductsTable

append variables
  -
    var breadcrumb = [
      { label: 'Products', href: `/${adminUrl || 'admin'}/products` },
      { label: 'Removed from catalog', active: true }
    ];

block content
  .mb-9
    .row.g-3.mb-4
      .col-auto
        h2.mb-0 #{pageTitle}
      .col-auto.ms-auto
        a.btn.btn-phoenix-primary(href=`/${adminUrl || 'admin'}/products`)
          span.fas.fa-arrow-left.me-2
          | Back to products

    .mb-3
      p.text-body-secondary.mb-0
        | Products removed from the catalog are hidden from the store. You can restore them from the list below.

    .d-flex.justify-content-between.align-items-center.mb-3.flex-wrap.gap-2
      #products-bulk-replace
        span.text-body-secondary
          | Showing #{productCount === 0 ? 0 : (currentPage - 1) * limit + 1} to #{Math.min(currentPage * limit, productCount)} of #{productCount} removed products
      #products-bulk-actions.d-none.d-flex.align-items-center.gap-2
        button#bulk-restore-btn.btn.btn-phoenix-primary.btn-sm(type='button')
          span.fas.fa-undo.me-1
          | Restore selected
        button#bulk-delete-btn.btn.btn-phoenix-danger.btn-sm(type='button')
          span.fas.fa-trash-alt.me-1
          | Delete selected
      if totalPages > 1
        nav(aria-label='Pagination')
          ul.pagination.pagination-sm.mb-0
            li.page-item(class=!hasPrevPage ? 'disabled' : '')
              a.page-link(href=hasPrevPage ? `?page=${currentPage - 1}&limit=${limit}` : '#') &laquo;
            each pageNum in pageRange
              if pageNum === '...'
                li.page-item.disabled
                  span.page-link &hellip;
              else
                li.page-item(class=pageNum === currentPage ? 'active' : '')
                  a.page-link(href=`?page=${pageNum}&limit=${limit}`)= pageNum
            li.page-item(class=!hasNextPage ? 'disabled' : '')
              a.page-link(href=hasNextPage ? `?page=${currentPage + 1}&limit=${limit}` : '#') &raquo;

    .mx-n4.px-4.mx-lg-n6.px-lg-6.bg-body-emphasis.border-top.border-bottom.border-translucent.position-relative.top-1
      if products && products.length > 0
        +ProductTable(products, { deletedPage: true, bulkSelectActionsId: 'products-bulk-actions', bulkSelectReplaceElementId: 'products-bulk-replace' })
      else
        .text-center.py-8
          p.text-body-secondary.mb-2 No removed products.
          a.btn.btn-phoenix-primary(href=`/${adminUrl || 'admin'}/products`) Back to products

append scripts
  script.
    function getSelectedProductIds() {
      var body = document.getElementById('products-table-body');
      if (!body) return [];
      var checkboxes = body.querySelectorAll('input[type="checkbox"][data-bulk-select-row]:checked');
      return Array.prototype.map.call(checkboxes, function(cb) {
        var tr = cb.closest('tr');
        return tr && tr.getAttribute('data-product-id');
      }).filter(Boolean);
    }
    function bulkRestoreSelected() {
      var ids = getSelectedProductIds();
      if (ids.length === 0) { alert('Select at least one product.'); return; }
      var done = 0, failed = 0;
      function runNext() {
        if (done + failed >= ids.length) {
          alert('Restored ' + done + ' product(s).' + (failed ? ' Failed: ' + failed + '.' : ''));
          ids.forEach(function(id) {
            var row = document.querySelector('[data-product-id="' + id + '"]');
            if (row) row.remove();
          });
          var body = document.getElementById('products-table-body');
          if (body) body.querySelectorAll('input[data-bulk-select-row]:checked').forEach(function(cb) { cb.checked = false; });
          document.getElementById('products-bulk-actions').classList.add('d-none');
          document.getElementById('products-bulk-replace').classList.remove('d-none');
          var header = document.getElementById('checkbox-bulk-products-select');
          if (header) { header.checked = false; header.removeAttribute('indeterminate'); }
          return;
        }
        var id = ids[done + failed];
        fetch('/admin/products/' + id + '/restore', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, credentials: 'include' })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) done++; else failed++;
            runNext();
          })
          .catch(function() { failed++; runNext(); });
      }
      runNext();
    }
    function bulkDeleteSelected() {
      var ids = getSelectedProductIds();
      if (ids.length === 0) { alert('Select at least one product.'); return; }
      if (!confirm('Permanently delete ' + ids.length + ' product(s)? This cannot be undone.')) return;
      var done = 0, failed = 0;
      function runNext() {
        if (done + failed >= ids.length) {
          alert('Deleted ' + done + ' product(s).' + (failed ? ' Failed: ' + failed + '.' : ''));
          ids.forEach(function(id) {
            var row = document.querySelector('[data-product-id="' + id + '"]');
            if (row) row.remove();
          });
          var body = document.getElementById('products-table-body');
          if (body) body.querySelectorAll('input[data-bulk-select-row]:checked').forEach(function(cb) { cb.checked = false; });
          document.getElementById('products-bulk-actions').classList.add('d-none');
          document.getElementById('products-bulk-replace').classList.remove('d-none');
          var header = document.getElementById('checkbox-bulk-products-select');
          if (header) { header.checked = false; header.removeAttribute('indeterminate'); }
          return;
        }
        var id = ids[done + failed];
        fetch('/admin/products/delete/' + id, { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, credentials: 'include' })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) done++; else failed++;
            runNext();
          })
          .catch(function() { failed++; runNext(); });
      }
      runNext();
    }
    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('bulk-restore-btn') && document.getElementById('bulk-restore-btn').addEventListener('click', bulkRestoreSelected);
      document.getElementById('bulk-delete-btn') && document.getElementById('bulk-delete-btn').addEventListener('click', bulkDeleteSelected);
    });
    function restoreProduct(productId) {
      fetch('/admin/products/' + productId + '/restore', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include'
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.success) {
            var row = document.querySelector('[data-product-id="' + productId + '"]');
            if (row) row.remove();
            alert('Product restored. It will appear in the main product list again.');
          } else {
            alert(data.message || 'Failed to restore product.');
          }
        })
        .catch(function(err) {
          console.error(err);
          alert('Error restoring product.');
        });
    }
    function hardDeleteProduct(productId) {
      if (!confirm('Permanently delete this product? This cannot be undone. The product and its main image will be removed.')) return;
      fetch('/admin/products/delete/' + productId, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include'
      })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.success) {
            var row = document.querySelector('[data-product-id="' + productId + '"]');
            if (row) row.remove();
            alert('Product permanently deleted.');
          } else {
            alert(data.message || 'Failed to delete product.');
          }
        })
        .catch(function(err) {
          console.error(err);
          alert('Error deleting product.');
        });
    }
