mixin OrganizeCard
  .card&attributes(attributes)
    .card-body
      h4.card-title.mb-4 Organize
      .row.gx-3
        .col-12.col-sm-6.col-xl-12
          .mb-4
            .d-flex.flex-wrap.mb-2
              h5.mb-0.text-body-highlight.me-2 Categories
              a.fw-bold.fs-9(href='#!') Add new category
            //- select.form-select.mb-3(aria-label='category')
            //-   option(value='men-cloth') Men's Clothing
            //-   option(value='women-cloth') Womens's Clothing
            //-   option(value='kid-cloth') Kid's Clothing

            .mb-3
              each category in categories
                .form-check
                  input.form-check-input(type='checkbox', id=`category-${category._id}`, name='category[]', value=category._id)
                  label.form-check-label(for=`category-${category._id}`)= category.name

        .col-12.col-sm-6.col-xl-12
          .mb-4
            .d-flex.flex-wrap.mb-2
              h5.mb-0.text-body-highlight.me-2 Vendor
              a.fw-bold.fs-9(href='#!') Add new vendor
            select.form-select.mb-3(aria-label='category')
              option(value='men-cloth') Men's Clothing
              option(value='women-cloth') Womens's Clothing
              option(value='kid-cloth') Kid's Clothing
        .col-12.col-sm-6.col-xl-12     
          .mb-4
            h5.mb-2.text-body-highlight Collection
            input.form-control.mb-xl-3(type='text' placeholder='Collection')
        .col-12.col-sm-6.col-xl-12
          .d-flex.flex-wrap.mb-2
            h5.mb-0.text-body-highlight.me-2 Tags
            a.fw-bold.fs-9.lh-sm(href='#!') View all tags
          select.form-select(aria-label='category')
            option(value='men-cloth') Men's Clothing
            option(value='women-cloth') Womens's Clothing
            option(value='kid-cloth') Kid's Clothing