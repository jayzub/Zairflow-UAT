mixin SimilarProducts(products)
  -
    var products = products || []

  .d-flex.flex-between-center.mb-3
    div
      h3 Similar Products
      p.mb-0.text-body-tertiary.fw-semibold Essential for a better life
    button.btn.btn-sm.btn-phoenix-primary View all

  .swiper-theme-container.products-slider
    .swiper.swiper.theme-slider(data-swiper!={
      slidesPerView: 1,
      spaceBetween: 16,
      breakpoints: {
        450: {
          slidesPerView: 2,
          spaceBetween: 16,
        },
        768: {
          slidesPerView: 3,
          spaceBetween: 16,
        },
        992: {
          slidesPerView: 4,
          spaceBetween: 16,
        },
        1200: {
          slidesPerView: 5,
          spaceBetween: 16,
        },
        1540: {
          slidesPerView: 6,
          spaceBetween: 16,
        },
      },
    })
      .swiper-wrapper
        if products && products.length
          each product in products
            .swiper-slide
              +Product(product)
        else
          .swiper-slide
            .text-center.text-body-tertiary.py-5 No similar products found
    .swiper-nav
      .swiper-button-next
        span.fas.fa-chevron-right.nav-icon
      .swiper-button-prev
        span.fas.fa-chevron-left.nav-icon