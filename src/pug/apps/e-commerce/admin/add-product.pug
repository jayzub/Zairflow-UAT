append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize TinyMCE
      tinymce.init({
        selector: '.tinymce',
        height: '15rem',
        plugins: 'lists link image table code help wordcount',
        toolbar: 'undo redo | blocks | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image',
        setup: function(editor) {
          editor.on('init', function() {
            console.log('TinyMCE initialized');
          });
        }
      });

      // Product type selection handler
      const productTypeSelect = document.querySelector('select[name="productType"]');
      const typeFields = document.querySelectorAll('.product-type-fields');

      productTypeSelect?.addEventListener('change', function() {
        typeFields.forEach(field => field.classList.add('d-none'));
        const selectedType = this.value.toLowerCase();
        document.querySelector(`.${selectedType}-fields`)?.classList.remove('d-none');
      });

      // Clothing: Material Composition handler
      document.querySelector('.add-composition-btn')?.addEventListener('click', function() {
        const container = document.querySelector('.material-composition-container');
        const newComposition = document.createElement('div');
        newComposition.className = 'input-group mb-2';
        newComposition.innerHTML = `
          <input class="form-control" type="text" name="materialComposition[][material]" placeholder="Material">
          <input class="form-control" type="number" name="materialComposition[][percentage]" placeholder="Percentage">
          <button class="btn btn-outline-danger" type="button" onclick="this.closest('.input-group').remove()">×</button>
        `;
        container.appendChild(newComposition);
      });

      // Clothing: Care Instructions handler
      document.querySelector('.add-care-btn')?.addEventListener('click', function() {
        const container = document.querySelector('.care-instructions-container');
        const newCare = document.createElement('div');
        newCare.className = 'input-group mb-2';
        newCare.innerHTML = `
          <input class="form-control" type="text" name="care[]" placeholder="Care Instruction">
          <button class="btn btn-outline-danger" type="button" onclick="this.closest('.input-group').remove()">×</button>
        `;
        container.appendChild(newCare);
      });

      // Clothing: Variant handler
      document.querySelector('.add-variant-btn')?.addEventListener('click', function() {
        const container = document.querySelector('.variants-container');
        const variantItems = container.querySelectorAll('.variant-item');
        const idx = variantItems.length;
        const newVariant = document.createElement('div');
        newVariant.className = 'variant-item mb-3';
        newVariant.innerHTML = `
          <div class="input-group">
            <input class="form-control mb-2" type="text" name="variants[${idx}][size]" placeholder="Size">
            <input class="form-control mb-2" type="text" name="variants[${idx}][color]" placeholder="Color">
            <input class="form-control mb-2" type="text" name="variants[${idx}][colorHex]" placeholder="Color Hex Code">
            <input class="form-control mb-2" type="text" name="variants[${idx}][sku]" placeholder="SKU">
            <button class="btn btn-outline-danger" type="button" onclick="this.closest('.variant-item').remove()">Remove Variant</button>
          </div>
        `;
        container.appendChild(newVariant);
      });

      // Furniture: Variant handler (separate for furniture-fields)
      document.querySelector('.furniture-fields .add-variant-btn')?.addEventListener('click', function() {
        const container = document.querySelector('.furniture-fields .variants-container');
        const variantItems = container.querySelectorAll('.variant-item');
        const idx = variantItems.length;
        const newVariant = document.createElement('div');
        newVariant.className = 'variant-item mb-3';
        newVariant.innerHTML = `
          <div class="input-group">
            <input class="form-control mb-2" type="text" name="variants[${idx}][color]" placeholder="Color">
            <input class="form-control mb-2" type="text" name="variants[${idx}][colorHex]" placeholder="Color Hex Code">
            <input class="form-control mb-2" type="text" name="variants[${idx}][sku]" placeholder="SKU">
            <button class="btn btn-outline-danger" type="button" onclick="this.closest('.variant-item').remove()">Remove Variant</button>
          </div>
        `;
        container.appendChild(newVariant);
      });

      // Furniture: Material handler (with index)
      document.querySelector('.add-material-btn')?.addEventListener('click', function() {
        const container = document.querySelector('.materials-container');
        const materialItems = container.querySelectorAll('.material-item');
        const idx = materialItems.length;
        const newMaterial = document.createElement('div');
        newMaterial.className = 'material-item mb-2';
        newMaterial.innerHTML = `
          <div class="input-group">
            <input class="form-control mb-2" type="text" name="materials[${idx}][type]" placeholder="Material Type">
            <input class="form-control mb-2" type="text" name="materials[${idx}][description]" placeholder="Material Description">
            <button class="btn btn-outline-danger" type="button" onclick="this.closest('.material-item').remove()">Remove Material</button>
          </div>
        `;
        container.appendChild(newMaterial);
      });

      // Electronics: Port handler
      document.querySelector('.electronics-fields .add-port-btn')?.addEventListener('click', function() {
        const container = document.querySelector('.electronics-fields .ports-container');
        const portItems = container.querySelectorAll('.port-item');
        const idx = portItems.length;
        const newPort = document.createElement('div');
        newPort.className = 'port-item mb-2';
        newPort.innerHTML = `
          <div class="input-group">
            <input class="form-control mb-2" type="text" name="specifications.ports[${idx}].type" placeholder="Port Type">
            <input class="form-control mb-2" type="number" name="specifications.ports[${idx}].quantity" placeholder="Quantity">
            <button class="btn btn-outline-danger" type="button" onclick="this.closest('.port-item').remove()">Remove Port</button>
          </div>
        `;
        container.appendChild(newPort);
      });

      // Electronics: Variant handler (fix index incrementation)
      document.querySelector('.electronics-fields .add-variant-btn')?.addEventListener('click', function() {
        const container = document.querySelector('.electronics-fields .variants-container');
        const variantItems = container.querySelectorAll('.variant-item');
        const idx = variantItems.length;
        const newVariant = document.createElement('div');
        newVariant.className = 'variant-item mb-3';
        newVariant.innerHTML = `
          <div class="input-group">
            <input class="form-control mb-2" type="text" name="variants[${idx}][color]" placeholder="Color">
            <input class="form-control mb-2" type="text" name="variants[${idx}][colorHex]" placeholder="Color Hex Code">
            <input class="form-control mb-2" type="text" name="variants[${idx}][sku]" placeholder="SKU">
            <button class="btn btn-outline-danger" type="button" onclick="this.closest('.variant-item').remove()">Remove Variant</button>
          </div>
        `;
        container.appendChild(newVariant);
      });

      // Initialize Dropzone only if not already initialized
      let dropzone;
      if (!document.querySelector("#productImages.dz-clickable")) {
        dropzone = new Dropzone("#productImages", {
          url: "/admin/products",
          autoProcessQueue: false,
          uploadMultiple: true,
          parallelUploads: 5,
          maxFiles: 5,
          acceptedFiles: "image/*",
          addRemoveLinks: true,
          paramName: "images",
          headers: {
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
          },
          withCredentials: true // Add this line for authentication
        });
      } else {
        dropzone = Dropzone.forElement("#productImages");
      }

      // Button handlers
      const form = document.getElementById('productForm');
      const discardBtn = document.getElementById('discardBtn');
      const saveDraftBtn = document.getElementById('saveDraftBtn');
      const publishBtn = document.getElementById('publishBtn');

      // Discard button handler
      discardBtn?.addEventListener('click', function() {
        if (confirm('Are you sure you want to discard this product?')) {
          window.location.href = '/admin/products';
        }
      });

      // Save draft button handler
      saveDraftBtn?.addEventListener('click', async function() {
        const formData = new FormData(form);
        formData.append('status', 'draft');
        await submitForm(formData);
      });

      // Publish button handler (form submit)
      form?.addEventListener('submit', async function(e) {
        e.preventDefault();
        console.log('Form submission started');

        // Basic validation
        const productType = this.querySelector('[name="productType"]').value;
        const name = this.querySelector('[name="name"]').value;
        const price = this.querySelector('[name="price"]').value;

        if (!productType || !name || !price) {
          alert('Please fill in all required fields (Product Type, Name, and Price)');
          return;
        }

        const formData = new FormData(this);
        formData.append('status', 'published');
        
        await submitForm(formData);
      });

      // Form submission helper function
      async function submitForm(formData) {
        try {
          console.log('Submitting form data...');
          
          // Check if user is authenticated
          const authCheck = await fetch('/api/users/profile', {
            method: 'GET',
            credentials: 'include'
          });
          
          if (!authCheck.ok) {
            console.error('Authentication failed:', authCheck.status);
            alert('Authentication failed. Please log in again.');
            window.location.href = '/admin/auth/sign-in';
            return;
          }
          
          publishBtn.disabled = true;
          publishBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Publishing...';

          // Create a new FormData object for the cleaned data
          const cleanedFormData = new FormData();

          // Add basic fields
          cleanedFormData.append('name', formData.get('name').trim());
          
          // Get description from TinyMCE with error handling
          let description = '';
          try {
            const editor = tinymce.get('description');
            if (editor) {
              description = editor.getContent();
            } else {
              description = formData.get('description') || '';
            }
          } catch (e) {
            console.error('Error getting TinyMCE content:', e);
            description = formData.get('description') || '';
          }
          cleanedFormData.append('description', description);

          cleanedFormData.append('price', formData.get('price'));
          cleanedFormData.append('productType', formData.get('productType'));
          cleanedFormData.append('status', formData.get('status'));

          // Add optional fields if they have values
          const optionalFields = ['salePrice', 'countInStock', 'vendor', 'brand'];
          optionalFields.forEach(field => {
            const value = formData.get(field);
            if (value && value.trim() !== '') {
              cleanedFormData.append(field, value.trim());
            }
          });

          // Handle boolean fields
          const isFeatured = formData.get('isFeatured') === 'on';
          cleanedFormData.append('isFeatured', isFeatured);

          // Handle Clothing specific data
          if (formData.get('productType') === 'Clothing') {
            const clothingFields = ['material', 'fit', 'season', 'gender'];
            clothingFields.forEach(field => {
              const value = formData.get(field);
              if (value && value.trim() !== '') {
                cleanedFormData.append(field, value.trim());
              }
            });

            // Handle materialComposition array
            const materialCompositionInputs = document.querySelectorAll('input[name^="materialComposition["]');
            const materialComposition = [];
            for (let i = 0; i < materialCompositionInputs.length; i += 2) {
              const materialInput = materialCompositionInputs[i];
              const percentageInput = materialCompositionInputs[i + 1];
              const material = materialInput ? materialInput.value : '';
              const percentage = percentageInput ? percentageInput.value : '';
              if (material && percentage) {
                materialComposition.push({ material, percentage: Number(percentage) });
              }
            }
            if (materialComposition.length > 0) {
              cleanedFormData.append('materialComposition', JSON.stringify(materialComposition));
            }

            // Handle care instructions array
            const careInputs = document.querySelectorAll('input[name^="care["]');
            const care = Array.from(careInputs)
              .map(input => input ? input.value : '')
              .filter(value => value.trim() !== '');
            if (care.length > 0) {
              cleanedFormData.append('care', JSON.stringify(care));
            }

            // Handle variants array
            const variantItems = document.querySelectorAll('.variant-item');
            const variants = Array.from(variantItems).map(item => {
              const sizeInput = item.querySelector('input[name^="variants["][name$="[size]"]');
              const colorInput = item.querySelector('input[name^="variants["][name$="[color]"]');
              const colorHexInput = item.querySelector('input[name^="variants["][name$="[colorHex]"]');
              const skuInput = item.querySelector('input[name^="variants["][name$="[sku]"]');
              return {
                size: sizeInput ? sizeInput.value : '',
                color: colorInput ? colorInput.value : '',
                colorHex: colorHexInput ? colorHexInput.value : '',
                sku: skuInput ? skuInput.value : ''
              };
            }).filter(variant => variant.size || variant.color || variant.colorHex || variant.sku);
            if (variants.length > 0) {
              cleanedFormData.append('variants', JSON.stringify(variants));
            }
          }

          // Handle Furniture specific data
          if (formData.get('productType') === 'Furniture') {
            // Dimensions
            const length = formData.get('dimensions.length');
            const width = formData.get('dimensions.width');
            const height = formData.get('dimensions.height');
            const unit = formData.get('dimensions.unit');
            if (length || width || height || unit) {
              const dimensions = {
                length: length ? Number(length) : undefined,
                width: width ? Number(width) : undefined,
                height: height ? Number(height) : undefined,
                unit: unit || 'cm'
              };
              cleanedFormData.append('dimensions', JSON.stringify(dimensions));
            }

            // Weight
            const weightValue = formData.get('weight.value');
            const weightUnit = formData.get('weight.unit');
            if (weightValue || weightUnit) {
              const weight = {
                value: weightValue ? Number(weightValue) : undefined,
                unit: weightUnit || 'kg'
              };
              cleanedFormData.append('weight', JSON.stringify(weight));
            }

            // Materials (array, with index)
            const materialItems = document.querySelectorAll('.furniture-fields .materials-container .material-item');
            const materials = Array.from(materialItems).map(item => {
              const typeInput = item.querySelector('input[name$="[type]"]');
              const descInput = item.querySelector('input[name$="[description]"]');
              return {
                type: typeInput ? typeInput.value : '',
                description: descInput ? descInput.value : ''
              };
            }).filter(mat => mat.type || mat.description);
            if (materials.length > 0) {
              cleanedFormData.append('materials', JSON.stringify(materials));
            }

            // Assembly (object)
            const assemblyRequired = formData.get('assembly.required') === 'on';
            const estimatedTime = formData.get('assembly.estimatedTime');
            const toolsIncluded = formData.get('assembly.toolsIncluded') === 'on';
            if (assemblyRequired || estimatedTime || toolsIncluded) {
              const assembly = {
                required: assemblyRequired,
                estimatedTime: estimatedTime || '',
                toolsIncluded: toolsIncluded
              };
              cleanedFormData.append('assembly', JSON.stringify(assembly));
            }

            // Warranty (object, ensure duration is number)
            const warrantyDuration = formData.get('warranty.duration');
            const warrantyCoverage = formData.get('warranty.coverage');
            if (warrantyDuration !== '' || warrantyCoverage) {
              const warranty = {
                duration: warrantyDuration !== '' ? Number(warrantyDuration) : undefined,
                coverage: warrantyCoverage || ''
              };
              cleanedFormData.append('warranty', JSON.stringify(warranty));
            }

            // Room Type (array)
            const roomType = formData.get('roomType');
            if (roomType && roomType.trim() !== '') {
              const roomTypeArr = roomType.split(',').map(s => s.trim()).filter(Boolean);
              cleanedFormData.append('roomType', JSON.stringify(roomTypeArr));
            }

            // Handle variants array for Furniture (with index)
            const furnitureVariantItems = document.querySelectorAll('.furniture-fields .variants-container .variant-item');
            const furnitureVariants = Array.from(furnitureVariantItems).map(item => {
              const colorInput = item.querySelector('input[name$="[color]"]');
              const colorHexInput = item.querySelector('input[name$="[colorHex]"]');
              const skuInput = item.querySelector('input[name$="[sku]"]');
              return {
                color: colorInput ? colorInput.value : '',
                colorHex: colorHexInput ? colorHexInput.value : '',
                sku: skuInput ? skuInput.value : ''
              };
            }).filter(variant => variant.color || variant.colorHex || variant.sku);
            if (furnitureVariants.length > 0) {
              cleanedFormData.append('variants', JSON.stringify(furnitureVariants));
            }

            // Additional details (only style and capacity)
            const additionalFields = ['style', 'capacity'];
            additionalFields.forEach(field => {
              const value = formData.get(field);
              if (value && value.trim() !== '') {
                cleanedFormData.append(field, value.trim());
              }
            });
          }

          // Handle Electronics specific data
          if (formData.get('productType') === 'Electronics') {
            // Collect ports
            const portItems = document.querySelectorAll('.electronics-fields .ports-container .port-item');
            const ports = Array.from(portItems).map(item => {
              const typeInput = item.querySelector('input[name$=".type"]');
              const quantityInput = item.querySelector('input[name$=".quantity"]');
              return {
                type: typeInput ? typeInput.value : '',
                quantity: quantityInput ? Number(quantityInput.value) : undefined
              };
            }).filter(port => port.type || port.quantity);

            // Collect specifications
            const specifications = {
              processor: {
                name: formData.get('specifications.processor.name') || '',
                cores: formData.get('specifications.processor.cores') ? Number(formData.get('specifications.processor.cores')) : undefined,
                speed: formData.get('specifications.processor.speed') || '',
                architecture: formData.get('specifications.processor.architecture') || ''
              },
              memory: {
                ram: formData.get('specifications.memory.ram') ? Number(formData.get('specifications.memory.ram')) : undefined,
                ramUnit: formData.get('specifications.memory.ramUnit') || '',
                storage: formData.get('specifications.memory.storage') ? Number(formData.get('specifications.memory.storage')) : undefined,
                storageUnit: formData.get('specifications.memory.storageUnit') || '',
                storageType: formData.get('specifications.memory.storageType') || ''
              },
              display: {
                size: formData.get('specifications.display.size') ? Number(formData.get('specifications.display.size')) : undefined,
                resolution: formData.get('specifications.display.resolution') || '',
                technology: formData.get('specifications.display.technology') || '',
                refreshRate: formData.get('specifications.display.refreshRate') ? Number(formData.get('specifications.display.refreshRate')) : undefined,
                brightness: formData.get('specifications.display.brightness') ? Number(formData.get('specifications.display.brightness')) : undefined,
                hdr: formData.get('specifications.display.hdr') === 'on'
              },
              ports: ports
            };
            cleanedFormData.append('specifications', JSON.stringify(specifications));

            // Weight
            const weightValue = formData.get('weight.value');
            const weightUnit = formData.get('weight.unit');
            if (weightValue || weightUnit) {
              const weight = {
                value: weightValue ? Number(weightValue) : undefined,
                unit: weightUnit || 'kg'
              };
              cleanedFormData.append('weight', JSON.stringify(weight));
            }

            // Warranty
            const warrantyDuration = formData.get('warranty.duration');
            const warrantyType = formData.get('warranty.type');
            if (warrantyDuration !== '' || warrantyType) {
              const warranty = {
                duration: warrantyDuration !== '' ? Number(warrantyDuration) : undefined,
                type: warrantyType || ''
              };
              cleanedFormData.append('warranty', JSON.stringify(warranty));
            }

            // Handle variants array for Electronics (with index)
            const electronicsVariantItems = document.querySelectorAll('.electronics-fields .variants-container .variant-item');
            const electronicsVariants = Array.from(electronicsVariantItems).map(item => {
              const colorInput = item.querySelector('input[name$="[color]"]');
              const colorHexInput = item.querySelector('input[name$="[colorHex]"]');
              const skuInput = item.querySelector('input[name$="[sku]"]');
              return {
                color: colorInput ? colorInput.value : '',
                colorHex: colorHexInput ? colorHexInput.value : '',
                sku: skuInput ? skuInput.value : ''
              };
            }).filter(variant => variant.color || variant.colorHex || variant.sku);
            if (electronicsVariants.length > 0) {
              cleanedFormData.append('variants', JSON.stringify(electronicsVariants));
            }
          }

          // Add images from Dropzone
          const files = dropzone.getAcceptedFiles();
          files.forEach((file) => {
            cleanedFormData.append('images', file);
          });

          // Add categories
          const selectedCategories = Array.from(document.querySelectorAll('select[name="category"] option:checked'))
            .map(option => option.value);
          if (selectedCategories.length > 0) {
            cleanedFormData.append('category', JSON.stringify(selectedCategories));
          }

          // Add tags
          const selectedTags = Array.from(document.querySelectorAll('select[name="tags[]"] option:checked'))
            .map(option => option.value);
          if (selectedTags.length > 0) {
            cleanedFormData.append('tags', JSON.stringify(selectedTags));
          }

          // Log the cleaned form data
          console.log('Cleaned form data:');
          for (let [key, value] of cleanedFormData.entries()) {
            console.log(`${key}: ${value}`);
          }

          const response = await fetch('/admin/products', {
            method: 'POST',
            body: cleanedFormData,
            credentials: 'include' // Add this line for authentication
          });

          console.log('Response status:', response.status);
          console.log('Response headers:', Object.fromEntries(response.headers.entries()));

          if (!response.ok) {
            const errorText = await response.text();
            console.error('Error response:', errorText);
            throw new Error(`HTTP error! status: ${response.status}`);
          }

          const contentType = response.headers.get('content-type');
          console.log('Content-Type:', contentType);

          let result;
          if (contentType && contentType.includes('application/json')) {
            result = await response.json();
          } else {
            const text = await response.text();
            console.error('Non-JSON response:', text.substring(0, 500));
            throw new Error('Server returned non-JSON response. Check authentication.');
          }

          console.log('Server response:', result);

          if (result.success) {
            window.location.href = '/admin/products';
          } else {
            throw new Error(result.error || 'Error creating product');
          }
        } catch (error) {
          console.error('Error details:', error);
          alert('Error creating product: ' + error.message);
        } finally {
          publishBtn.disabled = false;
          publishBtn.innerHTML = 'Publish product';
        }
      }
    });

