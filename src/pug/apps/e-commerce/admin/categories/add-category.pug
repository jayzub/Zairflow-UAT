extends ../../../../layouts/LayoutTheme
include ../../../../mixins/dashboard/common
include ../../../../mixins/e-commerce/categories/CategoryForm
include ../../../../mixins/e-commerce/categories/CategoryAttributes
include ../../../../mixins/e-commerce/categories/CategoryDisplay
include ../../../../mixins/dashboard/common

prepend styles
  link(href=`${CWD}vendors/choices/choices.min.css`, rel='stylesheet')
  link(href=`${CWD}vendors/flatpickr/flatpickr.min.css`, rel='stylesheet')

prepend scripts
  script(src=`${CWD}vendors/choices/choices.min.js`)
  script(src=`${CWD}vendors/flatpickr/flatpickr.min.js`)

append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize Choices for select elements
      const choices = new Choices('.form-select', {
        removeItemButton: true,
        placeholder: true,
        placeholderValue: 'Select an option'
      });

      // Initialize color picker
      const colorPicker = document.querySelector('input[name="color"]');
      if (colorPicker) {
        colorPicker.addEventListener('input', function() {
          const colorPreview = document.querySelector('.color-preview');
          if (colorPreview) {
            colorPreview.style.backgroundColor = this.value;
          }
        });
      }

      // Product type selection handler
      const productTypeSelect = document.querySelector('select[name="allowedProductTypes"]');
      const attributeFields = document.querySelectorAll('.attribute-fields');

      productTypeSelect?.addEventListener('change', function() {
        attributeFields.forEach(field => field.classList.add('d-none'));
        const selectedTypes = Array.from(this.selectedOptions).map(option => option.value);
        selectedTypes.forEach(type => {
          document.querySelector(`.${type.toLowerCase()}-attributes`)?.classList.remove('d-none');
        });
      });

      // Add attribute handler
      document.querySelector('.add-attribute-btn')?.addEventListener('click', function() {
        const container = document.querySelector('.attributes-container');
        const attributeItems = container.querySelectorAll('.attribute-item');
        const idx = attributeItems.length;
        const newAttribute = document.createElement('div');
        newAttribute.className = 'attribute-item mb-3 border rounded p-3';
        newAttribute.innerHTML = `
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Attribute Name</label>
              <input class="form-control" type="text" name="attributes[${idx}][name]" placeholder="e.g., Size, Color, Material" required>
            </div>
            <div class="col-md-3">
              <label class="form-label">Type</label>
              <select class="form-select" name="attributes[${idx}][type]" required>
                <option value="">Select type</option>
                <option value="string">Text</option>
                <option value="number">Number</option>
                <option value="boolean">Boolean</option>
                <option value="date">Date</option>
                <option value="object">Object</option>
                <option value="array">Array</option>
              </select>
            </div>
            <div class="col-md-2">
              <label class="form-label">Required</label>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="attributes[${idx}][required]" id="required_${idx}">
                <label class="form-check-label" for="required_${idx}">Required</label>
              </div>
            </div>
            <div class="col-md-2">
              <label class="form-label">Unit</label>
              <input class="form-control" type="text" name="attributes[${idx}][unit]" placeholder="e.g., cm, kg">
            </div>
            <div class="col-md-1">
              <button class="btn btn-outline-danger btn-sm" type="button" onclick="this.closest('.attribute-item').remove()">
                <i class="fas fa-times"></i>
              </button>
            </div>
          </div>
          <div class="row mt-2">
            <div class="col-12">
              <label class="form-label">Options (comma-separated)</label>
              <input class="form-control" type="text" name="attributes[${idx}][options]" placeholder="Small, Medium, Large">
            </div>
          </div>
        `;
        container.appendChild(newAttribute);
      });

      // Auto-generate slug from name
      const nameInput = document.querySelector('input[name="name"]');
      const slugInput = document.querySelector('input[name="slug"]');
      
      nameInput?.addEventListener('input', function() {
        const slug = this.value
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '') // Remove special characters except spaces and hyphens
          .replace(/\s+/g, '-') // Replace spaces with hyphens
          .replace(/-+/g, '-') // Replace multiple hyphens with single hyphen
          .replace(/^-+|-+$/g, ''); // Remove leading/trailing hyphens
        slugInput.value = slug;
      });

      // Populate product types from backend config
      async function populateProductTypes() {
        try {
          const response = await fetch('/admin/product-types/config');
          if (response.ok) {
            const result = await response.json();
            const productTypeSelect = document.querySelector('#allowedProductTypes');
            
            // Clear existing options
            productTypeSelect.innerHTML = '';
            
            // Add fetched product types
            result.data.forEach(type => {
              const option = document.createElement('option');
              option.value = type.name;
              option.textContent = type.displayName || type.name;
              productTypeSelect.appendChild(option);
            });
          }
        } catch (error) {
          console.error('Failed to fetch product types:', error);
          // Fallback to hardcoded options if API fails
          const productTypeSelect = document.querySelector('#allowedProductTypes');
          const fallbackTypes = ['Electronics', 'Clothing', 'Furniture', 'Books'];
          fallbackTypes.forEach(type => {
            const option = document.createElement('option');
            option.value = type;
            option.textContent = type;
            productTypeSelect.appendChild(option);
          });
        }
      }

      // Call the function when page loads
      populateProductTypes();

      // Button handlers
      const form = document.getElementById('categoryForm');
      const discardBtn = document.getElementById('discardBtn');
      const saveDraftBtn = document.getElementById('saveDraftBtn');
      const publishBtn = document.getElementById('publishBtn');

      // Discard button handler
      discardBtn?.addEventListener('click', function() {
        if (confirm('Are you sure you want to discard this category?')) {
          window.location.href = '/admin/categories';
        }
      });

      // Save draft button handler
      saveDraftBtn?.addEventListener('click', async function() {
        const formData = new FormData(form);
        formData.append('isActive', 'false');
        await submitForm(formData);
      });

      // Publish button handler (form submit)
      form?.addEventListener('submit', async function(e) {
        e.preventDefault();
        console.log('Form submission started');

        // Basic validation
        const name = this.querySelector('[name="name"]').value;
        const allowedProductTypes = this.querySelector('[name="allowedProductTypes"]').value;

        if (!name || !allowedProductTypes) {
          alert('Please fill in all required fields (Name and Allowed Product Types)');
          return;
        }

        const formData = new FormData(this);
        formData.append('isActive', 'true');
        
        await submitForm(formData);
      });

      // Form submission helper function
      async function submitForm(formData) {
        try {
          console.log('Submitting form data...');
          
          publishBtn.disabled = true;
          publishBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating...';

          // Create a regular object for the data
          const formDataObj = {};

          // Add basic fields
          formDataObj.name = formData.get('name').trim();
          formDataObj.slug = formData.get('slug').trim() || '';
          formDataObj.description = formData.get('description') || '';
          formDataObj.icon = formData.get('icon') || '';
          formDataObj.color = formData.get('color') || '';
          formDataObj.isActive = formData.get('isActive') || 'true';

          // Add optional fields if they have values
          const displayOrder = formData.get('displayOrder');
          if (displayOrder && displayOrder.trim() !== '') {
            formDataObj.displayOrder = displayOrder.trim();
          }
          
          // Handle parent category (convert to ObjectId if present)
          const parent = formData.get('parent');
          if (parent && parent.trim() !== '') {
            formDataObj.parent = parent.trim();
          }

          // Handle allowed product types (multiple select)
          const allowedProductTypes = Array.from(document.querySelectorAll('select[name="allowedProductTypes"] option:checked'))
            .map(option => option.value);
          if (allowedProductTypes.length > 0) {
            formDataObj.allowedProductTypes = allowedProductTypes;
          }

          // Handle attributes array
          const attributeItems = document.querySelectorAll('.attribute-item');
          const attributes = Array.from(attributeItems).map(item => {
            const nameInput = item.querySelector('input[name$="[name]"]');
            const typeInput = item.querySelector('select[name$="[type]"]');
            const requiredInput = item.querySelector('input[name$="[required]"]');
            const unitInput = item.querySelector('input[name$="[unit]"]');
            const optionsInput = item.querySelector('input[name$="[options]"]');
            
            return {
              name: nameInput ? nameInput.value : '',
              type: typeInput ? typeInput.value : '',
              required: requiredInput ? requiredInput.checked : false,
              unit: unitInput ? unitInput.value : '',
              options: optionsInput ? optionsInput.value.split(',').map(s => s.trim()).filter(Boolean) : []
            };
          }).filter(attr => attr.name && attr.type);
          
          if (attributes.length > 0) {
            formDataObj.attributes = attributes;
          }

          // Log the form data
          console.log('Form data to send:', formDataObj);

          const response = await fetch('/admin/categories', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(formDataObj),
            credentials: 'include'
          });

          console.log('Response status:', response.status);
          console.log('Response headers:', Object.fromEntries(response.headers.entries()));

          if (!response.ok) {
            const errorText = await response.text();
            console.error('Error response:', errorText);
            
            // Handle specific error cases
            if (response.status === 401) {
              alert('Authentication failed. Please log in again.');
              window.location.href = '/admin/auth/sign-in';
              return;
            } else if (response.status === 403) {
              alert('Access denied. You do not have permission to create categories.');
              return;
            } else {
              throw new Error(`HTTP error! status: ${response.status}`);
            }
          }

          const result = await response.json();
          console.log('Server response:', result);

          if (result.success) {
            window.location.href = '/admin/categories';
          } else {
            throw new Error(result.message || 'Error creating category');
          }
        } catch (error) {
          console.error('Error details:', error);
          alert('Error creating category: ' + error.message);
        } finally {
          publishBtn.disabled = false;
          publishBtn.innerHTML = 'Create category';
        }
      }
    });

append variables
  - var pageTitle = 'Add Category'

block content
  form.mb-9#categoryForm(action="/admin/categories" method="POST")
    .row.g-3.flex-between-end.mb-5
      .col-auto
        h2.mb-2 #{pageTitle}
        h5.text-body-tertiary.fw-semibold Create a new Category
      .col-auto
        button.btn.btn-phoenix-secondary.me-2.mb-2.mb-sm-0(type='button' id='discardBtn') Discard
        button.btn.btn-phoenix-primary.me-2.mb-2.mb-sm-0(type='button' id='saveDraftBtn') Save draft
        button.btn.btn-primary.mb-2.mb-sm-0(type='submit' id='publishBtn') Create category
    .row.g-5
      .col-12.col-xl-8
        +CategoryForm({ categories })
        +CategoryAttributes

      .col-12.col-xl-4
        .row.g-2
          .col-12.col-xl-12
            +CategoryDisplay 