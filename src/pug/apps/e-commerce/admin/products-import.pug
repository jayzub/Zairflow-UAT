extends ../../../layouts/LayoutTheme
include ../../../mixins/dashboard/common

append variables
  -
    var breadcrumb = [
      { label: 'Products', href: `/${adminUrl || 'admin'}/products` },
      { label: 'Import', active: true }
    ];

block content
  .mb-9
    .row.g-3.mb-4
      .col-auto
        h2.mb-0 #{pageTitle}

    .card.mb-4
      .card-header
        h5.mb-0 Upload CSV File
      .card-body
        form#importForm
          .mb-3
            label.form-label(for='csvFile') CSV file
            input.form-control#csvFile(
              type='file'
              name='csv'
              accept='.csv'
              required
            )
            .form-text Upload a CSV file with product data. First row must be headers.
            .form-text.text-body-tertiary.mt-1
              | Max file size: #{typeof importMaxSize !== 'undefined' ? importMaxSize : '5MB'}. Max data rows: #{typeof importMaxRows !== 'undefined' ? importMaxRows : '500'}.
          .mb-3
            a.btn.btn-link.px-0(href=`/${adminUrl || 'admin'}/products/import/template` download)
              span.fas.fa-download.me-2
              | Download template
          button.btn.btn-primary#submitBtn(type='submit' disabled)
            span.spinner-border.spinner-border-sm.me-2.d-none(role='status' aria-hidden='true')
            | Import products

    #results.card.d-none
      .card-header
        h5.mb-0 Import results
      .card-body
        #resultsSummary.mb-4
        #resultsErrors.d-none
          .d-flex.justify-content-between.align-items-center.mb-2
            h6.text-danger.mb-0 Failed rows
            button#downloadErrorsCsvBtn.btn.btn-outline-danger.btn-sm(type='button' style='display:none;')
              span.fas.fa-download.me-1
              | Download error CSV
          .table-responsive
            table.table.table-sm
              thead
                tr
                  th Row
                  th Message
                  th Data
              tbody#resultsErrorsBody

append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('importForm');
      const fileInput = document.getElementById('csvFile');
      const submitBtn = document.getElementById('submitBtn');
      const resultsCard = document.getElementById('results');
      const resultsSummary = document.getElementById('resultsSummary');
      const resultsErrors = document.getElementById('resultsErrors');
      const resultsErrorsBody = document.getElementById('resultsErrorsBody');
      const spinner = submitBtn?.querySelector('.spinner-border');

      fileInput?.addEventListener('change', function() {
        submitBtn.disabled = !this.files?.length;
      });

      form?.addEventListener('submit', async function(e) {
        e.preventDefault();
        if (!fileInput?.files?.length) return;

        submitBtn.disabled = true;
        spinner?.classList.remove('d-none');
        resultsCard.classList.add('d-none');

        const formData = new FormData();
        formData.append('csv', fileInput.files[0]);

        try {
          const res = await fetch('/admin/products/import', {
            method: 'POST',
            body: formData,
            credentials: 'include'
          });
          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.message || 'Import failed');
          }

          resultsSummary.innerHTML = `
            <p class="mb-1"><strong>Created:</strong> ${data.created}</p>
            <p class="mb-1"><strong>Failed:</strong> ${data.failed}</p>
            <p class="mb-0"><strong>Total rows:</strong> ${data.total}</p>
          `;

          if (data.errors && data.errors.length) {
            resultsErrors.classList.remove('d-none');
            window._lastImportErrors = data.errors;
            var downloadBtn = document.getElementById('downloadErrorsCsvBtn');
            if (downloadBtn) {
              downloadBtn.style.display = '';
              downloadBtn.onclick = function() { downloadErrorCsv(window._lastImportErrors); };
            }
            resultsErrorsBody.innerHTML = data.errors.map(function(err) {
              const dataStr = err.data ? '<code>' + JSON.stringify(err.data) + '</code>' : '-';
              return '<tr><td>' + err.row + '</td><td>' + (err.message || '') + '</td><td>' + dataStr + '</td></tr>';
            }).join('');
          } else {
            resultsErrors.classList.add('d-none');
            window._lastImportErrors = null;
            var downloadBtn = document.getElementById('downloadErrorsCsvBtn');
            if (downloadBtn) downloadBtn.style.display = 'none';
          }

          resultsCard.classList.remove('d-none');
        } catch (err) {
          resultsSummary.innerHTML = '<p class="text-danger">' + (err.message || 'Import failed') + '</p>';
          resultsErrors.classList.add('d-none');
          resultsCard.classList.remove('d-none');
        } finally {
          submitBtn.disabled = false;
          spinner?.classList.add('d-none');
        }
      });

      function escapeCsvCell(val) {
        if (val == null) return '';
        var s = String(val);
        if (/[",\n\r]/.test(s)) return '"' + s.replace(/"/g, '""') + '"';
        return s;
      }

      function downloadErrorCsv(errors) {
        if (!errors || !errors.length) return;
        var headers = ['Row', 'Error Message', 'Name', 'Product Type', 'Category', 'Vendor'];
        var rows = [headers.map(escapeCsvCell).join(',')];
        errors.forEach(function(err) {
          var d = err.data || {};
          rows.push([
            err.row,
            err.message || '',
            d.name != null ? d.name : '',
            d.productType != null ? d.productType : '',
            d.category != null ? (Array.isArray(d.category) ? d.category.join('; ') : d.category) : '',
            d.vendor != null ? d.vendor : ''
          ].map(escapeCsvCell).join(','));
        });
        var csv = rows.join('\r\n');
        var blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'import-errors-' + new Date().toISOString().slice(0, 19).replace(/[-:T]/g, '').replace(' ', '-') + '.csv';
        a.click();
        URL.revokeObjectURL(url);
      }
    });
