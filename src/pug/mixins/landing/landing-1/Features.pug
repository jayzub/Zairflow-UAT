mixin Features
	+Section('container-small px-lg-7 px-xxl-3').pt-15.pb-0#feature
		.position-relative.z-2
			.row
				.col-lg-6.text-center.text-lg-start.pe-xxl-3
					h4.text-primary.fw-bolder.mb-4 Features
					h2.mb-3.text-body-emphasis.lh-base Multi-Tenant E-Commerce 
						br.d-md-none
						| Platform Built for Scale
					p.mb-5 Griffin empowers businesses to launch and manage multiple e-commerce stores from a single platform. Our multi-tenant architecture ensures security, scalability, and seamless operations for growing businesses.
					a.btn.btn-lg.btn-outline-primary.rounded-pill.me-2(href='#pricing' role='button') Explore Plans
						i.fa-solid.fa-angle-right.ms-2
				.col-sm-6.col-lg-3.mt-7.text-center.text-lg-start
					.h-100.d-flex.flex-column.justify-content-between
						.border-start-lg.border-translucent.border-dashed.ps-4
							img.mb-4(src=`${CWD}assets/img/icons/illustrations/bolt.png` width="48" height="48" alt='')
							div
								h5.fw-bolder.mb-2 Multi-Store Management
								p.fw-semibold.lh-sm Launch and manage unlimited stores from a single dashboard. Each store operates independently with its own branding and settings.
							div
								a.btn.btn-link.me-2.p-0.fs-9(href='#demo' role='button') See Demo
									span.fa-solid.fa-angle-right.ms-2

				.col-sm-6.col-lg-3.mt-7.text-center.text-lg-start
					.h-100.d-flex.flex-column
						.border-start-lg.border-translucent.border-dashed.ps-4
							img.mb-4(src=`${CWD}assets/img/icons/illustrations/pie.png` width="48" height="48" alt='')
							div
								h5.fw-bolder.mb-2 Advanced Analytics
								p.fw-semibold.lh-sm Track performance across all stores with comprehensive analytics, inventory management, and real-time reporting.
							div
								a.btn.btn-link.me-2.p-0.fs-9(href='#demo' role='button') See Demo
									i.fa-solid.fa-angle-right.ms-2

			.row.mt-12.align-items-center.justify-content-between.text-center.text-lg-start.mb-6.mb-lg-0
				.col-lg-5
					img.feature-image.img-fluid.mb-9.mb-lg-0.d-dark-none(src=`${CWD}assets/img/spot-illustrations/22_2.png`  alt='')
					img.feature-image.img-fluid.mb-9.mb-lg-0.d-light-none(src=`${CWD}assets/img/spot-illustrations/dark_22.png`  alt='')
				.col-lg-6
					h6.text-primary.mb-2.ls-2 SECURITY
					h3.fw-bolder.mb-3 Enterprise-Grade Security
					p.mb-4.px-md-7.px-lg-0 Each tenant's data is completely isolated and secure. Our platform ensures your business data and customer information are protected with industry-leading security measures.

					a.btn.btn-link.me-2.p-0.fs-9(href='#demo' role='button') Learn More
						i.fa-solid.fa-angle-right.ms-2

			.row.mt-2.align-items-center.justify-content-between.text-center.text-lg-start.mb-6.mb-lg-0
				.col-lg-5.order-0.order-lg-1
					img.feature-image.img-fluid.mb-9.mb-lg-0.d-dark-none(src=`${CWD}assets/img/spot-illustrations/23_2.png` height='394' alt='')
					img.feature-image.img-fluid.mb-9.mb-lg-0.d-light-none(src=`${CWD}assets/img/spot-illustrations/dark_23.png` height='394' alt='')
				.col-lg-6
					h6.text-primary.mb-2.ls-2 SCALABILITY
					h3.fw-bolder.mb-3 Scale Without Limits
					p.mb-4.px-md-7.px-lg-0 Start with one store and scale to hundreds. Our platform grows with your business, handling increased traffic, inventory, and transactions seamlessly.

					a.btn.btn-link.me-2.p-0.fs-9(href='#demo' role='button') Learn More
						i.fa-solid.fa-angle-right.ms-2

			.row.mt-2.align-items-center.justify-content-between.text-center.text-lg-start.mb-6.mb-lg-0
				.col-lg-5
					img.feature-image.img-fluid.mb-9.mb-lg-0.d-dark-none(src=`${CWD}assets/img/spot-illustrations/24_2.png` height='394' alt='')
					img.feature-image.img-fluid.mb-9.mb-lg-0.d-light-none(src=`${CWD}assets/img/spot-illustrations/dark_24.png` height='394' alt='')
				.col-lg-6.text-center.text-lg-start
					h6.text-primary.mb-2.ls-2 INTEGRATION
					h3.fw-bolder.mb-3 Seamless Integrations
					p.mb-4.px-md-7.px-lg-0 Connect with your favorite payment gateways, shipping providers, and marketing tools. Our API-first approach ensures easy integration with your existing workflow.
					a.btn.btn-link.me-2.p-0.fs-9(href='#demo' role='button') Learn More
						i.fa-solid.fa-angle-right.ms-2
