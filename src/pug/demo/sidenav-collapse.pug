extends ../layouts/LayoutTheme

append variables
  - var attrsHtml = Object.assign(attrsHtml, { class: 'navbar-vertical-collapsed' })
  - var disableNavigationType = true;

append headScripts
  if ENV === 'PROD'
    script.
      window.config.set({
        phoenixIsNavbarVerticalCollapsed: true
      });

block content
  .container-fluid
    .row
      .col-12
        h1.mb-4 Demo: Sidenav Collapse
        p.text-body-secondary This is a demo page showing collapsed sidenav layout.

block afterWrapperContent