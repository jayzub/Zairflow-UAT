mixin ShippingDetails
	h3.mb-4 Shipping Address
	.mb-3
		label.form-label.fs-8.text-body-highlight(for='checkoutAddressSelect') Saved address
		select#checkoutAddressSelect.form-select
			option(value='') New address
	.row.g-3.mt-2
		.col-12
			label.form-label.fs-8.text-body-highlight(for='inputShippingAddress1') Address line 1
			input#inputShippingAddress1.form-control(type='text' placeholder='Street address' aria-label='Address line 1')
		.col-12
			label.form-label.fs-8.text-body-highlight(for='inputShippingAddress2') Address line 2
			input#inputShippingAddress2.form-control(type='text' placeholder='Apt, suite, etc. (optional)' aria-label='Address line 2')
		.col-md-6
			label.form-label.fs-8.text-body-highlight(for='inputShippingCity') City
			input#inputShippingCity.form-control(type='text' placeholder='City' aria-label='City')
		.col-md-6
			label.form-label.fs-8.text-body-highlight(for='inputShippingZip') Zip code
			input#inputShippingZip.form-control(type='text' placeholder='Zip' aria-label='Zip code')
		.col-md-6
			label.form-label.fs-8.text-body-highlight(for='inputShippingCountry') Country
			input#inputShippingCountry.form-control(type='text' placeholder='Country' value='US' aria-label='Country')
		.col-md-6
			label.form-label.fs-8.text-body-highlight(for='inputShippingPhone') Phone
			input#inputShippingPhone.form-control(type='tel' placeholder='Phone' aria-label='Phone')

mixin BillingInfo
	h3.mb-4 Billing Details
	.form-check.mb-3
		input.form-check-input#sameAsShipping(type='checkbox' checked)
		label.form-check-label.fs-8.fw-normal(for='sameAsShipping') Same as shipping address
	#checkout-billing-fields.d-none
		.row.g-3
			.col-12
				label.form-label.fs-8.text-body-highlight(for='inputBillingAddress1') Billing address line 1
				input#inputBillingAddress1.form-control(type='text' placeholder='Street address' aria-label='Billing address line 1')
			.col-12
				label.form-label.fs-8.text-body-highlight(for='inputBillingAddress2') Billing address line 2
				input#inputBillingAddress2.form-control(type='text' placeholder='Apt, suite (optional)' aria-label='Billing address line 2')
			.col-md-6
				label.form-label.fs-8.text-body-highlight(for='inputBillingCity') City
				input#inputBillingCity.form-control(type='text' placeholder='City' aria-label='Billing city')
			.col-md-6
				label.form-label.fs-8.text-body-highlight(for='inputBillingZip') Zip code
				input#inputBillingZip.form-control(type='text' placeholder='Zip' aria-label='Billing zip')
			.col-md-6
				label.form-label.fs-8.text-body-highlight(for='inputBillingCountry') Country
				input#inputBillingCountry.form-control(type='text' placeholder='Country' value='US' aria-label='Billing country')

mixin ShippingRadio(data)
	.col-12.col-md-6
		.d-flex.flex-wrap.align-items-center.mb-3
			.form-check.mb-0
				input.form-check-input(type='radio' name='shippingRadio' checked=data.checked id=data.id)
				label.form-check-label.fs-8.text-body(for=data.id)=data.shipping
			span.d-inline-block.text-body-emphasis.fw-bold.ms-2=data.price

			if data.badge
				span.badge.badge-phoenix.badge-phoenix-warning.ms-2.ms-lg-4.ms-xl-2=data.badge
		.ps-4
			h6.text-body-tertiary.mb-2 Est. delivery: 
				!=data.date
			h6.text-info.lh-base.mb-0=data.time

mixin DeliveryType(data)
	h3.mb-5 Delivery Type
	#checkout-shipping-methods
		.text-body-tertiary.small.py-2 Loading shipping options...

mixin PaymentMethod
	h3.mb-5 Payment Method
	.row.g-4.mb-4
		.col-12
			.d-flex.flex-wrap.gap-3
				.form-check
					input.form-check-input#paymentCard(type='radio' name='checkoutPaymentMethod' value='card')
					label.form-check-label.fs-8.text-body.d-flex.align-items-center.gap-2(for='paymentCard')
						| Credit card
						img.h-100(src=`${CWD}assets/img/logos/visa.png`, alt='' style='max-height: 1.25rem;')
						img.h-100(src=`${CWD}assets/img/logos/mastercard.png`, alt='' style='max-height: 1.25rem;')
				.form-check
					input.form-check-input#paymentCod(type='radio' name='checkoutPaymentMethod' value='cod' checked)
					label.form-check-label.fs-8.text-body(for='paymentCod') Cash on delivery
	#checkout-card-element-wrap.d-none.mb-4
		label.form-label.fs-8.text-body-highlight Card details
		#checkout-card-element.form-control(style='padding: 0.75rem; min-height: 2.5rem;')
		.small.text-body-tertiary.mt-1 Card payment is secured by Stripe. We do not store your card number.
	.row.g-2.mb-5.mb-lg-0
		.col-md-8.col-lg-9.d-grid
			button.btn.btn-primary#checkoutPlaceOrderBtn(type='submit') Place order
		.col-md-4.col-lg-3.d-grid
			button.btn.btn-phoenix-secondary.text-nowrap(type='button' onclick='window.location.href="/cart"') Back to cart


mixin ShippingInfo
	h3.mb-5 Shipping Info
	.row.g-4
		.col-12
			label.form-label.fs-8.text-body-highlight.ps-0.text-transform-none(for='inputName') Full name
			input#inputName.form-control(type='text' placeholder='Full name')

		.col-md-6
			label.form-label.fs-8.text-body-highlight.ps-0.text-transform-none(for='inputEmail') Email
			input#inputEmail.form-control(type='email' placeholder='Email')

		.col-md-6
			label.form-label.fs-8.text-body-highlight.ps-0.text-transform-none(for='inputPhone') Phone
			input#inputPhone.form-control(type='tel' placeholder='+1234567890')

		.col-12
			label.form-label.fs-8.text-body-highlight.ps-0.text-transform-none(for='inputAddress1') Address line 1
			input#inputAddress1.form-control(type='text' placeholder='Address line 1')

		.col-12
			label.form-label.fs-8.text-body-highlight.ps-0.text-transform-none(for='inputAddress2') Address line 2
			input#inputAddress2.form-control(type='text' placeholder='Address line 2')

		.col-md-4
			label.form-label.fs-8.text-body-highlight.ps-0.text-transform-none(for='inputCity') City
			select#inputCity.form-select.text-body-emphasis
				option(selected='selected') Van Nuys
				option(value='los-angeles') Los Angeles
				option(value='chicago') Chicago
				option(value='houston') Houston

		.col-md-4
			label.form-label.fs-8.text-body-highlight.ps-0.text-transform-none(for='inputState') State
			select#inputState.form-select.text-body-emphasis
				option(selected='selected') California
				option(value='Alaska') Alaska
				option(value='alabama') Alabama
				option(value='florida') Florida

		.col-md-4
			label.form-label.fs-8.text-body-highlight.ps-0.text-transform-none(for='inputZipCode') Zip code
			input#inputZipCode.form-control.number-arrows-none(type='number' placeholder='Zip code')

		.col-md-4.mb-3
			label.form-label.fs-8.text-body-highlight.ps-0.text-transform-none(for='inputCountry') Country
			select#inputCountry.form-select.text-body-emphasis
				option(selected='selected') USA
				option(value='uk') UK
				option(value='aus') AUS
				option(value='nz') NZ

		.col-12
			button.btn.btn-primary.px-8.px-sm-11.me-2(type='submit') Save
			button.btn.btn-phoenix-secondary.text-nowrap(type='submit') Exit Without Saving

