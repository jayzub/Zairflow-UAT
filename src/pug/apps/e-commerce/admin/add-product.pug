prepend scripts
  script(src=`${CWD}vendors/tinymce/tinymce.min.js`)
  script(src=`${CWD}vendors/dropzone/dropzone-min.js`)
  script(src=`${CWD}vendors/choices/choices.min.js`)
  script(src=`${CWD}vendors/flatpickr/flatpickr.min.js`)

append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Initialize TinyMCE
      tinymce.init({
        selector: '.tinymce',
        height: '15rem',
        plugins: 'lists link image table code help wordcount',
        toolbar: 'undo redo | blocks | bold italic | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | link image',
        setup: function(editor) {
          editor.on('init', function() {
            console.log('TinyMCE initialized');
          });
        }
      });

      // Populate product types from backend config
      async function populateProductTypes() {
        try {
          const response = await fetch('/admin/product-types/config');
          if (response.ok) {
            const result = await response.json();
            const productTypeSelect = document.querySelector('#productTypeSelect');
            
            // Clear existing options
            productTypeSelect.innerHTML = '';
            
            // Add default option
            const defaultOption = document.createElement('option');
            defaultOption.value = '';
            defaultOption.textContent = 'Select product type...';
            productTypeSelect.appendChild(defaultOption);
            
            // Store product types configuration globally for dynamic field generation
            window.productTypesConfig = {};
            result.data.forEach(type => {
              window.productTypesConfig[type.name] = type;
              const option = document.createElement('option');
              option.value = type.name;
              option.textContent = type.displayName || type.name;
              productTypeSelect.appendChild(option);
            });
          }
        } catch (error) {
          console.error('Failed to fetch product types:', error);
          // Fallback to hardcoded options if API fails
          const productTypeSelect = document.querySelector('#productTypeSelect');
          
          // Clear existing options
          productTypeSelect.innerHTML = '';
          
          // Add default option
          const defaultOption = document.createElement('option');
          defaultOption.value = '';
          defaultOption.textContent = 'Select product type...';
          productTypeSelect.appendChild(defaultOption);
          
          //- // Add fallback options
          //- Object.values(fallbackTypes).forEach(type => {
          //-   const option = document.createElement('option');
          //-   option.value = type.name;
          //-   option.textContent = type.displayName || type.name;
          //-   productTypeSelect.appendChild(option);
          //- });
        }
      }

      // Dynamic field generation function
      function generateProductTypeFields(productType) {
        const container = document.getElementById('dynamicProductFields');
        if (!container) return;

        // Clear existing content
        container.innerHTML = '';

        if (!productType) {
          container.innerHTML = `
            <div class="text-center text-muted py-4">
              <i class="fas fa-info-circle me-2"></i>
              Select a product type to see specific fields
            </div>
          `;
          return;
        }

        // Get product type configuration
        const productTypeConfig = getProductTypeConfig(productType);
        if (!productTypeConfig) {
          container.innerHTML = `
            <div class="text-center text-muted py-4">
              <i class="fas fa-exclamation-triangle me-2"></i>
              Product type configuration not found
            </div>
          `;
          return;
        }

        // Generate fields based on configuration
        let fieldsHTML = `<h5 class="mb-3">${productTypeConfig.displayName || productTypeConfig.name} Details</h5>`;
        
        if (productTypeConfig.fields) {
          Object.entries(productTypeConfig.fields).forEach(([fieldName, fieldConfig]) => {
            fieldsHTML += generateFieldHTML(fieldName, fieldConfig);
          });
        }

        container.innerHTML = fieldsHTML;
      }

      // Helper function to generate individual field HTML
      function generateFieldHTML(fieldName, fieldConfig) {
        const { type, required, label, enum: enumValues, options } = fieldConfig;
        const fieldLabel = label || fieldName.charAt(0).toUpperCase() + fieldName.slice(1);
        const isRequired = required ? 'required' : '';
        
        let fieldHTML = `
          <div class="mb-3">
            <label class="form-label">${fieldLabel}${required ? ' *' : ''}</label>
        `;

        switch (type) {
          case 'string':
            if (enumValues && options) {
              fieldHTML += `<select class="form-select" name="${fieldName}" ${isRequired}>`;
              fieldHTML += `<option value="">Select ${fieldLabel.toLowerCase()}...</option>`;
              options.forEach(option => {
                fieldHTML += `<option value="${option.value}">${option.label}</option>`;
              });
              fieldHTML += '</select>';
            } else {
              fieldHTML += `<input class="form-control" type="text" name="${fieldName}" placeholder="Enter ${fieldLabel.toLowerCase()}" ${isRequired}>`;
            }
            break;
          
          case 'number':
            fieldHTML += `<input class="form-control" type="number" name="${fieldName}" placeholder="Enter ${fieldLabel.toLowerCase()}" ${isRequired}>`;
            break;
          
          case 'boolean':
            fieldHTML += `
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="${fieldName}" id="${fieldName}">
                <label class="form-check-label" for="${fieldName}">${fieldLabel}</label>
              </div>
            `;
            break;
          
          case 'date':
            fieldHTML += `<input class="form-control" type="date" name="${fieldName}" ${isRequired}>`;
            break;
          
          case 'array':
            fieldHTML += `
              <div class="array-container">
                <input class="form-control mb-2" type="text" name="${fieldName}[0]" placeholder="Enter ${fieldLabel.toLowerCase()}" ${isRequired}>
                <button class="btn btn-outline-primary btn-sm add-array-item" type="button" data-field="${fieldName}">Add ${fieldLabel}</button>
              </div>
            `;
            break;
          
          case 'object':
            fieldHTML += `<textarea class="form-control" name="${fieldName}" placeholder="Enter ${fieldLabel.toLowerCase()} (JSON format)" rows="3" ${isRequired}></textarea>`;
            break;

          case 'key_value_array':
            fieldHTML += `
              <div class="key-value-container mb-3">
                <div class="key-value-item d-flex gap-2 mb-2">
                  <input class="form-control" type="text" name="${fieldName}[0][key]" placeholder="Key" ${isRequired}>
                  <input class="form-control" type="text" name="${fieldName}[0][value]" placeholder="Value" ${isRequired}>
                  <button class="btn btn-outline-danger" type="button" onclick="this.closest('.key-value-item').remove()">×</button>
                </div>
                <button class="btn btn-outline-primary btn-sm add-key-value-item" type="button" data-field="${fieldName}">
                  Add Key-Value Pair
                </button>
              </div>
            `;
            break;
          
          default:
            fieldHTML += `<input class="form-control" type="text" name="${fieldName}" placeholder="Enter ${fieldLabel.toLowerCase()}" ${isRequired}>`;
        }

        fieldHTML += '</div>';
        return fieldHTML;
      }

      // Helper function to get product type configuration
      function getProductTypeConfig(productTypeName) {
        // This will be populated when we fetch product types
        return window.productTypesConfig?.[productTypeName];
      }

      // Initialize Choices.js for category dropdown
      let categoryChoices = null;
      function initializeCategoryDropdown() {
        const categorySelect = document.querySelector('#categorySelect') || document.querySelector('select[name="category"]');
        if (!categorySelect) {
          console.warn('Category select element not found');
          return false;
        }
        
        // Check if Choices is already initialized
        try {
          // Try to get existing instance first
          const existingInstance = Choices.getInstance(categorySelect);
          if (existingInstance) {
            categoryChoices = existingInstance;
            console.log('Found existing Choices instance');
            return true;
          }
        } catch (e) {
          // No existing instance, continue to create one
          console.log('No existing Choices instance found, creating new one');
        }
        
        // Manually initialize if not already done
        try {
          categoryChoices = new Choices(categorySelect, {
            removeItemButton: true,
            placeholder: true,
            placeholderValue: 'Select categories...',
            searchEnabled: true,
            searchChoices: true,
            allowHTML: false
          });
          console.log('Choices initialized successfully');
          return true;
        } catch (e) {
          console.error('Could not initialize Choices:', e);
          return false;
        }
      }

      // Fetch compatible categories for a product type
      async function fetchCompatibleCategories(productType) {
        if (!productType) {
          return [];
        }
        
        try {
          const response = await fetch(`/admin/categories/compatible?productType=${encodeURIComponent(productType)}`, {
            credentials: 'include'
          });
          
          if (!response.ok) {
            console.error('Failed to fetch compatible categories:', response.status);
            return [];
          }
          
          const result = await response.json();
          return result.success ? result.data : [];
        } catch (error) {
          console.error('Error fetching compatible categories:', error);
          return [];
        }
      }

      // Fetch all categories for the store
      async function fetchAllCategories() {
        try {
          const response = await fetch('/admin/categories', {
            credentials: 'include',
            headers: {
              'Accept': 'application/json'
            }
          });
          
          if (!response.ok) {
            console.error('Failed to fetch all categories:', response.status);
            return [];
          }
          
          // Check if response is JSON (from API) or HTML (from view)
          const contentType = response.headers.get('content-type');
          if (contentType && contentType.includes('application/json')) {
            const result = await response.json();
            return result.success && result.data ? result.data : (result.categories || []);
          }
          
          // If HTML response, return empty array (we'll use the server-rendered categories)
          return [];
        } catch (error) {
          console.error('Error fetching all categories:', error);
          return [];
        }
      }

      // Store all categories for fallback
      const allCategories = !{JSON.stringify(categories || [])};

      // Update category dropdown with compatible categories
      async function updateCategoryDropdown(productType) {
        // Ensure Choices is initialized
        if (!categoryChoices) {
          const initialized = initializeCategoryDropdown();
          if (!initialized || !categoryChoices) {
            console.warn('Category Choices instance not initialized');
            return;
          }
        }
        
        // Verify Choices instance is valid
        if (!categoryChoices || typeof categoryChoices.setChoices !== 'function') {
          console.error('Invalid Choices instance:', categoryChoices);
          return;
        }
        
        try {
          // Store currently selected values
          let selectedValues = [];
          try {
            selectedValues = categoryChoices.getValue(true) || [];
          } catch (e) {
            console.warn('Could not get selected values:', e);
          }
          
          // Clear existing choices first
          try {
            categoryChoices.clearChoices();
            // Wait a bit for clearChoices to complete
            await new Promise(resolve => setTimeout(resolve, 100));
          } catch (e) {
            console.warn('Error clearing choices:', e);
          }
          
          let choicesToSet = [];
          
          if (!productType) {
            // If no product type selected, show all categories
            if (allCategories && allCategories.length > 0) {
              choicesToSet = allCategories.map(category => ({
                value: category._id.toString(),
                label: category.name,
                selected: selectedValues.includes(category._id.toString())
              }));
            } else {
              choicesToSet = [{
                value: '',
                label: 'No categories available',
                disabled: true
              }];
            }
          } else {
            // Fetch compatible categories
            const compatibleCategories = await fetchCompatibleCategories(productType);
            
            if (compatibleCategories.length === 0) {
              choicesToSet = [{
                value: '',
                label: 'No compatible categories available',
                disabled: true
              }];
            } else {
              // Add compatible categories to dropdown
              choicesToSet = compatibleCategories.map(category => ({
                value: category._id.toString(),
                label: category.name,
                selected: selectedValues.includes(category._id.toString())
              }));
            }
          }
          
          // Set choices with proper error handling
          if (choicesToSet.length > 0) {
            categoryChoices.setChoices(choicesToSet, 'value', 'label', true);
          }
        } catch (error) {
          console.error('Error updating category dropdown:', error);
          console.error('Error stack:', error.stack);
          
          // Fallback: try to reinitialize
          const categorySelect = document.querySelector('#categorySelect') || document.querySelector('select[name="category"]');
          if (categorySelect && typeof Choices !== 'undefined') {
            try {
              // Destroy existing instance if any
              const existingInstance = Choices.getInstance(categorySelect);
              if (existingInstance) {
                existingInstance.destroy();
                categoryChoices = null;
              }
            } catch (e) {
              // Ignore destroy errors
            }
            // Reinitialize after a delay
            setTimeout(() => {
              initializeCategoryDropdown();
            }, 200);
          }
        }
      }

      // Product type selection handler
      const productTypeSelect = document.querySelector('#productTypeSelect') || document.querySelector('select[name="productType"]');
      
      productTypeSelect?.addEventListener('change', async function() {
        const selectedType = this.value;
        console.log('Product type selected:', selectedType);
        console.log('Available configs:', window.productTypesConfig);
        
        // Generate product type specific fields
        generateProductTypeFields(selectedType);
        
        // Update category dropdown with compatible categories
        await updateCategoryDropdown(selectedType);
      });

      // Call the function when page loads
      populateProductTypes();
      
      // Initialize category dropdown after DOM is ready and Choices.js is loaded
      function waitForChoicesAndInit() {
        if (typeof Choices === 'undefined') {
          console.warn('Choices.js not loaded yet, retrying...');
          setTimeout(waitForChoicesAndInit, 100);
          return;
        }
        
        // Wait a bit more to ensure Choices is fully ready
        setTimeout(async () => {
          const initialized = initializeCategoryDropdown();
          if (initialized && categoryChoices) {
            // Initially show all categories (no product type selected yet)
            await updateCategoryDropdown('');
          } else {
            console.warn('Failed to initialize category dropdown, retrying...');
            setTimeout(waitForChoicesAndInit, 200);
          }
        }, 200);
      }
      
      // Start initialization after DOM is ready
      setTimeout(waitForChoicesAndInit, 300);

      // ===== Add Category Modal Functionality =====
      
      // Initialize Choices for product types in modal
      let modalProductTypesChoices = null;
      
      // Populate product types in modal
      async function populateModalProductTypes() {
        try {
          const response = await fetch('/admin/product-types/config');
          if (response.ok) {
            const result = await response.json();
            const productTypeSelect = document.querySelector('#categoryAllowedProductTypes');
            
            if (!productTypeSelect) return;
            
            // Destroy existing Choices instance if any
            if (modalProductTypesChoices) {
              try {
                modalProductTypesChoices.destroy();
                modalProductTypesChoices = null;
              } catch (e) {
                // Ignore errors
              }
            }
            
            // Clear existing options
            productTypeSelect.innerHTML = '';
            
            // Add fetched product types
            result.data.forEach(type => {
              const option = document.createElement('option');
              option.value = type.name;
              option.textContent = type.displayName || type.name;
              productTypeSelect.appendChild(option);
            });
            
            // Initialize Choices for product types select after options are added
            if (typeof Choices !== 'undefined') {
              try {
                // Wait a bit for DOM to update
                setTimeout(() => {
                  modalProductTypesChoices = new Choices(productTypeSelect, {
                    removeItemButton: true,
                    placeholder: true,
                    placeholderValue: 'Select product types...',
                    searchEnabled: true
                  });
                }, 100);
              } catch (e) {
                console.warn('Could not initialize Choices for modal product types:', e);
              }
            }
          }
        } catch (error) {
          console.error('Failed to fetch product types for modal:', error);
        }
      }
      
      // Auto-generate slug from name in modal
      const categoryNameInput = document.querySelector('#categoryName');
      const categorySlugInput = document.querySelector('#categorySlug');
      
      categoryNameInput?.addEventListener('input', function() {
        const slug = this.value
          .toLowerCase()
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-+|-+$/g, '');
        if (categorySlugInput) {
          categorySlugInput.value = slug;
        }
      });
      
      // Handle modal form submission
      const addCategoryModalForm = document.getElementById('addCategoryModalForm');
      const createCategoryBtn = document.getElementById('createCategoryBtn');
      
      addCategoryModalForm?.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Basic validation
        const name = this.querySelector('[name="name"]').value;
        
        // Get selected product types from Choices or fallback to native select
        let allowedProductTypes = [];
        if (modalProductTypesChoices) {
          allowedProductTypes = modalProductTypesChoices.getValue(true) || [];
        } else {
          allowedProductTypes = Array.from(this.querySelectorAll('#categoryAllowedProductTypes option:checked'))
            .map(option => option.value);
        }
        
        if (!name || allowedProductTypes.length === 0) {
          alert('Please fill in Category Name and select at least one Allowed Product Type');
          return;
        }
        
        try {
          createCategoryBtn.disabled = true;
          createCategoryBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating...';
          
          // Prepare form data
          const formData = {
            name: name.trim(),
            slug: categorySlugInput?.value.trim() || '',
            description: this.querySelector('[name="description"]').value || '',
            icon: this.querySelector('[name="icon"]').value || '',
            color: this.querySelector('[name="color"]').value || '#007bff',
            parent: this.querySelector('[name="parent"]').value || null,
            displayOrder: parseInt(this.querySelector('[name="displayOrder"]').value) || 1,
            allowedProductTypes: allowedProductTypes,
            isActive: this.querySelector('[name="isActive"]').checked
          };
          
          // Submit category
          const response = await fetch('/admin/categories', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData),
            credentials: 'include'
          });
          
          if (!response.ok) {
            const errorData = await response.json().catch(() => ({ message: 'Error creating category' }));
            throw new Error(errorData.message || 'Error creating category');
          }
          
          const result = await response.json();
          
          if (result.success) {
            // Update allCategories array with new category
            const newCategory = result.data;
            if (newCategory && newCategory._id) {
              allCategories.push({
                _id: newCategory._id,
                name: newCategory.name
              });
            }
            
            // Close modal
            const modalElement = document.getElementById('addCategoryModal');
            const modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) {
              modal.hide();
            }
            
            // Reset form
            addCategoryModalForm.reset();
            if (categorySlugInput) categorySlugInput.value = '';
            
            // Refresh category dropdown
            // Get current product type to filter categories
            const currentProductType = productTypeSelect?.value || '';
            await updateCategoryDropdown(currentProductType);
            
            // Show success message
            alert('Category created successfully! It has been added to the category list.');
          } else {
            throw new Error(result.message || 'Error creating category');
          }
        } catch (error) {
          console.error('Error creating category:', error);
          alert('Error creating category: ' + error.message);
        } finally {
          createCategoryBtn.disabled = false;
          createCategoryBtn.innerHTML = 'Create Category';
        }
      });
      
      // Populate product types when modal is shown
      const addCategoryModal = document.getElementById('addCategoryModal');
      addCategoryModal?.addEventListener('show.bs.modal', function() {
        populateModalProductTypes();
      });
      
      // Reset form when modal is hidden
      addCategoryModal?.addEventListener('hidden.bs.modal', function() {
        addCategoryModalForm.reset();
        if (categorySlugInput) categorySlugInput.value = '';
        // Reset Choices if initialized
        if (modalProductTypesChoices) {
          try {
            modalProductTypesChoices.clearChoices();
          } catch (e) {
            // Ignore errors
          }
        }
      });

      // ===== Add Vendor Modal Functionality =====
      
      // Store all vendors for fallback
      const allVendors = !{JSON.stringify(vendors || [])};

      // Handle vendor modal form submission
      const addVendorModalForm = document.getElementById('addVendorModalForm');
      const createVendorBtn = document.getElementById('createVendorBtn');
      
      addVendorModalForm?.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Basic validation
        const name = this.querySelector('[name="name"]').value;
        const email = this.querySelector('[name="email"]').value;
        
        if (!name) {
          alert('Please fill in Vendor Name');
          return;
        }
        
        // Email validation (only if provided)
        if (email && email.trim() !== '') {
          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(email.trim())) {
            alert('Please enter a valid email address');
            return;
          }
        }
        
        try {
          createVendorBtn.disabled = true;
          createVendorBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating...';
          
          // Prepare form data
          const emailValue = email && email.trim() !== '' ? email.trim() : null;
          const vendorData = {
            name: name.trim(),
            email: emailValue,
            phone: this.querySelector('[name="phone"]').value || '',
            address: this.querySelector('[name="address"]').value || '',
            description: this.querySelector('[name="description"]').value || '',
            isActive: this.querySelector('[name="isActive"]').checked
          };
          
          // Submit vendor
          const response = await fetch('/admin/vendors', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(vendorData),
            credentials: 'include'
          });
          
          if (!response.ok) {
            const errorData = await response.json().catch(() => ({ message: 'Error creating vendor' }));
            throw new Error(errorData.message || 'Error creating vendor');
          }
          
          const result = await response.json();
          
          if (result.success) {
            // Update allVendors array with new vendor
            const newVendor = result.data;
            if (newVendor && newVendor._id) {
              allVendors.push({
                _id: newVendor._id,
                name: newVendor.name
              });
            }
            
            // Close modal
            const modalElement = document.getElementById('addVendorModal');
            const modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) {
              modal.hide();
            }
            
            // Reset form
            addVendorModalForm.reset();
            
            // Refresh vendor dropdown
            const vendorSelect = document.querySelector('select[name="vendor"]');
            if (vendorSelect) {
              // Clear existing options except the first one
              const firstOption = vendorSelect.querySelector('option[value=""]');
              vendorSelect.innerHTML = '';
              if (firstOption) {
                vendorSelect.appendChild(firstOption);
              }
              
              // Add all vendors including the new one
              allVendors.forEach(vendor => {
                const option = document.createElement('option');
                option.value = vendor._id.toString();
                option.textContent = vendor.name;
                vendorSelect.appendChild(option);
              });
              
              // Select the newly created vendor
              if (newVendor && newVendor._id) {
                vendorSelect.value = newVendor._id.toString();
              }
            }
            
            // Show success message
            alert('Vendor created successfully! It has been added to the vendor list.');
          } else {
            throw new Error(result.message || 'Error creating vendor');
          }
        } catch (error) {
          console.error('Error creating vendor:', error);
          alert('Error creating vendor: ' + error.message);
        } finally {
          createVendorBtn.disabled = false;
          createVendorBtn.innerHTML = 'Create Vendor';
        }
      });
      
      // Reset form when vendor modal is hidden
      const addVendorModal = document.getElementById('addVendorModal');
      addVendorModal?.addEventListener('hidden.bs.modal', function() {
        addVendorModalForm.reset();
      });

      // Event delegation for dynamic array fields
      document.addEventListener('click', function(e) {
        if (e.target.classList.contains('add-array-item')) {
          const fieldName = e.target.dataset.field;
          const container = e.target.closest('.array-container');
          const existingInputs = container.querySelectorAll(`input[name^="${fieldName}["]`);
          const newIndex = existingInputs.length;
          
          const newInput = document.createElement('div');
          newInput.className = 'input-group mb-2';
          newInput.innerHTML = `
            <input class="form-control" type="text" name="${fieldName}[${newIndex}]" placeholder="Enter ${fieldName}">
            <button class="btn btn-outline-danger" type="button" onclick="this.closest('.input-group').remove()">×</button>
          `;
          
          container.insertBefore(newInput, e.target);
        }
        
        // Event delegation for dynamic key-value array fields
        if (e.target.classList.contains('add-key-value-item')) {
          const fieldName = e.target.dataset.field;
          const container = e.target.closest('.key-value-container');
          const existingItems = container.querySelectorAll('.key-value-item');
          const newIndex = existingItems.length;
          
          const newKeyValueItem = document.createElement('div');
          newKeyValueItem.className = 'key-value-item d-flex gap-2 mb-2';
          newKeyValueItem.innerHTML = `
            <input class="form-control" type="text" name="${fieldName}[${newIndex}][key]" placeholder="Key (e.g. cotton)">
            <input class="form-control" type="text" name="${fieldName}[${newIndex}][value]" placeholder="Value (e.g. 60%)">
            <button class="btn btn-outline-danger" type="button" onclick="this.closest('.key-value-item').remove()">×</button>
          `;
          
          container.insertBefore(newKeyValueItem, e.target);
        }
      });

      // Variant handler
      document.querySelector('.add-variant-btn')?.addEventListener('click', function() {
        const container = document.querySelector('.variants-container');
        const variantItems = container.querySelectorAll('.variant-item');
        const idx = variantItems.length;
        const newVariant = document.createElement('div');
        newVariant.className = 'variant-item mb-3';
        newVariant.innerHTML = `
          <div class="">
            <input class="form-control mb-2" type="text" name="variants[${idx}][size]" placeholder="Size">
            <input class="form-control mb-2" type="text" name="variants[${idx}][color]" placeholder="Color">
            <input class="form-control mb-2" type="text" name="variants[${idx}][colorHex]" placeholder="Color Hex Code">
            <input class="form-control mb-2" type="number" name="variants[${idx}][price]" placeholder="Price" step="0.01">
            <input class="form-control mb-2" type="number" name="variants[${idx}][salePrice]" placeholder="Sale Price" step="0.01">
            <input class="form-control mb-2" type="number" name="variants[${idx}][countInStock]" placeholder="Stock Quantity" min="0">
            <input class="form-control mb-2" type="text" name="variants[${idx}][sku]" placeholder="SKU">
            <button class="btn btn-outline-danger" type="button" onclick="this.closest('.variant-item').remove()">Remove Variant</button>
          </div>
        `;
        container.appendChild(newVariant);
      });

      // Initialize Dropzone only if not already initialized
      let dropzone;
      if (!document.querySelector("#productImages.dz-clickable")) {
        dropzone = new Dropzone("#productImages", {
          url: "/admin/products",
          autoProcessQueue: false,
          uploadMultiple: true,
          parallelUploads: 5,
          maxFiles: 5,
          acceptedFiles: "image/*",
          addRemoveLinks: true,
          paramName: "images",
          headers: {
            'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
          },
          withCredentials: true // Add this line for authentication
        });
      } else {
        dropzone = Dropzone.forElement("#productImages");
      }

      // Button handlers
      const form = document.getElementById('productForm');
      const discardBtn = document.getElementById('discardBtn');
      const saveDraftBtn = document.getElementById('saveDraftBtn');
      const publishBtn = document.getElementById('publishBtn');

      // Discard button handler
      discardBtn?.addEventListener('click', function() {
        if (confirm('Are you sure you want to discard this product?')) {
          window.location.href = '/admin/products';
        }
      });

      // Save draft button handler
      saveDraftBtn?.addEventListener('click', async function() {
        const formData = new FormData(form);
        formData.append('status', 'draft');
        await submitForm(formData);
      });

      // Generic function to handle regular array fields (like care instructions)
      function handleArrayField(fieldName, cleanedFormData) {
        const inputs = document.querySelectorAll(`input[name^="${fieldName}["]`);
        const result = [];
        
        inputs.forEach(input => {
          const value = input.value.trim();
          if (value) {
            result.push(value);
          }
        });
        
        if (result.length > 0) {
          cleanedFormData.append(fieldName, JSON.stringify(result));
        }
      }

      // Generic function to handle key-value array fields
      function handleKeyValueArrayField(fieldName, cleanedFormData) {
        const inputs = document.querySelectorAll(`input[name^="${fieldName}["]`);
        const result = [];
        
        // Group inputs by their index
        const groupedInputs = {};
        inputs.forEach(input => {
          const name = input.name;
          const match = name.match(new RegExp(`${fieldName}\\[(\\d+)\\]\\[(key|value)\\]`));
          if (match) {
            const index = match[1];
            const field = match[2];
            if (!groupedInputs[index]) {
              groupedInputs[index] = {};
            }
            groupedInputs[index][field] = input.value;
          }
        });
        
        // Convert grouped inputs to array of objects
        Object.keys(groupedInputs).forEach(index => {
          const item = groupedInputs[index];
          if (item.key && item.value) {
            result.push({ 
              [item.key]: item.value
            });
          }
        });
        
        if (result.length > 0) {
          cleanedFormData.append(fieldName, JSON.stringify(result));
        }
      }

      // Publish button handler (form submit)
      form?.addEventListener('submit', async function(e) {
        e.preventDefault();
        console.log('Form submission started');

        // Basic validation
        const productType = this.querySelector('[name="productType"]').value;
        const name = this.querySelector('[name="name"]').value;
        const price = this.querySelector('[name="price"]').value;

        if (!productType || !name || !price) {
          alert('Please fill in all required fields (Product Type, Name, and Price)');
          return;
        }

        const formData = new FormData(this);
        formData.append('status', 'published');
        
        await submitForm(formData);
      });

      // Form submission helper function
      async function submitForm(formData) {
        try {
          console.log('Submitting form data...');
          
          // Check if user is authenticated
          const authCheck = await fetch('/admin/me', {
            method: 'GET',
            credentials: 'include'
          });
          
          if (!authCheck.ok) {
            console.error('Authentication failed:', authCheck.status);
            alert('Authentication failed. Please log in again.');
            window.location.href = '/admin/auth/sign-in';
            return;
          }
          
          publishBtn.disabled = true;
          publishBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Publishing...';

          // Create a new FormData object for the cleaned data
          const cleanedFormData = new FormData();

          // Add basic fields
          cleanedFormData.append('name', formData.get('name').trim());
          
          // Get description from TinyMCE with error handling
          let description = '';
          try {
            const editor = tinymce.get('description');
            if (editor) {
              description = editor.getContent();
            } else {
              description = formData.get('description') || '';
            }
          } catch (e) {
            console.error('Error getting TinyMCE content:', e);
            description = formData.get('description') || '';
          }
          cleanedFormData.append('description', description);

          cleanedFormData.append('price', formData.get('price'));
          cleanedFormData.append('productType', formData.get('productType'));
          cleanedFormData.append('status', formData.get('status'));

          // Add optional fields if they have values
          const optionalFields = ['salePrice', 'countInStock', 'vendor', 'brand'];
          optionalFields.forEach(field => {
            const value = formData.get(field);
            if (value && value.trim() !== '') {
              cleanedFormData.append(field, value.trim());
            }
          });

          // Add all dynamically generated fields (string, number, date, boolean types)
          // These are generated from productTypes.js configuration
          const dynamicallyGeneratedFields = [
            // Clothing
            'material', 'fit', 'season', 'gender',
            // Electronics
            'modelNumber', 'warranty', 'weight',
            // Furniture
            'style', 'capacity', 'color', 'colorHex',
            // Books
            'author', 'publisher', 'isbn', 'language', 'format', 'pages', 'publicationDate',
            // Food
            'expiryDate',
            // Sports
            'sport', 'skillLevel',
            // HomeGarden
            'room',
            // HealthBeauty
            'skinType', 'expiryDate'
          ];
          
          dynamicallyGeneratedFields.forEach(field => {
            const value = formData.get(field);
            if (value && value.trim() !== '') {
              cleanedFormData.append(field, value.trim());
            }
          });

          // Handle boolean fields
          const isFeatured = formData.get('isFeatured') === 'on';
          cleanedFormData.append('isFeatured', isFeatured);

          const isAssembly = formData.get('isAssembly') === 'on';
          cleanedFormData.append('isAssembly', isAssembly);

          // Add images from Dropzone
          const files = dropzone.getAcceptedFiles();
          files.forEach((file) => {
            cleanedFormData.append('images', file);
          });

          // Add categories
          const selectedCategories = Array.from(document.querySelectorAll('select[name="category"] option:checked'))
            .map(option => option.value);
          if (selectedCategories.length > 0) {
            cleanedFormData.append('category', JSON.stringify(selectedCategories));
          }

          // Add tags
          const selectedTags = Array.from(document.querySelectorAll('select[name="tags[]"] option:checked'))
            .map(option => option.value);
          if (selectedTags.length > 0) {
            cleanedFormData.append('tags', JSON.stringify(selectedTags));
          }

          // Handle array fields that need special processing
          const arrayFields = ['care', 'ingredients', 'allergens', 'genre', 'roomType', 'material'];
          arrayFields.forEach(fieldName => {
            handleArrayField(fieldName, cleanedFormData);
          });

          // Handle variants array (different structure than simple arrays)
          const variantItems = document.querySelectorAll('.variant-item');
          if (variantItems.length > 0) {
            const variants = Array.from(variantItems).map(item => {
              const sizeInput = item.querySelector('input[name*="[size]"]');
              const colorInput = item.querySelector('input[name*="[color]"]');
              const colorHexInput = item.querySelector('input[name*="[colorHex]"]');
              const priceInput = item.querySelector('input[name*="[price]"]');
              const salePriceInput = item.querySelector('input[name*="[salePrice]"]');
              const countInStockInput = item.querySelector('input[name*="[countInStock]"]');
              const skuInput = item.querySelector('input[name*="[sku]"]');
              
              const variant = {};
              if (sizeInput && sizeInput.value) variant.size = sizeInput.value;
              if (colorInput && colorInput.value) variant.color = colorInput.value;
              if (colorHexInput && colorHexInput.value) variant.colorHex = colorHexInput.value;
              if (priceInput && priceInput.value) variant.price = parseFloat(priceInput.value) || 0;
              if (salePriceInput && salePriceInput.value) variant.salePrice = parseFloat(salePriceInput.value) || 0;
              if (countInStockInput && countInStockInput.value !== '') {
                variant.countInStock = parseInt(countInStockInput.value) || 0;
              }
              if (skuInput && skuInput.value) variant.sku = skuInput.value;
              
              return Object.keys(variant).length > 0 ? variant : null;
            }).filter(v => v !== null);
            
            if (variants.length > 0) {
              cleanedFormData.append('variants', JSON.stringify(variants));
            }
          }

          // Handle key-value array fields
          const keyValueArrayFields = ['materialComposition', 'specifications', 'dimensions', 'nutritionalInfo'];
          keyValueArrayFields.forEach(fieldName => {
            handleKeyValueArrayField(fieldName, cleanedFormData);
          });

          // Handle object fields (JSON textarea fields)
          const objectFields = ['isAssembly', 'weight', 'volume'];
          objectFields.forEach(fieldName => {
            const value = formData.get(fieldName);
            if (value && value.trim() !== '') {
              try {
                // Validate it's valid JSON
                JSON.parse(value);
                cleanedFormData.append(fieldName, value);
              } catch (e) {
                console.warn(`Field ${fieldName} is not valid JSON, skipping`);
              }
            }
          });

          // Log the cleaned form data
          console.log('Cleaned form data:');
          for (let [key, value] of cleanedFormData.entries()) {
            console.log(`${key}: ${value}`);
          }

          const response = await fetch('/admin/products', {
            method: 'POST',
            body: cleanedFormData,
            credentials: 'include' // Add this line for authentication
          });

          console.log('Response status:', response.status);
          console.log('Response headers:', Object.fromEntries(response.headers.entries()));

          if (!response.ok) {
            const errorText = await response.text();
            console.error('Error response:', errorText);
            throw new Error(`HTTP error! status: ${response.status}`);
          }

          const contentType = response.headers.get('content-type');
          console.log('Content-Type:', contentType);

          let result;
          if (contentType && contentType.includes('application/json')) {
            result = await response.json();
          } else {
            const text = await response.text();
            console.error('Non-JSON response:', text.substring(0, 500));
            throw new Error('Server returned non-JSON response. Check authentication.');
          }

          console.log('Server response:', result);

          if (result.success) {
            window.location.href = '/admin/products';
          } else {
            throw new Error(result.error || 'Error creating product');
          }
        } catch (error) {
          console.error('Error details:', error);
          alert('Error creating product: ' + error.message);
        } finally {
          publishBtn.disabled = false;
          publishBtn.innerHTML = 'Publish product';
        }
      }
    });

append variables
  - var pageTitle = 'Add Product'
  - var productTypes = [{ value: 'Electronics', label: 'Electronics' }, { value: 'Clothing', label: 'Clothing' }, { value: 'Furniture', label: 'Furniture' }, { value: 'Books', label: 'Books' }]

block content
  form.mb-9#productForm(action="/admin/products" method="POST" enctype="multipart/form-data")
    .row.g-3.flex-between-end.mb-5
      .col-auto
        h2.mb-2 #{pageTitle}
        h5.text-body-tertiary.fw-semibold Create a new Product
      .col-auto
        button.btn.btn-phoenix-secondary.me-2.mb-2.mb-sm-0(type='button' id='discardBtn') Discard
        button.btn.btn-phoenix-primary.me-2.mb-2.mb-sm-0(type='button' id='saveDraftBtn') Save draft
        button.btn.btn-primary.mb-2.mb-sm-0(type='submit' id='publishBtn') Publish product
    .row.g-5
      .col-12.col-xl-8
        +ProductDescription({ productTypes })
        +DisplayImage
        //- +Pricing

      .col-12.col-xl-4
        .row.g-2
          .col-12.col-xl-12
            +OrganizeCard({ categories, vendors }).mb-3
          .col-12.col-xl-12
            +DynamicProductFields

  // Modal for Add Category
  .modal.fade#addCategoryModal(tabindex='-1' aria-labelledby='addCategoryModalLabel' aria-hidden='true')
    .modal-dialog.modal-lg.modal-dialog-scrollable
      .modal-content
        .modal-header
          h5.modal-title#addCategoryModalLabel Add New Category
          button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
        .modal-body
          form#addCategoryModalForm
            .row.g-3
              .col-12.col-sm-6
                label.form-label(for='categoryName') Category Name *
                input.form-control#categoryName(type='text' name='name' placeholder='Enter category name' required)
              
              .col-12.col-sm-6
                label.form-label(for='categorySlug') URL Slug
                input.form-control#categorySlug(type='text' name='slug' placeholder='auto-generated' readonly)
                small.form-text.text-muted Auto-generated from category name
              
              .col-12
                label.form-label(for='categoryDescription') Description
                textarea.form-control#categoryDescription(name='description' rows='3' placeholder='Describe this category...')
              
              .col-12.col-sm-6
                label.form-label(for='categoryIcon') Icon Class
                input.form-control#categoryIcon(type='text' name='icon' placeholder='fas fa-laptop')
                small.form-text.text-muted FontAwesome icon class
              
              .col-12.col-sm-6
                label.form-label(for='categoryColor') Color
                input.form-control#categoryColor(type='color' name='color' value='#007bff')
              
              .col-12.col-sm-6
                label.form-label(for='categoryParent') Parent Category
                select.form-select#categoryParent(name='parent')
                  option(value='') No parent (top-level category)
                  if categories && categories.length > 0
                    each parentCategory in categories
                      option(value=parentCategory._id)= parentCategory.name
              
              .col-12.col-sm-6
                label.form-label(for='categoryDisplayOrder') Display Order
                input.form-control#categoryDisplayOrder(type='number' name='displayOrder' placeholder='1' value='1' min='1')
              
              .col-12
                label.form-label(for='categoryAllowedProductTypes') Allowed Product Types *
                select.form-select#categoryAllowedProductTypes(name='allowedProductTypes' multiple required)
                  // Will be populated dynamically
                small.form-text.text-muted Select which product types are allowed in this category
              
              .col-12
                .form-check
                  input.form-check-input#categoryIsActive(type='checkbox' name='isActive' checked)
                  label.form-check-label(for='categoryIsActive') Active Category
        .modal-footer
          button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
          button.btn.btn-primary(type='submit' form='addCategoryModalForm' id='createCategoryBtn') Create Category

  // Modal for Add Vendor
  .modal.fade#addVendorModal(tabindex='-1' aria-labelledby='addVendorModalLabel' aria-hidden='true')
    .modal-dialog.modal-dialog-scrollable
      .modal-content
        .modal-header
          h5.modal-title#addVendorModalLabel Add New Vendor
          button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
        .modal-body
          form#addVendorModalForm
            .row.g-3
              .col-12.col-sm-6
                label.form-label(for='vendorName') Vendor Name *
                input.form-control#vendorName(type='text' name='name' placeholder='Enter vendor name' required)
              
              .col-12.col-sm-6
                label.form-label(for='vendorEmail') Email
                input.form-control#vendorEmail(type='email' name='email' placeholder='vendor@example.com')
              
              .col-12.col-sm-6
                label.form-label(for='vendorPhone') Phone
                input.form-control#vendorPhone(type='tel' name='phone' placeholder='+1 (555) 123-4567')
              
              .col-12.col-sm-6
                label.form-label(for='vendorAddress') Address
                input.form-control#vendorAddress(type='text' name='address' placeholder='123 Main St, City, State')
              
              .col-12
                label.form-label(for='vendorDescription') Description
                textarea.form-control#vendorDescription(name='description' rows='3' placeholder='Describe the vendor...')
              
              .col-12
                .form-check
                  input.form-check-input#vendorIsActive(type='checkbox' name='isActive' checked)
                  label.form-check-label(for='vendorIsActive') Active Vendor
        .modal-footer
          button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Cancel
          button.btn.btn-primary(type='submit' form='addVendorModalForm' id='createVendorBtn') Create Vendor