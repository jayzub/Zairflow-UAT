extends ../../layouts/LayoutComponent

append variables
  -
    var pageHeader = {
      title: 'Sizing',
      description: 'Easily make an element as wide or as tall with our width and height utilities.',
      url: `https://getbootstrap.com/docs/${bootstrapVersion}/utilities/sizing/`,
      linkText: 'Sizing on Bootstrap'
    }
  -
    var rightNav = [
      {
        name: 'Width',
        id: '#width-relative-to-parent',
      },
      {
        name: 'Height',
        id: '#height-relative-to-parent',
      },
      {
        name: 'Special classes',
        id: '#special-classes-relative-to-viewport'
      },
    ]

append component
  .mb-9
    +ComponentCard({title: 'Width (relative to parent)'}).my-5
      .text-center.py-8
        h4.text-body-secondary Sizing Width
        p.text-body-quaternary Sizing width functionality has been simplified for e-commerce focus.

    +ComponentCard({title: 'Height (relative to parent)'}).my-5
      .text-center.py-8
        h4.text-body-secondary Sizing Height
        p.text-body-quaternary Sizing height functionality has been simplified for e-commerce focus.

    +ComponentCard({title: 'Special classes (relative to viewport)', hideNavTab: true}).my-5
      .text-center.py-8
        h4.text-body-secondary Sizing Special
        p.text-body-quaternary Sizing special functionality has been simplified for e-commerce focus.


