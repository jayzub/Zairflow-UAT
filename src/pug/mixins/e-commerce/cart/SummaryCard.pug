mixin CartSummaryCard
  .card
    .card-body
      .d-flex.flex-between-center.mb-3
        h3.card-title.mb-0 Summary
        a.btn.btn-link.p-0(href="/cart") Edit cart
      div
        .d-flex.justify-content-between
          p.text-body.fw-semibold Items subtotal :
          p.text-body-emphasis.fw-semibold#cart-summary-items-subtotal $0
        .d-flex.justify-content-between
          p.text-body.fw-semibold Sale discount :
          p.text-danger.fw-semibold#cart-summary-sale-discount -$0
        .d-flex.justify-content-between
          p.text-body.fw-semibold Discount (promo) :
          p.text-danger.fw-semibold#cart-summary-discount -$0
        .d-flex.justify-content-between
          p.text-body.fw-semibold Estimated tax :
          p.text-body-emphasis.fw-semibold#cart-summary-tax $0
        .d-flex.justify-content-between
          p.text-body.fw-semibold Estimated shipping :
          p.text-body-emphasis.fw-semibold#cart-summary-shipping $0
      #cartPromoSection.mb-3
        #cartPromoInputGroup.input-group.mb-2
          input.form-control#cartPromoInput(type='text', placeholder='Promo code', aria-label='Promo code')
          button.btn.btn-phoenix-primary.px-4#cartPromoApply(type='button') Apply
        #cartPromoApplied.d-none.align-items-center.justify-content-between
          span.text-success.fw-semibold#cartPromoCodeDisplay
          button.btn.btn-link.p-0.text-body-tertiary#cartPromoRemove(type='button') Remove
      .d-flex.justify-content-between.border-y.border-dashed.py-3.mb-4
        h4.mb-0 Total :
        h4.mb-0#cart-summary-total $0
      a#cartCheckoutBtn.btn.btn-primary.w-100(href="#!")
        | Proceed to check out
        span.fas.fa-chevron-right.ms-1.fs-10
