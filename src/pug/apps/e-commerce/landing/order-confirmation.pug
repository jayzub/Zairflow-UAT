extends ../../../layouts/LayoutEcommerce

append variables
  - var disableNavigationType = true;
  - var disableHorizontalNavbarShape = true;
  - var disableVerticalNavbarAppearance = true;
  - var disableHorizontalNavbarAppearance = true;

block ecomContent
  +Section(null,'container-small').pt-5.pb-9(data-order-confirmation data-order-id=(order && order._id) data-order-total=(typeof totalPrice === 'number' ? totalPrice : 0) data-order-number=orderNumber)
    nav.mb-3(aria-label='breadcrumb')
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a(href=(typeof isCustomerStorefront !== 'undefined' && isCustomerStorefront) ? '/home' : '#!') Home
        li.breadcrumb-item
          a(href='/cart') Cart
        li.breadcrumb-item
          a(href='/checkout') Checkout
        li.breadcrumb-item.active(aria-current='page') Order confirmed
    .text-center.py-4
      .mb-4
        span.fas.fa-check-circle.fs-1.text-success(aria-hidden='true')
      h2.mb-2 Order confirmed
      p.text-body-secondary.mb-4 Thank you for your order. We have received your order and will process it shortly.

    .card.border.mb-5
      .card-body
        .row.mb-3
          .col-md-6
            p.mb-1
              strong Order number:
              |  #{orderNumber}
            if order && order.status
              p.mb-1
                strong Status:
                |  #{order.status}
            if order && order.paymentMethod
              p.mb-1
                strong Payment:
                |  #{order.paymentMethod === 'card' ? 'Card' : order.paymentMethod === 'cod' ? 'Cash on delivery' : order.paymentMethod}
          .col-md-6
            if order && order.shippingAddress1
              p.mb-1
                strong Shipping to:
              p.mb-0.text-body-secondary
                | #{order.shippingAddress1}#{order.shippingAddress2 ? ', ' + order.shippingAddress2 : ''}
                br
                | #{order.city ? order.city + ', ' : ''}#{order.zip ? order.zip + ' ' : ''}#{order.country || ''}
                if order.phone
                  br
                  | #{order.phone}

        if order && order.orderItems && order.orderItems.length
          hr
          h6.fw-semibold.mb-3 Order items
          table.table.table-sm.mb-0
            thead
              tr
                th(scope='col') Product
                th.text-end(scope='col') Qty
                th.text-end(scope='col') Price
                th.text-end(scope='col') Total
            tbody
              each item in order.orderItems
                - var name = (item.product && item.product.name) ? item.product.name : 'Product';
                - var qty = item.quantity || 1;
                - var up = (item.unitPrice != null && item.unitPrice >= 0) ? item.unitPrice : 0;
                - var lineTotal = qty * up;
                tr
                  td= name
                  td.text-end= qty
                  td.text-end $#{typeof up === 'number' ? up.toFixed(2) : '0.00'}
                  td.text-end $#{typeof lineTotal === 'number' ? lineTotal.toFixed(2) : '0.00'}
          .mt-3.d-flex.justify-content-between.fw-semibold
            span Total
            span $#{typeof totalPrice === 'number' ? totalPrice.toFixed(2) : '0.00'}

    .d-flex.flex-wrap.gap-2
      a.btn.btn-primary(href='/profile') View my orders
      a.btn.btn-phoenix-secondary(href=(typeof isCustomerStorefront !== 'undefined' && isCustomerStorefront) ? '/home' : '#!') Continue shopping

append scripts
  script.
    (function() {
      var page = document.querySelector('[data-order-confirmation]');
      if (!page) return;
      var orderId = page.getAttribute('data-order-id') || '';
      var orderTotal = parseFloat(page.getAttribute('data-order-total')) || 0;
      var orderNumber = page.getAttribute('data-order-number') || '';
      if (typeof window.dataLayer !== 'undefined') {
        window.dataLayer.push({
          event: 'purchase',
          ecommerce: {
            transaction_id: orderId,
            value: orderTotal,
            currency: 'USD',
            order_number: orderNumber
          }
        });
      }
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'purchase', {
          transaction_id: orderId,
          value: orderTotal,
          currency: 'USD'
        });
      }
    })();
