mixin Details
  .row.g-5.mb-5.mb-lg-8(data-product-details)
    .col-12.col-lg-6
      .row.g-3.mb-3
        .col-12.col-md-2.col-lg-12.col-xl-2
          #swiper-products-thumb.swiper-products-thumb.swiper.swiper.theme-slider.overflow-visible
            .swiper-wrapper
              each image in product.gallery
                .swiper-slide
                  img(src=image.url alt=image.alt width=38)
        .col-12.col-md-10.col-lg-12.col-xl-10
          .d-flex.align-items-center.border.border-translucent.rounded-3.text-center.p-5.h-100
            .swiper.swiper.theme-slider(data-thumb-target='swiper-products-thumb' data-products-swiper!={
              slidesPerView: 1,
              spaceBetween: 16,
              thumbsEl: '.swiper-products-thumb'
            })
              .swiper-wrapper
                each image in product.gallery
                  .swiper-slide
                    img(src=image.url alt=image.alt).img-fluid

      .d-flex
        button.btn.btn-lg.btn-outline-warning.rounded-pill.w-100.me-3.px-2.px-sm-4.fs-9.fs-sm-8
          span.me-2.far.fa-heart
          | Add to wishlist
        button.btn.btn-lg.btn-warning.rounded-pill.w-100.fs-9.fs-sm-8
          span.fas.fa-shopping-cart.me-2
          | Add to cart
    .col-12.col-lg-6
      .d-flex.flex-column.justify-content-between.h-100
        div
          .d-flex.flex-wrap
            .me-2
              +Rating(product.rating)
            p.text-primary.fw-semibold.mb-2 (#{product.numReviews}) People rated and reviewed 
          h3.mb-3.lh-sm #{product.name}
          if product.category
            .d-flex.flex-wrap.align-items-start.mb-3
              each cat in product.category
                span.badge.text-bg-success.fs-9.rounded-pill.me-2.fw-semibold= cat.name

          .d-flex.flex-wrap.align-items-center
            if product.formattedSalePrice
                h1.me-3 $#{product.formattedSalePrice}
                p.text-body-quaternary.text-decoration-line-through.fs-6.mb-0.me-3 $#{product.formattedPrice}
                p.text-warning.fw-bolder.fs-6.mb-0 #{product.discountPercentage}% off
            else
              h1.me-3 $#{product.formattedPrice}

          p(class=`text-${product.stockLevel === 'high' ? 'success' : product.stockLevel === 'medium' ? 'warning' : 'danger'} fw-semibold fs-7 mb-2`)= product.stockStatus
          
          if product.deliveryInfo
            p.mb-2.text-body-secondary!= product.deliveryInfo
          if product.specialOffer
            p.text-danger-dark.fw-bold.mb-5.mb-lg-0!= product.specialOffer
            
        div
          if product.availableColors && product.availableColors.length
            .mb-3
              p.fw-semibold.mb-2.text-body Color: 
                span.text-body-emphasis(data-product-color)= product.availableColors[0]
              .d-flex.product-color-variants(data-product-color-variants)
                each color in product.availableColors
                  .rounded-1.border.border-translucent.me-2(
                    class={active: color === product.availableColors[0]} 
                    data-variant=color 
                    data-products-images!=[
                      ...product.gallery.map(image => image.url)
                    ]
                  )
                    if product.gallery && product.gallery[0]
                      img(src=product.gallery[0].url alt=color width=38)
          //- .mb-3
            p.fw-semibold.mb-2.text-body Color : 
              span.text-body-emphasis(data-product-color) Blue
            .d-flex.product-color-variants(data-product-color-variants)
              .rounded-1.border.border-translucent.me-2.active(data-variant='Blue' data-products-images!= [
                `${CWD}assets/img/products/details/blue_front.png`,
                `${CWD}assets/img/products/details/blue_back.png`,
                `${CWD}assets/img/products/details/blue_side.png`,
              ])
                img(src=`${CWD}assets/img/products/details/blue_front.png`, alt="" width=38)

              .rounded-1.border.border-translucent.me-2(data-variant='Red' data-products-images!= [
                `${CWD}assets/img/products/details/red_front.png`,
                `${CWD}assets/img/products/details/red_back.png`,
                `${CWD}assets/img/products/details/red_side.png`,
              ])
                img(src=`${CWD}assets/img/products/details/red_front.png`, alt="" width=38)

              .rounded-1.border.border-translucent.me-2(data-variant='Green' data-products-images!= [
                `${CWD}assets/img/products/details/green_front.png`,
                `${CWD}assets/img/products/details/green_back.png`,
                `${CWD}assets/img/products/details/green_side.png`,
              ])
                img(src=`${CWD}assets/img/products/details/green_front.png`, alt="" width=38)

              .rounded-1.border.border-translucent.me-2(data-variant='Purple' data-products-images!= [
                `${CWD}assets/img/products/details/purple_front.png`,
                `${CWD}assets/img/products/details/purple_back.png`,
                `${CWD}assets/img/products/details/purple_side.png`,
              ])
                img(src=`${CWD}assets/img/products/details/purple_front.png`, alt="" width=38)

              .rounded-1.border.border-translucent.me-2(data-variant='Silver' data-products-images!= [
                `${CWD}assets/img/products/details/silver_front.png`,
                `${CWD}assets/img/products/details/silver_back.png`,
                `${CWD}assets/img/products/details/silver_side.png`,
              ])
                img(src=`${CWD}assets/img/products/details/silver_front.png`, alt="" width=38)

              .rounded-1.border.border-translucent.me-2(data-variant='Yellow' data-products-images!= [
                `${CWD}assets/img/products/details/yellow_front.png`,
                `${CWD}assets/img/products/details/yellow_back.png`,
                `${CWD}assets/img/products/details/yellow_side.png`,
              ])
                img(src=`${CWD}assets/img/products/details/yellow_front.png`, alt="" width=38)

              .rounded-1.border.border-translucent.me-2(data-variant='Orange' data-products-images!= [
                `${CWD}assets/img/products/details/orange_front.png`,
                `${CWD}assets/img/products/details/orange_back.png`,
                `${CWD}assets/img/products/details/orange_side.png`,
              ])
                img(src=`${CWD}assets/img/products/details/orange_front.png`, alt="" width=38)


          if product.availableSizes && product.availableSizes.length
            .row.g-3.g-sm-5.align-items-end
              .col-12.col-sm-auto
                p.fw-semibold.mb-2.text-body Size:
                .d-flex.align-items-center
                  select.form-select.w-auto
                    each size in product.availableSizes
                      option(value=size)= size
                  if product.sizeChart
                    a.ms-2.fs-9.fw-semibold(href="#!")= product.sizeChart

          .row.g-3.g-sm-5.align-items-end
            .col-12.col-sm
              p.fw-semibold.mb-2.text-body Quantity:
              .d-flex.justify-content-between.align-items-end
                .d-flex.flex-between-center(data-quantity)
                  button.btn.btn-phoenix-primary.px-3(data-type="minus")
                    span.fas.fa-minus
                  input.form-control.text-center.input-spin-none.bg-transparent.border-0.outline-none(
                    style='width:50px;' 
                    type='number' 
                    min="1" 
                    max=product.countInStock 
                    value="1"
                  )
                  button.btn.btn-phoenix-primary.px-3(data-type="plus")
                    span.fas.fa-plus
                button.btn.btn-phoenix-primary.px-3.border-0
                  span.fas.fa-share-alt.fs-7