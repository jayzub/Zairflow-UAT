extends ../../layouts/LayoutComponent

append variables
  -
    var pageHeader = {
      title: 'Unicons Icons',
      description: 'Beautiful Open Source Icons',
      url: `https://iconscout.com/unicons/`,
      linkText: 'Unicons Documentation',
    }

block component
  .mb-9
    +ComponentCard({
      title: 'Unicons Icons',
      anchor: true,
      hideCopyCode: true,
      description: 'Unicons icon functionality has been simplified for e-commerce focus.'
    }).my-5
      .text-center.py-8
        h4.text-body-secondary Unicons Icons
        p.text-body-quaternary Icon functionality has been simplified for e-commerce focus.



