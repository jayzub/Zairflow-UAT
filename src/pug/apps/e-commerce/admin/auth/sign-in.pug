extends ../../../../layouts/LayoutTheme
include ../../../../layouts/LayoutCardAuth

block wrapperContent
  +LayoutCardBasic({img:37, page: 'sign-in'})
    .auth-form-box
      .text-center.mb-7
        a(href=`/`).d-flex.flex-center.text-decoration-none.mb-4
          +Logo({text:false,width:58}).fw-bolder.fs-3.d-inline-block
        h3.text-body-highlight Admin Sign In
        p.text-body-tertiary Access your e-commerce admin dashboard
      
      //- Remove social buttons for admin login
      .position-relative
        hr.bg-body-secondary.mt-5.mb-4
        .divider-content-center.bg-body-emphasis Enter your credentials
      
      form#adminSignInForm
        .mb-3.text-start
          label.form-label(for='email') Email address
          .form-icon-container
            input#email.form-control.form-icon-input(type='email' placeholder='admin@example.com' required)
            span.fas.fa-user.text-body.fs-9.form-icon
        
        .mb-3.text-start
          label.form-label(for='password') Password
          .form-icon-container(data-password)
            input#password.form-control.form-icon-input.pe-6(type='password' placeholder='Password' data-password-input required)
            span.fas.fa-key.text-body.fs-9.form-icon
            button.btn.px-3.py-0.h-100.position-absolute.top-0.end-0.fs-7.text-body-tertiary(type='button' data-password-toggle)
              span.uil.uil-eye.show
              span.uil.uil-eye-slash.hide
        
        .row.flex-between-center.mb-7
          .col-auto
            .form-check.mb-0
              input#rememberMe.form-check-input(type='checkbox' checked='checked')
              label.form-check-label.mb-0(for='rememberMe') Remember me
          .col-auto
            a.fs-9.fw-semibold(href=`${CWD}${paths['card-forgot-password']}`) Forgot Password?
        
        button.btn.btn-primary.w-100.mb-3(type='submit') Sign In
        
        //- Loading spinner (hidden by default)
        .text-center.mb-3.d-none#loadingSpinner
          .spinner-border.spinner-border-sm.text-primary.me-2(role='status')
          span Signing in...
        
        //- Error message container
        .alert.alert-danger.d-none#errorMessage(role='alert')
          span#errorText
        
        //- Success message container
        .alert.alert-success.d-none#successMessage(role='alert')
          span#successText
      
      .text-center
        a.fs-9.fw-bold(href='/admin/auth/sign-up') Create an account

block append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('adminSignInForm');
      const loadingSpinner = document.getElementById('loadingSpinner');
      const errorMessage = document.getElementById('errorMessage');
      const successMessage = document.getElementById('successMessage');
      const errorText = document.getElementById('errorText');
      const successText = document.getElementById('successText');
      
      // Read redirect from URL (set when user was sent here from a protected page)
      const urlParams = new URLSearchParams(window.location.search);
      const redirectTo = urlParams.get('redirect');
      const safeRedirect = redirectTo && redirectTo.startsWith('/admin') && !redirectTo.startsWith('//') ? redirectTo : null;
      
      // Hide messages initially
      function hideMessages() {
        errorMessage.classList.add('d-none');
        successMessage.classList.add('d-none');
      }
      
      // Show error message
      function showError(message) {
        hideMessages();
        errorText.textContent = message;
        errorMessage.classList.remove('d-none');
      }
      
      // Show success message
      function showSuccess(message) {
        hideMessages();
        successText.textContent = message;
        successMessage.classList.remove('d-none');
      }
      
      // Show/hide loading spinner
      function setLoading(loading) {
        if (loading) {
          loadingSpinner.classList.remove('d-none');
          form.querySelector('button[type="submit"]').disabled = true;
        } else {
          loadingSpinner.classList.add('d-none');
          form.querySelector('button[type="submit"]').disabled = false;
        }
      }
      
      // Handle form submission
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        
        // Basic validation
        if (!email || !password) {
          showError('Please fill in all fields');
          return;
        }
        
        if (!email.includes('@')) {
          showError('Please enter a valid email address');
          return;
        }
        
        setLoading(true);
        hideMessages();
        
        try {
          const response = await fetch('/admin/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            credentials: 'include',
            body: JSON.stringify({
              email: email,
              password: password
            })
          });
          
          const data = await response.json();
          
          if (response.ok && data.success) {
            // Auth is via HTTP-only cookie; store only display info for navbar (no token in localStorage)
            localStorage.setItem('adminUser', JSON.stringify({
              email: data.user,
              role: data.role,
              isPlatformAdmin: data.isPlatformAdmin,
              isAdmin: true
            }));

            showSuccess('Sign in successful! Redirecting...');

            // If user was sent here from a protected page, send them back after login
            if (safeRedirect) {
              setTimeout(() => { window.location.href = safeRedirect; }, 500);
              return;
            }

            // Check if user is platform admin or has stores and redirect accordingly (cookie sent automatically)
            setTimeout(async () => {
              try {
                if (data.isPlatformAdmin || data.role === 'platform_admin') {
                  window.location.href = '/admin/';
                  return;
                }

                const storeResponse = await fetch('/admin/stores/my-stores', { credentials: 'include' });
                if (storeResponse.ok) {
                  const storeData = await storeResponse.json();
                  if (storeData.success && storeData.data && storeData.data.length > 0) {
                    window.location.href = '/admin/';
                  } else {
                    window.location.href = '/admin/create-store';
                  }
                } else {
                  window.location.href = '/admin/';
                }
              } catch (error) {
                console.error('Error checking stores:', error);
                window.location.href = '/admin/';
              }
            }, 1500);
            
          } else {
            showError(data.message || 'Sign in failed. Please check your credentials.');
          }
          
        } catch (error) {
          console.error('Sign in error:', error);
          showError('Network error. Please try again.');
        } finally {
          setLoading(false);
        }
      });
      
      // If cookie-based session exists, /admin/me will return 200 and we redirect
      (async () => {
        try {
          const meRes = await fetch('/admin/me', {
            method: 'GET',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'include'
          });
          if (meRes.ok) {
            window.location.href = safeRedirect || '/admin/';
            return;
          }
        } catch (e) {
          // fall through
        }
        // Clear any leftover client-side state
        localStorage.removeItem('adminToken');
        localStorage.removeItem('adminUser');
      })();
    }); 