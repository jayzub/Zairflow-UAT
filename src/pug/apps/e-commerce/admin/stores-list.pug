extends ../../../layouts/LayoutTheme

block content
  .mb-9
    .row.align-items-center.mb-4
      .col
        h2.mb-0 My Stores
      .col-auto
        a.btn.btn-primary.btn-sm(href='/admin/create-store')
          i.fas.fa-plus.me-2
          | Create New Store
    .row
      .col-12
        .card.border-0.shadow-sm
          .card-header.bg-transparent
            h5.mb-0 Store Management
          .card-body
            #storesList
              .text-center.py-5
                .spinner-border.text-primary(role='status')
                  span.visually-hidden Loading...
            #noStoresMessage.d-none
              .text-center.py-5
                .fs-1.text-muted.mb-3
                  i.fas.fa-store
                h4.text-muted No Stores Found
                p.text-muted You don't have any stores yet. Create your first store to get started.
                a.btn.btn-primary(href='/admin/create-store')
                  i.fas.fa-plus.me-2
                  | Create Your First Store

block append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Auth is cookie-based
      (async function init() {
        const meRes = await fetch('/admin/me', { credentials: 'include', headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } });
        if (!meRes.ok) {
          window.location.href = '/admin/auth/sign-in';
          return;
        }

        async function loadStores() {
          try {
            const response = await fetch('/admin/stores/my-stores', { credentials: 'include' });
            if (response.ok) {
              const data = await response.json();
              if (data.success && data.data && data.data.length > 0) {
                displayStores(data.data);
              } else {
                showNoStoresMessage();
              }
            } else {
              showNoStoresMessage();
            }
          } catch (error) {
            console.error('Error loading stores:', error);
            showNoStoresMessage();
          }
        }

        function displayStores(stores) {
          const storesList = document.getElementById('storesList');
          const noStoresMessage = document.getElementById('noStoresMessage');
          storesList.classList.remove('d-none');
          noStoresMessage.classList.add('d-none');
          const storesHtml = stores.map(store => `
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100 border-0 shadow-sm">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                  <h5 class="card-title mb-0">${store.name}</h5>
                  <span class="badge ${store.isActive ? 'bg-success' : 'bg-secondary'}">${store.isActive ? 'Active' : 'Inactive'}</span>
                </div>
                <p class="card-text text-muted">${store.description || 'No description available'}</p>
                <div class="mb-3">
                  <small class="text-muted">
                    <i class="fas fa-user me-1"></i>
                    Owner: ${store.owner?.firstName || ''} ${store.owner?.lastName || ''}
                  </small>
                </div>
                <div class="mb-3">
                  <small class="text-muted">
                    <i class="fas fa-calendar me-1"></i>
                    Created: ${new Date(store.dateCreated).toLocaleDateString()}
                  </small>
                </div>
                <div class="d-flex gap-2">
                  <a href="/admin/stores/${store._id}" class="btn btn-primary btn-sm flex-fill">
                    <i class="fas fa-cog me-1"></i>
                    Manage
                  </a>
                  <button class="btn btn-outline-secondary btn-sm" onclick="viewStoreAnalytics('${store._id}')">
                    <i class="fas fa-chart-line"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        `).join('');
          storesList.innerHTML = '<div class="row">' + storesHtml + '</div>';
        }

        function showNoStoresMessage() {
          const storesList = document.getElementById('storesList');
          const noStoresMessage = document.getElementById('noStoresMessage');
          storesList.classList.add('d-none');
          noStoresMessage.classList.remove('d-none');
        }

        loadStores();

        // Logout is handled by the navbar Profile dropdown (Sign out).
        window.viewStoreAnalytics = function(storeId) {
          window.location.href = '/admin/stores/' + storeId + '/analytics';
        };
      })();
    }); 