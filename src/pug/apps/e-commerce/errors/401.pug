extends ../../../layouts/LayoutTheme


block wrapperContent
  .px-3
    .row.min-vh-100.flex-center.p-5
      .col-12.col-xl-10.col-xxl-8
        .row.justify-content-center.align-items-center.g-5
          .col-12.col-lg-6.text-center.order-lg-1
            img.img-fluid.w-lg-100.d-dark-none(src=`${CWD}assets/img/spot-illustrations/403-illustration.png` alt="" width=400)
            img.img-fluid.w-md-50.w-lg-100.d-light-none(src=`${CWD}assets/img/spot-illustrations/dark_403-illustration.png` alt="" width=540)
          .col-12.col-lg-6.text-center.text-lg-start
            img.img-fluid.mb-6.w-50.w-lg-75.d-dark-none(src=`${CWD}assets/img/spot-illustrations/403.png` alt="")
            img.img-fluid.mb-6.w-50.w-lg-75.d-light-none(src=`${CWD}assets/img/spot-illustrations/dark_403.png` alt="")
            h2.text-body-secondary.fw-bolder.mb-3 Access Unauthorized!
            p.text-body.mb-5 You need to be authenticated to access this resource. Please sign in to continue.
              br.d-none.d-md-block.d-lg-none
              | Please sign in to continue.
            a.btn.btn-lg.btn-primary(href=`${CWD}admin/auth/sign-in`) Sign In
            a.btn.btn-lg.btn-outline-primary.ms-2(href=`/`) Go Home 