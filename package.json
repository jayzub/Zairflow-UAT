{
  "name": "phoenix",
  "version": "1.20.1",
  "description": "Dashboard & WebApp Template",
  "main": "gulpfile.js",
  "scripts": {
    "start": "concurrently \"gulp\" \"node backend/server.js\"",
    "dev": "concurrently \"gulp\" \"nodemon backend/server.js\"",
    "start:prod": "cross-env MODE=PROD gulp",
    "start:render": "node backend/server.js",
    "simulate:render": "npm run build && npm run start:render",
    "build": "cross-env MODE=PROD gulp build",
    "build:test": "cross-env MODE=PROD gulp build:test",
    "live": "gulp compile:all && cross-env MODE=PROD gulp live",
    "publish": "gh-pages -d live",
    "publish:force": "cross-var git push origin `git subtree split --prefix live $npm_package_version`:gh-pages --force",
    "publish:f": "git push origin `git subtree split --prefix live main`:gh-pages --force",
    "localhost": "ssh -R 80:localhost:3000 ssh.localhost.run",
    "test": "jest",
    "create-admin": "node backend/scripts/createPlatformAdmin.js",
    "admin:list": "node backend/scripts/adminManager.js list",
    "admin:create-platform": "node backend/scripts/adminManager.js create-platform-admin",
    "admin:create-store-owner": "node backend/scripts/adminManager.js create-store-owner",
    "admin:create-store-admin": "node backend/scripts/adminManager.js create-store-admin",
    "admin:delete": "node backend/scripts/adminManager.js delete-admin",
    "admin:reset-password": "node backend/scripts/adminManager.js reset-password",
    "admin:help": "node backend/scripts/adminManager.js help",
    "test-db": "node backend/scripts/testConnection.js",
    "create-store": "node backend/scripts/createStoreAndOwner.js",
    "test-store": "node backend/scripts/testStoreCreation.js",
    "debug-jwt": "node backend/scripts/debugJWT.js"
  },
