mixin PriceList(features)
	each feature in features
		li.mb-4.d-flex.align-items-center
			if feature.icon
				span.fa-li
					span(class=feature.icon)
			span.text-body-secondary(style=feature.icon ? '--phoenix-text-opacity:1;' : '--phoenix-text-opacity:.5;') #{feature.label}
			if feature.newBadge
				span.badge.badge-phoenix.badge-phoenix-warning.ms-2.fs-10(class=feature.icon ? '' : 'opacity-50') New

mixin PriceItem(config)
	.px-5
		.text-center.pt-5
			img(src=`${CWD}assets/img/icons/illustrations/${config.image}` width=48 height=48 alt='' )
			h3.fw-semibold.my-4=config.category
		.text-center
			h1.fw-semibold.text-primary $
				span.fw-bolder= config.price
				//- span.text-body-emphasis.fs-7.ms-1.fw-bolder= config.month
			h5.mb-4.text-body= config.month
			a.btn.btn-lg.mb-6.w-100(class=config.buyBtnClass href=`/admin/auth/sign-up`) Start Free Trial

	ul.fa-ul.pricing-list
		+PriceList(config.features)

mixin Pricing
	section.bg-body-emphasis.pt-lg-0.pt-xl-8#pricing
		+Background({image: `${CWD}assets/img/bg/bg-left-15.png`, attrs: { style: { 'background-position': 'left', 'background-size': 'auto',} }, className: 'd-none d-md-block' })
		+Background({image: `${CWD}assets/img/bg/bg-right-15.png`, attrs: { style: { 'background-position': 'right', 'background-size': 'auto',} }, className: 'd-none d-md-block' })
		.container-small.position-relative.px-lg-7.px-xxl-3
			.mb-4.text-center.text-sm-start
				h4.text-primary.fw-bolder.mb-3 Pricing
				h2 Choose the perfect plan for your business
			p.column-md-2.text-center.text-sm-start Start your e-commerce journey with Griffin. Choose the plan that fits your business needs and scale as you grow.

			.row.pt-9.g-3.g-xl-0
				each card, index in pricingCards.slice(0,3)
					.col-md-6.col-xl-3
						.card.h-100(class=card.cardClasses)
							if index==1
								.position-absolute.d-flex.flex-center.bg-primary-subtle.rounded-top.py-1.end-0.start-0.badge-pricing 
									p.text-primary-dark.mb-0 Most popular
							.card-body.px-6
								+PriceItem(card)

				.col-12.col-md-6.col-xl-3.ps-xl-3
					.row.g-0.h-100.justify-content-center
						.col-xl-12
							.card.h-100.mt-5.mt-md-0&attributes(attributes)
								.card-body
									+PriceItem(pricingCards[3])
				.col-12.text-center.mt-8
					p For Enterprise Solution with Custom Development, Dedicated Infrastructure, and Advanced Security - 
						a(href="#contact")  Contact us