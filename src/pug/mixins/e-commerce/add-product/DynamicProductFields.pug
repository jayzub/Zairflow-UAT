mixin DynamicProductFields
  .card&attributes(attributes)
    .card-body
      h4.card-title.mb-4 Product Details
      
      //- Dynamic product type fields will be generated here
      #dynamicProductFields
        .text-center.text-muted.py-4
          i.fas.fa-info-circle.me-2
          | Select a product type to see specific fields
      
      //- Common variant fields for all product types
      .mt-4
        h5.mb-3 Variants
        .variants-container
          .variant-item.mb-3
            //- input.form-control.mb-2(type='text' name='variants[0].sku' placeholder='SKU')
            //- input.form-control.mb-2(type='text' name='variants[0].color' placeholder='Color')
            //- input.form-control.mb-2(type='text' name='variants[0].colorHex' placeholder='Color Hex Code')
        button.btn.btn-phoenix-primary.w-100.add-variant-btn(type='button') Add Variant
