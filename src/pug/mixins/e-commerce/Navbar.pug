mixin CategoryDropdown
  -
    var categories = [
      {
        title: 'Collectibles & Art',
        icon: 'pocket',
        sections: [
          'Collectibles',
          'Antiques',
          'Sports memorabilia ',
          'Art',
        ]
      },
      {
        title: 'Home & Gardan',
        icon: 'home',
        sections: [
          'Yard, Garden & Outdoor',
          'Crafts',
          'Home Improvement',
          'Pet Supplies',
        ]
      },
      {
        title: 'Sporting Goods',
        icon: 'globe',
        sections: [
          'Outdoor Sports',
          'Team Sports',
          'Exercise & Fitness',
          'Golf',
        ]
      },
      {
        title: 'Electronics',
        icon: 'monitor',
        sections: [
          'Computers & Tablets',
          'Camera & Photo',
          'TV, Audio & Surveillance',
          'Cell Ohone & Accessories',
        ]
      },
      {
        title: 'Auto Parts & Accessories',
        icon: 'truck',
        sections: [
          'GPS & Security Devices',
          'Rader & Laser Detectors',
          'Care & Detailing',
          'Scooter Parts & Accessories',
        ]
      },
      {
        title: 'Toys & Hobbies',
        icon: 'codesandbox',
        sections: [
          'Radio Control',
          'Kids Toys',
          'Action Figures',
          'Dolls & Bears',
        ]
      },
      {
        title: 'Fashion',
        icon: 'watch',
        sections: [
          'Women',
          'Men',
          'Jewelry & Watches',
          'Shoes',
        ]
      },
      {
        title: 'Musical Instruments & Gear',
        icon: 'music',
        sections: [
          'Guitar',
          'Pro Audio Equipment',
          'String',
          'Stage Lighting & Effects',
        ]
      },
      {
        title: 'Other Categories',
        icon: 'grid',
        sections: [
          'Video Games & Consoles',
          'Health & Beauty',
          'Baby',
          'Business & Industrial',
        ]
      },
    ]
  .dropdown
    button.btn.text-body.ps-0.pe-5.text-nowrap.dropdown-toggle.dropdown-caret-none(data-category-btn data-bs-toggle='dropdown')
      span.fas.fa-bars.me-2
      | Category
    .dropdown-menu.border.border-translucent.py-0.category-dropdown-menu
      .card.border-0.scrollbar(style='max-height: 657px;')
        .card-body.p-6.pb-3
          .row.gx-7.gy-5.mb-5
            each category in categories
              .col-12.col-sm-6.col-md-4
                .d-flex.align-items-center.mb-3
                  span.text-primary.me-2(data-feather=`${category.icon}` style='stroke-width:3;')
                  h6.text-body-highlight.mb-0.text-nowrap=category.title
                .ms-n2
                  each section in category.sections
                    a.text-body-emphasis.d-block.mb-1.text-decoration-none.bg-body-highlight-hover.px-2.py-1.rounded-2(href="#!")=section 
          .text-center.border-top.border-translucent.pt-3
            a.fw-bold(href="#!")
              | See all Categories
              span.fas.fa-angle-right.ms-1(data-fa-transform="down-1")

mixin Navbar
  nav.navbar-responsive-navitems.navbar-expand.navbar-light.bg-body-emphasis.justify-content-between
    .container-small.d-flex.flex-between-center(data-navbar) 
      +CategoryDropdown
      ul.navbar-nav.justify-content-end.align-items-center
        li.nav-item(data-nav-item)
          -
            var homeHref = (typeof storeHomepageUrl !== 'undefined' && storeHomepageUrl)
              ? storeHomepageUrl
              : '/home';
          a.nav-link.ps-0(class=activeNavItem === 'home' ? 'active' : '' href=homeHref) Home
        if typeof storeSlug === 'undefined' || !storeSlug
          li.nav-item(data-nav-item)
            a.nav-link(class=activeNavItem === 'store' ? 'active' : '' href=`${CWD}${paths['e-commerce-fe-favourite-stores']}`) My Favourite Stores
        li.nav-item(data-nav-item)
          -
            var productsHref = (typeof storeSlug !== 'undefined' && storeSlug)
              ? `//${storeSlug}.localhost:3001/api/products`
              : `${CWD}${paths['e-commerce-fe-product-filter']}`;
          a.nav-link(class=activeNavItem === 'products' ? 'active' : '' href=productsHref) Products




