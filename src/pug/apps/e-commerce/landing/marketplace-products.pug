							+Rating(1).fs-9.me-1
							p.ms-1.mb-0 &amp; above	

					a.btn.px-0.d-block.collapse-indicator(data-bs-toggle='collapse' href='#collapseProductType' role='button' aria-expanded='true' aria-controls='collapseProductType')
						.d-flex.align-items-center.justify-content-between.w-100
							.fs-8.text-body-highlight Product Type
							span.fa-solid.fa-angle-down.toggle-icon.text-body-quaternary

					.collapse.show#collapseProductType
						.mb-2
							.form-check.mb-0
								input.form-check-input.mt-0#electronicsInput(type='checkbox' name='productType' value='Electronics' checked=currentFilters && currentFilters.productType && currentFilters.productType.includes('Electronics'))
								label.form-check-label.d-block.lh-sm.fs-8.text-body.fw-normal.mb-0(for='electronicsInput') Electronics
							.form-check.mb-0
								input.form-check-input.mt-0#clothingInput(type='checkbox' name='productType' value='Clothing' checked=currentFilters && currentFilters.productType && currentFilters.productType.includes('Clothing'))
								label.form-check-label.d-block.lh-sm.fs-8.text-body.fw-normal.mb-0(for='clothingInput') Clothing
							.form-check.mb-0
								input.form-check-input.mt-0#furnitureInput(type='checkbox' name='productType' value='Furniture' checked=currentFilters && currentFilters.productType && currentFilters.productType.includes('Furniture'))
								label.form-check-label.d-block.lh-sm.fs-8.text-body.fw-normal.mb-0(for='furnitureInput') Furniture

					a.btn.px-0.d-block.collapse-indicator(data-bs-toggle='collapse' href='#collapseSpecialOffers' role='button' aria-expanded='true' aria-controls='collapseSpecialOffers')
						.d-flex.align-items-center.justify-content-between.w-100
							.fs-8.text-body-highlight Special Offers
							span.fa-solid.fa-angle-down.toggle-icon.text-body-quaternary

					.collapse.show#collapseSpecialOffers
						.mb-2
							.form-check.mb-0
								input.form-check-input.mt-0#featuredInput(type='checkbox' name='featured' value='true' checked=currentFilters && currentFilters.featured)
								label.form-check-label.d-block.lh-sm.fs-8.text-body.fw-normal.mb-0(for='featuredInput') Featured Products
							.form-check.mb-0
								input.form-check-input.mt-0#onSaleInput(type='checkbox' name='onSale' value='true' checked=currentFilters && currentFilters.onSale)
								label.form-check-label.d-block.lh-sm.fs-8.text-body.fw-normal.mb-0(for='onSaleInput') On Sale

				.phoenix-offcanvas-backdrop.d-lg-none(data-phoenix-backdrop style='top: 92px')

			.col-lg-9.col-xxl-10
				// Products per page selector
				.d-flex.justify-content-between.align-items-center.mb-4
					.small.text-body-tertiary
						| Showing #{(products && products.length) ? products.length : 0} of #{productCount || 0} products
					.d-flex.align-items-center
						label.me-2.small.text-body-tertiary(for='products-per-page') Products per page:
						select#products-per-page.form-select.form-select-sm(style='width: auto;')
							option(value='12', selected=(limit || 24)==12) 12
							option(value='24', selected=(limit || 24)==24) 24
							option(value='48', selected=(limit || 24)==48) 48
							option(value='96', selected=(limit || 24)==96) 96

				.row.gx-3.gy-6.mb-8
					if products && products.length > 0
						each product in products
							.col-12.col-sm-6.col-md-4.col-xxl-2
								.product-card-container.h-100
									+Product(product)
					else
						.col-12
							.text-center.py-8
								h4.text-body-secondary No products found
								p.text-body-quaternary Try adjusting your filters or search criteria

				// Dynamic pagination bar
				if (totalPages || 0) > 1
					.d-flex.justify-content-center
						nav(aria-label='Product pagination')
							ul.pagination.mb-0
								li.page-item(class=(hasPrevPage || false) ? '' : 'disabled')
									a.page-link(href=`?page=${(currentPage || 1) - 1}&limit=${limit || 24}` aria-label='Previous' data-page=((currentPage || 1) - 1) tabindex=(hasPrevPage || false) ? 0 : -1)
										span.fas.fa-chevron-left
								each pageNum in (pageRange || [])
									if pageNum === '...'
										li.page-item.disabled
											span.page-link &hellip;
									else
										li.page-item(class=pageNum === (currentPage || 1) ? 'active' : '')
											a.page-link(href=`?page=${pageNum}&limit=${limit || 24}` data-page=pageNum) #{pageNum}
								li.page-item(class=(hasNextPage || false) ? '' : 'disabled')
									a.page-link(href=`?page=${(currentPage || 1) + 1}&limit=${limit || 24}` aria-label='Next' data-page=((currentPage || 1) + 1) tabindex=(hasNextPage || false) ? 0 : -1)
										span.fas.fa-chevron-right

				// Load More Products button
				if (hasNextPage || false)
					.d-flex.justify-content-center.mt-4
						button#load-more-btn.btn.btn-outline-primary(type='button' data-next-page=((currentPage || 1) + 1))
							span.fas.fa-plus.me-2
							| Load More Products 