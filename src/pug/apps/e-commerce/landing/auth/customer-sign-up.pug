extends ../../../../layouts/LayoutTheme
include ../../../../layouts/LayoutCardAuth

block wrapperContent
  +LayoutCardBasic({img:37, page: 'sign-up'})
    .auth-form-box
      .text-center.mb-7
        a(href=`/`).d-flex.flex-center.text-decoration-none.mb-4
          +Logo({text:false,width:58}).fw-bolder.fs-3.d-inline-block
        h3.text-body-highlight Create Customer Account
        p.text-body-tertiary Create an account to track orders and manage your profile
      
      .position-relative
        hr.bg-body-secondary.mt-5.mb-4
        .divider-content-center.bg-body-emphasis Enter your information
      
      form#customerSignUpForm
        .mb-3
          label.form-label(for='name') Full name
          input#name.form-control(type='text' placeholder='Jane Smith' required)
        
        .mb-3
          label.form-label(for='email') Email address
          .form-icon-container
            input#email.form-control.form-icon-input(type='email' placeholder='you@example.com' required)
            span.fas.fa-envelope.text-body.fs-9.form-icon
        
        .mb-3
          label.form-label(for='phone') Phone number
          .form-icon-container
            input#phone.form-control.form-icon-input(type='tel' placeholder='+1234567890' required)
            span.fas.fa-phone.text-body.fs-9.form-icon
        
        .row.g-3.mb-3
          .col-sm-6
            label.form-label(for='dateOfBirth') Date of birth (optional)
            input#dateOfBirth.form-control(type='date')
          .col-sm-6
            label.form-label(for='gender') Gender (optional)
            select#gender.form-select
              option(value='' selected) Prefer not to say
              option(value='male') Male
              option(value='female') Female
              option(value='other') Other
              option(value='prefer_not_to_say') Prefer not to say
        
        .mb-3
          label.form-label(for='password') Password
          .form-icon-container(data-password)
            input#password.form-control.form-icon-input.pe-6(type='password' placeholder='Password (min 6 chars)' data-password-input required)
            span.fas.fa-key.text-body.fs-9.form-icon
            button.btn.px-3.py-0.h-100.position-absolute.top-0.end-0.fs-7.text-body-tertiary(type='button' data-password-toggle)
              span.uil.uil-eye.show
              span.uil.uil-eye-slash.hide
        
        .mb-3
          label.form-label(for='confirmPassword') Confirm password
          .form-icon-container(data-password)
            input#confirmPassword.form-control.form-icon-input.pe-6(type='password' placeholder='Confirm password' data-password-input required)
            span.fas.fa-key.text-body.fs-9.form-icon
            button.btn.px-3.py-0.h-100.position-absolute.top-0.end-0.fs-7.text-body-tertiary(type='button' data-password-toggle)
              span.uil.uil-eye.show
              span.uil.uil-eye-slash.hide
        
        .mb-3
          .form-check
            input#terms.form-check-input(type='checkbox' required)
            label.form-check-label(for='terms')
              | I agree to the 
              a(href='#') terms
              |  and 
              a(href='#') privacy policy
        
        button.btn.btn-primary.w-100.mb-3(type='submit') Create Account
        
        .text-center.mb-3.d-none#loadingSpinner
          .spinner-border.spinner-border-sm.text-primary.me-2(role='status')
          span Creating account...
        
        .alert.alert-danger.d-none#errorMessage(role='alert')
          span#errorText
        
        .alert.alert-success.d-none#successMessage(role='alert')
          span#successText
      
      .text-center
        a.fs-9.fw-bold(href='/customers/sign-in') Already have an account? Sign in

block append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('customerSignUpForm');
      const loadingSpinner = document.getElementById('loadingSpinner');
      const errorMessage = document.getElementById('errorMessage');
      const successMessage = document.getElementById('successMessage');
      const errorText = document.getElementById('errorText');
      const successText = document.getElementById('successText');
      
      function hideMessages() {
        errorMessage.classList.add('d-none');
        successMessage.classList.add('d-none');
      }
      
      function showError(message) {
        hideMessages();
        errorText.textContent = message;
        errorMessage.classList.remove('d-none');
      }
      
      function showSuccess(message) {
        hideMessages();
        successText.textContent = message;
        successMessage.classList.remove('d-none');
      }
      
      function setLoading(loading) {
        if (loading) {
          loadingSpinner.classList.remove('d-none');
          form.querySelector('button[type="submit"]').disabled = true;
        } else {
          loadingSpinner.classList.add('d-none');
          form.querySelector('button[type="submit"]').disabled = false;
        }
      }
      
      function validatePassword(password) {
        if (!password || password.length < 6) return 'Password must be at least 6 characters long';
        return null;
      }
      
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const name = document.getElementById('name').value;
        const email = document.getElementById('email').value;
        const phone = document.getElementById('phone').value;
        const dateOfBirth = document.getElementById('dateOfBirth').value;
        const gender = document.getElementById('gender').value;
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        const terms = document.getElementById('terms').checked;
        
        if (!name || !email || !phone || !password || !confirmPassword) {
          showError('Please fill in all required fields');
          return;
        }
        if (!email.includes('@')) {
          showError('Please enter a valid email address');
          return;
        }
        if (password !== confirmPassword) {
          showError('Passwords do not match');
          return;
        }
        
        const passwordError = validatePassword(password);
        if (passwordError) {
          showError(passwordError);
          return;
        }
        
        if (!terms) {
          showError('Please agree to the terms and privacy policy');
          return;
        }
        
        setLoading(true);
        hideMessages();
        
        try {
          const payload = {
            name,
            email,
            phone,
            password
          };
          
          if (dateOfBirth) payload.dateOfBirth = dateOfBirth;
          if (gender) payload.gender = gender;
          
          const response = await fetch('/api/customers/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          
          const data = await response.json().catch(() => ({}));
          
          if (response.ok && data.success) {
            const token = (data && data.data && data.data.token) || data.token;
            const customer = (data && data.data && data.data.customer) || data.customer;
            
            if (token) {
              localStorage.setItem('customerToken', token);
            }
            if (customer) {
              localStorage.setItem('customer', JSON.stringify(customer));
            }
            
            showSuccess('Account created! Redirecting...');
            setTimeout(() => {
              window.location.href = '/';
            }, 1200);
          } else {
            showError(data.error || data.message || 'Account creation failed. Please try again.');
          }
        } catch (err) {
          console.error('Customer sign-up error:', err);
          showError('Network error. Please try again.');
        } finally {
          setLoading(false);
        }
      });
      
      // If already signed in, go home
      const token = localStorage.getItem('customerToken');
      if (token) {
        window.location.href = '/';
      }
    });

