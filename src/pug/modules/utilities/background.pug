extends ../../layouts/LayoutComponent

append variables

  -
    var pageHeader = {
      title: 'Background',
      description: 'Convey meaning through color with a handful of color utility classes. Includes support for styling links with hover states, too.',
      url: `https://getbootstrap.com/docs/${bootstrapVersion}/utilities/background/`,
      linkText: 'Background on Bootstrap'
    }
  -
    var rightNav = [
      {
        name: 'Solid colors',
        id: '#solid-colors',
      },
      {
        name: 'Grays',
        id: '#grays',
      },
      {
        name: 'Gradients',
        id: '#gradients'
      }
    ]
append component
  .mb-9
    +ComponentCard({title:'Solid colors', anchor: true}).my-5#doc-bg-color
      .text-center.py-8
        h4.text-body-secondary Background Utilities
        p.text-body-quaternary Background utility functionality has been simplified for e-commerce focus.

    +ComponentCard({title:'Body colors', anchor: true}).my-5#doc-bg-body
      .text-center.py-8
        h4.text-body-secondary Body Colors
        p.text-body-quaternary Body color functionality has been simplified for e-commerce focus.

    +ComponentCard({title:'Subtle colors', anchor: true}).my-5#doc-bg-subtle
      .text-center.py-8
        h4.text-body-secondary Subtle Colors
        p.text-body-quaternary Subtle color functionality has been simplified for e-commerce focus.

    +ComponentCard({title:'Gradients', anchor: true}).my-5#doc-bg-gradients
      .text-center.py-8
        h4.text-body-secondary Background Gradients
        p.text-body-quaternary Gradient functionality has been simplified for e-commerce focus.

    +ComponentCard({title:'Grays', anchor: true}).my-5#doc-bg-grays
      .text-center.py-8
        h4.text-body-secondary Gray Shades
        p.text-body-quaternary Gray shade functionality has been simplified for e-commerce focus.