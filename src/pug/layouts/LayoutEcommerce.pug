  - var attrsFooter = { class: 'position-relative'}

//- Sync customerToken from localStorage to cookie so next full page load shows customer name in navbar; update cart badge; cart dropdown
append layoutScripts
  script.
    (function() {
      // Remember current page (full URL) for "return after login" so subdomain works
      if (typeof sessionStorage !== 'undefined') {
        var path = window.location.pathname + window.location.search;
        if (path.indexOf('/customers/sign-in') !== 0 && path.indexOf('/customers/sign-up') !== 0) {
          sessionStorage.setItem('customerReturnUrl', path);
          sessionStorage.setItem('customerReturnUrlFull', window.location.href);
        }
      }
      // Add full-URL redirect to sign-in links so return-after-login works on subdomains
      (function() {
        var signInLinks = document.querySelectorAll('a[href*="/customers/sign-in"]');
        var currentFull = window.location.href;
        signInLinks.forEach(function(a) {
          var href = a.getAttribute('href') || '';
          if (href.indexOf('redirect=') === -1) {
            var sep = href.indexOf('?') >= 0 ? '&' : '?';
            a.setAttribute('href', href + sep + 'redirect=' + encodeURIComponent(currentFull));
          }
        });
      })();

      var token = typeof localStorage !== 'undefined' && localStorage.getItem('customerToken');
      if (token) {
        fetch('/api/customers/session', { method: 'GET', headers: { 'Authorization': 'Bearer ' + token }, credentials: 'same-origin' }).catch(function() {});
        fetch('/api/customers/carts', { headers: { 'Authorization': 'Bearer ' + token }, credentials: 'same-origin' })
          .then(function(r) { return r.ok ? r.json() : null; })
          .then(function(json) {
            if (json && json.data && Array.isArray(json.data)) {
              var total = json.data.reduce(function(sum, c) { return sum + (c.itemCount || 0); }, 0);
              var el = document.getElementById('cartBadgeCount');
              if (el) { el.textContent = total; el.style.display = total ? '' : 'none'; }
            }
          })
          .catch(function() {});
      }

      function formatPrice(p) {
        if (p == null || p === undefined) return '0.00';
        var n = typeof p === 'number' ? p : parseFloat(p);
        return isNaN(n) ? '0.00' : n.toFixed(2);
      }

      function renderCartDropdown(cart) {
        var container = document.getElementById('cartDropdownItems');
        var emptyEl = document.getElementById('cartDropdownEmpty');
        var signInEl = document.getElementById('cartDropdownSignIn');
        var loading = container ? container.querySelector('.cart-dropdown-loading') : null;
        if (!container) return;
        var t = typeof localStorage !== 'undefined' && localStorage.getItem('customerToken');
        if (!t) {
          if (loading) loading.style.display = 'none';
          if (emptyEl) emptyEl.style.display = 'none';
          if (signInEl) signInEl.style.display = 'block';
          container.innerHTML = '';
          var badgeEl = document.getElementById('cartBadgeCount');
          if (badgeEl) { badgeEl.textContent = '0'; badgeEl.style.display = 'none'; }
          return;
        }
        if (signInEl) signInEl.style.display = 'none';
        var items = (cart && cart.items) || [];
        if (items.length === 0) {
          if (loading) loading.style.display = 'none';
          container.innerHTML = '';
          if (emptyEl) emptyEl.style.display = 'block';
          var badgeEl0 = document.getElementById('cartBadgeCount');
          if (badgeEl0) { badgeEl0.textContent = '0'; badgeEl0.style.display = 'none'; }
          return;
        }
        if (emptyEl) emptyEl.style.display = 'none';
        var html = '';
        items.forEach(function(item) {
          var product = item.product || {};
          var name = product.name || 'Product';
          var imgUrl = (product.image && product.image.url) ? product.image.url : '';
          var price = item.unitPrice != null && item.unitPrice >= 0 ? item.unitPrice : (product.price != null ? parseFloat(product.price) : 0);
          var qty = Math.max(1, parseInt(item.quantity, 10) || 1);
          var total = price * qty;
          html += '<div class="dropdown-item py-2 border-bottom border-translucent d-flex align-items-center cart-dropdown-row" data-item-id="' + (item._id || '') + '">';
          var color = (item.options && item.options.color) ? item.options.color : '';
          var size = (item.options && item.options.size) ? item.options.size : '';
          var variantLabel = [color, size].filter(Boolean).join(' / ') || '';
          html += '<a href="/api/products/' + (product._id || '') + '" class="d-flex align-items-center flex-grow-1 text-decoration-none text-body min-w-0">';
          html += '<span class="border border-translucent rounded-1 overflow-hidden me-2 flex-shrink-0" style="width:40px;height:40px;">';
          if (imgUrl) html += '<img src="' + imgUrl + '" alt="" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display=\'none\'">';
          html += '</span>';
          html += '<span class="text-start min-w-0"><span class="d-block line-clamp-2 fs-9">' + name + '</span>';
          if (variantLabel) html += '<span class="d-block fs-10 text-body-tertiary">' + variantLabel + '</span>';
          html += '</span></a>';
          html += '<div class="d-flex align-items-center flex-shrink-0 ms-2">';
          html += '<div class="input-group input-group-sm flex-nowrap" style="width: 7rem;">';
          html += '<button type="button" class="btn btn-phoenix-primary btn-sm px-2 cart-dropdown-minus" aria-label="Decrease">−</button>';
          html += '<input type="number" class="form-control form-control-sm text-center border-0 px-1 cart-dropdown-qty" min="1" value="' + qty + '" readonly aria-label="Quantity" style="max-width: 2.5rem;">';
          html += '<button type="button" class="btn btn-phoenix-primary btn-sm px-2 cart-dropdown-plus" aria-label="Increase">+</button>';
          html += '</div>';
          html += '<span class="text-body-emphasis fw-semibold fs-9 ms-2" style="min-width: 3.5rem;">$' + formatPrice(total) + '</span>';
          html += '</div>';
          html += '</div>';
        });
        container.innerHTML = html;
        items.forEach(function(item) {
          var row = container.querySelector('.cart-dropdown-row[data-item-id="' + item._id + '"]');
          if (!row) return;
          var qtyInput = row.querySelector('.cart-dropdown-qty');
          var minusBtn = row.querySelector('.cart-dropdown-minus');
          var plusBtn = row.querySelector('.cart-dropdown-plus');
          var price = item.unitPrice != null && item.unitPrice >= 0 ? item.unitPrice : (item.product && item.product.price != null ? parseFloat(item.product.price) : 0);
          function updateQty(newQty) {
            newQty = Math.max(1, parseInt(newQty, 10) || 1);
            var authToken = typeof localStorage !== 'undefined' && localStorage.getItem('customerToken');
            if (!authToken) return;
            fetch('/api/customers/cart/items/' + item._id, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + authToken },
              credentials: 'same-origin',
              body: JSON.stringify({ quantity: newQty })
            }).then(function(r) {
              if (!r.ok) return null;
              return fetch('/api/customers/cart/items', { headers: { 'Authorization': 'Bearer ' + authToken }, credentials: 'same-origin' });
            }).then(function(r) {
              if (r && r.ok) return r.json();
              return null;
            }).then(function(json) {
              if (json && json.data) renderCartDropdown(json.data);
              else if (typeof window.updateCartBadge === 'function') window.updateCartBadge();
            }).catch(function() {});
          }
          if (minusBtn) minusBtn.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); var v = parseInt(qtyInput.value, 10) || 1; qtyInput.value = Math.max(1, v - 1); updateQty(qtyInput.value); });
          if (plusBtn) plusBtn.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); var v = parseInt(qtyInput.value, 10) || 1; qtyInput.value = v + 1; updateQty(qtyInput.value); });
        });
        var totalQty = items.reduce(function(sum, i) { return sum + (Math.max(1, parseInt(i.quantity, 10) || 1)); }, 0);
        var badgeEl = document.getElementById('cartBadgeCount');
        if (badgeEl) { badgeEl.textContent = totalQty; badgeEl.style.display = totalQty ? '' : 'none'; }
        if (loading) loading.style.display = 'none';
      }

      function updateCartBadge() {
        var t = typeof localStorage !== 'undefined' && localStorage.getItem('customerToken');
        if (!t) return;
        fetch('/api/customers/carts', { headers: { 'Authorization': 'Bearer ' + t }, credentials: 'same-origin' })
          .then(function(r) { return r.ok ? r.json() : null; })
          .then(function(json) {
            if (json && json.data && Array.isArray(json.data)) {
              var total = json.data.reduce(function(sum, c) { return sum + (c.itemCount || 0); }, 0);
              var el = document.getElementById('cartBadgeCount');
              if (el) { el.textContent = total; el.style.display = total ? '' : 'none'; }
            }
          })
          .catch(function() {});
      }
      window.updateCartBadge = updateCartBadge;

      var cartDropdownTrigger = document.getElementById('navbarTopDropdownCart');
      if (cartDropdownTrigger) {
        cartDropdownTrigger.addEventListener('shown.bs.dropdown', function() {
          var container = document.getElementById('cartDropdownItems');
          var emptyEl = document.getElementById('cartDropdownEmpty');
          var signInEl = document.getElementById('cartDropdownSignIn');
          if (emptyEl) emptyEl.style.display = 'none';
          if (signInEl) signInEl.style.display = 'none';
          if (container) container.innerHTML = '<div class="text-center text-body-tertiary py-5 px-3"><span class="cart-dropdown-loading">Loading…</span></div>';
          var t = typeof localStorage !== 'undefined' && localStorage.getItem('customerToken');
          if (!t) {
            if (container) container.innerHTML = '';
            if (signInEl) signInEl.style.display = 'block';
            return;
          }
          fetch('/api/customers/cart/items', { headers: { 'Authorization': 'Bearer ' + t }, credentials: 'same-origin' })
            .then(function(r) {
              if (r.status === 401) { renderCartDropdown(null); return null; }
              return r.ok ? r.json() : null;
            })
            .then(function(json) {
              if (json && json.data) renderCartDropdown(json.data);
              else renderCartDropdown(null);
            })
            .catch(function() { renderCartDropdown(null); });
        });
      }
    })();

//- Product search suggestions (as-you-type) on store
append layoutScripts
  script.
    (function() {
      function initSearchSuggestions() {
        var searchInput = document.getElementById('customer-product-search-input');
        var dropdown = document.getElementById('search-suggestions-dropdown');
        if (!searchInput || !dropdown) return;
        var debounceTimer;
        var productsBaseUrl = '/api/products';
        function escapeHtml(s) {
          var div = document.createElement('div');
          div.textContent = s;
          return div.innerHTML;
        }
        function boldMatch(label, q) {
          if (!q) return escapeHtml(label);
          var i = label.toLowerCase().indexOf(q.toLowerCase());
          if (i === -1) return escapeHtml(label);
          return escapeHtml(label.slice(0, i)) + '<strong class="text-body-highlight">' + escapeHtml(label.slice(i, i + q.length)) + '</strong>' + escapeHtml(label.slice(i + q.length));
        }
        function showSuggestions(suggestions, query) {
          if (!suggestions || suggestions.length === 0) {
            dropdown.innerHTML = '<div class="list-group-item text-body-tertiary py-2 small">No suggestions</div>';
          } else {
            dropdown.innerHTML = suggestions.map(function(s) {
              var href = productsBaseUrl + '?search=' + encodeURIComponent(s.label);
              return '<a class="list-group-item list-group-item-action py-2 d-flex justify-content-between align-items-center text-decoration-none" href="' + href + '">' +
                '<span>' + boldMatch(s.label, query) + '</span>' +
                '<span class="text-body-tertiary fs-9 ms-2">' + (s.count != null ? Number(s.count).toLocaleString() : '') + '</span></a>';
            }).join('');
          }
          dropdown.classList.remove('d-none');
          dropdown.style.display = 'block';
        }
        function hideSuggestions() {
          dropdown.classList.add('d-none');
          dropdown.style.display = 'none';
        }
        function fetchSuggestions(q) {
          if (!q || q.length < 2) {
            hideSuggestions();
            return;
          }
          fetch(productsBaseUrl + '/suggestions?q=' + encodeURIComponent(q) + '&limit=10', { credentials: 'same-origin' })
            .then(function(r) { return r.ok ? r.json() : null; })
            .then(function(data) {
              if (data && Array.isArray(data.suggestions)) showSuggestions(data.suggestions, q);
              else showSuggestions([]);
            })
            .catch(function() { hideSuggestions(); });
        }
        searchInput.addEventListener('input', function() {
          clearTimeout(debounceTimer);
          var val = searchInput.value.trim();
          debounceTimer = setTimeout(function() {
            if (val.length >= 2) fetchSuggestions(val);
            else hideSuggestions();
          }, 200);
        });
        searchInput.addEventListener('focus', function() {
          var val = searchInput.value.trim();
          if (val.length >= 2) fetchSuggestions(val);
        });
        searchInput.addEventListener('blur', function() {
          setTimeout(function() {
            if (!dropdown.contains(document.activeElement)) hideSuggestions();
          }, 200);
        });
        document.addEventListener('click', function(e) {
          if (!dropdown.contains(e.target) && e.target !== searchInput) hideSuggestions();
        });
        var form = searchInput.closest('form');
        if (form) {
          form.addEventListener('submit', function(e) {
            e.preventDefault();
            var val = searchInput.value.trim();
            if (val) window.location.href = productsBaseUrl + '?search=' + encodeURIComponent(val);
          });
        }
        (function syncFromUrl() {
          var params = new URLSearchParams(window.location.search);
          var searchParam = params.get('search') || params.get('q');
          if (searchParam && searchInput.value !== searchParam) searchInput.value = searchParam;
        })();
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSearchSuggestions);
      } else {
        initSearchSuggestions();
      }
    })();

