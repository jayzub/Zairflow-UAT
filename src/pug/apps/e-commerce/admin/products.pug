extends ../../../layouts/LayoutTheme
include ../../../mixins/dashboard/common
include ../../../mixins/e-commerce/ProductsTable

append variables
  - 
    var breadcrumb = [
      {
        label: 'Page 1',
        href: '#!'
      },
      {
        label: 'Page 2',
        href: '#!',
      },
      {
        label: 'Default',
        href: '#!',
        active: true
      },
    ];


block content
  .mb-9
    .row.g-3.mb-4
      .col-auto
        h2.mb-0 #{pageTitle}
    - var _base = `/${adminUrl}/products`
    - var _limit = limit || 10
    - function _query(f, cats, vend) { var q = 'filter=' + f + '&limit=' + _limit; if (cats) q += '&categories=' + cats; if (vend) q += '&vendor=' + vend; return q; }
    ul.nav.nav-links.mb-3.mb-lg-2.mx-n3
      li.nav-item
        a.nav-link(class=(currentFilter === 'all' ? 'active' : '') href=`${_base}?${_query('all', '', '')}` aria-current=(currentFilter === 'all' ? 'page' : undefined))
          span All
          span.text-body-tertiary.fw-semibold (#{filterCounts ? filterCounts.all : productCount})
      li.nav-item
        a.nav-link(class=(currentFilter === 'published' ? 'active' : '') href=`${_base}?${_query('published', queryCategories, queryVendor)}` aria-current=(currentFilter === 'published' ? 'page' : undefined))
          span Published
          span.text-body-tertiary.fw-semibold (#{filterCounts ? filterCounts.published : 0})
      li.nav-item
        a.nav-link(class=(currentFilter === 'drafts' ? 'active' : '') href=`${_base}?${_query('drafts', queryCategories, queryVendor)}` aria-current=(currentFilter === 'drafts' ? 'page' : undefined))
          span Drafts
          span.text-body-tertiary.fw-semibold (#{filterCounts ? filterCounts.drafts : 0})
      li.nav-item
        a.nav-link(class=(currentFilter === 'discount' ? 'active' : '') href=`${_base}?${_query('discount', queryCategories, queryVendor)}` aria-current=(currentFilter === 'discount' ? 'page' : undefined))
          span On discount
          span.text-body-tertiary.fw-semibold (#{filterCounts ? filterCounts.onDiscount : 0})
      li.nav-item
        a.nav-link(class=(currentFilter === 'featured' ? 'active' : '') href=`${_base}?${_query('featured', queryCategories, queryVendor)}` aria-current=(currentFilter === 'featured' ? 'page' : undefined))
          span Is featured
          span.text-body-tertiary.fw-semibold (#{filterCounts ? filterCounts.featured : featuredProductsCount})

    #products-container
      .mb-4
        .d-flex.flex-wrap.gap-3
          +Search({placeholder: 'Search products', inputId: 'products-search-input', value: querySearch || ''})
          .scrollbar.overflow-hidden-y
            .btn-group.position-static(role='group')
              .btn-group.position-static.text-nowrap
                button.btn.btn-phoenix-secondary.px-7.flex-shrink-0(type='button' data-bs-toggle='dropdown' data-boundary="window" aria-haspopup="true" aria-expanded="false" data-bs-reference="parent")
                  | Category
                  span.fas.fa-angle-down.ms-2
                ul.dropdown-menu
                  li
                    a.dropdown-item(href=`${_base}?${_query(currentFilter, '', queryVendor)}`) All categories
                  if categories && categories.length > 0
                    li
                      hr.dropdown-divider
                    each category in categories
                      li
                        a.dropdown-item(href=`${_base}?${_query(currentFilter, category._id ? String(category._id) : '', queryVendor)}`) #{category.name}
              .btn-group.position-static.text-nowrap
                button.btn.btn-sm.btn-phoenix-secondary.px-7.flex-shrink-0(type='button' data-bs-toggle='dropdown' data-boundary="window" aria-haspopup="true" aria-expanded="false" data-bs-reference="parent")
                  | Vendor
                  span.fas.fa-angle-down.ms-2
                ul.dropdown-menu
                  li
                    a.dropdown-item(href=`${_base}?${_query(currentFilter, queryCategories, '')}`) All vendors
                  if vendors && vendors.length > 0
                    li
                      hr.dropdown-divider
                    each vendor in vendors
                      li
                        a.dropdown-item(href=`${_base}?${_query(currentFilter, queryCategories, vendor._id ? String(vendor._id) : '')}`) #{vendor.name}
              .btn-group.position-static.text-nowrap
                button.btn.btn-sm.btn-phoenix-secondary.px-7.flex-shrink-0(type='button' data-bs-toggle='dropdown' data-boundary="window" aria-haspopup="true" aria-expanded="false" data-bs-reference="parent")
                  | More filters
                  span.fas.fa-angle-down.ms-2
                .dropdown-menu.dropdown-menu-end.p-3(style='min-width: 280px')
                  form#more-filters-form(action=_base method='get')
                    input(type='hidden' name='filter' value=currentFilter || 'all')
                    input(type='hidden' name='limit' value=_limit)
                    if queryCategories
                      input(type='hidden' name='categories' value=queryCategories)
                    if queryVendor
                      input(type='hidden' name='vendor' value=queryVendor)
                    .mb-3
                      label.form-label.small Price range
                      .row.g-2
                        .col-6
                          input.form-control.form-control-sm(type='number' name='minPrice' placeholder='Min' min='0' step='0.01' value=queryMinPrice || '')
                        .col-6
                          input.form-control.form-control-sm(type='number' name='maxPrice' placeholder='Max' min='0' step='0.01' value=queryMaxPrice || '')
                    .mb-3
                      label.form-label.small Product type
                      select.form-select.form-select-sm(name='productType')
                        option(value='' selected=!queryProductType) All types
                        if allowedProductTypes && allowedProductTypes.length
                          each pt in allowedProductTypes
                            - var ptVal = typeof pt === 'string' ? pt : (pt.value || pt.name || pt)
                            option(value=ptVal selected=queryProductType === ptVal) #{typeof pt === 'string' ? pt : (pt.label || pt.name || pt.value || pt)}
                    .d-flex.justify-content-between.gap-2
                      a.btn.btn-phoenix-secondary.btn-sm(href=`${_base}?${_query(currentFilter, queryCategories, queryVendor)}`) Clear
                      button.btn.btn-phoenix-primary.btn-sm(type='submit') Apply
          .ms-xxl-auto
            button.btn.btn-link.text-body.me-4.px-0.disabled(disabled type='button' title='Export not available for MVP')
              span.fa-solid.fa-file-export.fs-9.me-2
              | Export
            a.btn.btn-primary#addBtn(href=`/${adminUrl}/products/add`)
              span.fas.fa-plus.me-2
              | Add product
            a.btn.btn-phoenix-primary.ms-2(href=`/${adminUrl}/products/import`)
              span.fas.fa-file-import.me-2
              | Import CSV
            a.btn.btn-phoenix-secondary.ms-2(href=`/${adminUrl}/products/deleted`)
              span.fas.fa-trash-alt.me-2
              | Removed from catalog
      
      // Products per page selector and bulk actions
      .d-flex.justify-content-between.align-items-center.mb-3.flex-wrap.gap-2
        .d-flex.align-items-center
          span.text-body-secondary.me-2 Show
          select#products-per-page.form-select.form-select-sm.w-auto.me-2(name='limit')
            option(value='10', selected=limit == 10) 10
            option(value='20', selected=limit == 20) 20
            option(value='50', selected=limit == 50) 50
          span.text-body-secondary products per page
        #products-bulk-replace
          span.text-body-secondary
            | Showing #{(currentPage - 1) * limit + 1} to #{Math.min(currentPage * limit, productCount)} of #{productCount} products
        #products-bulk-actions.d-none.d-flex.align-items-center.gap-2
          button#bulk-remove-btn.btn.btn-phoenix-secondary.btn-sm(type='button')
            span.fas.fa-eye-slash.me-1
            | Remove from catalog
      .mx-n4.px-4.mx-lg-n6.px-lg-6.bg-body-emphasis.border-top.border-bottom.border-translucent.position-relative.top-1
        #products-table
          if products && products.length > 0
            +ProductTable(products, { bulkSelectActionsId: 'products-bulk-actions', bulkSelectReplaceElementId: 'products-bulk-replace' })
          else
            .text-center.py-4
              p.text-body-secondary No products available
        
        // Loading indicator
        #loading-indicator.text-center.py-4.d-none
          .spinner-border.text-primary(role='status')
            span.visually-hidden Loading...
        
        // Load more button (alternative to infinite scroll)
        #load-more-container.text-center.py-4.d-none
          button#load-more-btn.btn.btn-outline-primary
            span.fas.fa-plus.me-2
            | Load More Products
          
          // Debug button for testing
          // button#debug-btn.btn.btn-outline-secondary.ms-2
          //   span.fas.fa-bug.me-2
          //   | Debug Test

        // Pagination bar
        - function _pageUrl(p) { var q = 'filter=' + (currentFilter || 'all') + '&limit=' + _limit + '&page=' + p; if (queryCategories) q += '&categories=' + queryCategories; if (queryVendor) q += '&vendor=' + queryVendor; if (typeof queryMinPrice === 'string' && queryMinPrice) q += '&minPrice=' + encodeURIComponent(queryMinPrice); if (typeof queryMaxPrice === 'string' && queryMaxPrice) q += '&maxPrice=' + encodeURIComponent(queryMaxPrice); if (typeof queryProductType === 'string' && queryProductType) q += '&productType=' + encodeURIComponent(queryProductType); return _base + '?' + q; }
        if totalPages > 1
          nav.mt-4(aria-label='Product pagination')
            ul.pagination.justify-content-center
              li.page-item(class=hasPrevPage ? '' : 'disabled')
                a.page-link(href=hasPrevPage ? _pageUrl(currentPage - 1) : '#' aria-label='Previous')
                  span(aria-hidden='true') &laquo;
              each pageNum in pageRange
                if pageNum === '...'
                  li.page-item.disabled
                    span.page-link &hellip;
                else
                  li.page-item(class=pageNum === currentPage ? 'active' : '')
                    a.page-link(href=_pageUrl(pageNum)) #{pageNum}
              li.page-item(class=hasNextPage ? '' : 'disabled')
                a.page-link(href=hasNextPage ? _pageUrl(currentPage + 1) : '#' aria-label='Next')
                  span(aria-hidden='true') &raquo;

append scripts
  script.
    function getSelectedProductIds() {
      var body = document.getElementById('products-table-body');
      if (!body) return [];
      var checkboxes = body.querySelectorAll('input[type="checkbox"][data-bulk-select-row]:checked');
      return Array.prototype.map.call(checkboxes, function(cb) {
        var tr = cb.closest('tr');
        return tr && tr.getAttribute('data-product-id');
      }).filter(Boolean);
    }
    function bulkRemoveFromCatalogSelected() {
      var ids = getSelectedProductIds();
      if (ids.length === 0) { alert('Select at least one product.'); return; }
      if (!confirm('Remove ' + ids.length + ' product(s) from the catalog? They will be hidden and can be restored from "Removed from catalog".')) return;
      var done = 0, failed = 0;
      function runNext() {
        if (done + failed >= ids.length) {
          alert('Removed ' + done + ' product(s) from catalog.' + (failed ? ' Failed: ' + failed + '.' : ''));
          ids.forEach(function(id) {
            var row = document.querySelector('[data-product-id="' + id + '"]');
            if (row) row.remove();
          });
          var body = document.getElementById('products-table-body');
          if (body) body.querySelectorAll('input[data-bulk-select-row]:checked').forEach(function(cb) { cb.checked = false; });
          document.getElementById('products-bulk-actions').classList.add('d-none');
          document.getElementById('products-bulk-replace').classList.remove('d-none');
          var header = document.getElementById('checkbox-bulk-products-select');
          if (header) { header.checked = false; header.removeAttribute('indeterminate'); }
          return;
        }
        var id = ids[done + failed];
        fetch('/admin/products/' + id, { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, credentials: 'include' })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.success) done++; else failed++;
            runNext();
          })
          .catch(function() { failed++; runNext(); });
      }
      runNext();
    }
    // Infinite scroll implementation
    class ProductLoader {
      constructor() {
        this.currentPage = !{typeof currentPage !== 'undefined' ? currentPage : 1}; // Initialize from server data
        this.totalPages = !{typeof totalPages !== 'undefined' ? totalPages : 1};
        this.hasNextPage = !{typeof hasNextPage !== 'undefined' ? hasNextPage : false};
        this.isLoading = false;
        this.productsContainer = document.getElementById('products-table');
        this.loadingIndicator = document.getElementById('loading-indicator');
        this.loadMoreContainer = document.getElementById('load-more-container');
        this.loadMoreBtn = document.getElementById('load-more-btn');
        
        this.init();
      }
      
      init() {
        console.log('ProductLoader initialized with:', {
          currentPage: this.currentPage,
          totalPages: this.totalPages,
          hasNextPage: this.hasNextPage,
          productsContainer: this.productsContainer,
          loadingIndicator: this.loadingIndicator,
          loadMoreContainer: this.loadMoreContainer,
          loadMoreBtn: this.loadMoreBtn
        });
        
        // Show load more button if there are more pages
        if (this.hasNextPage) {
          this.loadMoreContainer.classList.remove('d-none');
          console.log('Load more button shown - there are more pages');
        } else {
          console.log('No more pages to load');
        }
        
        // Set up event listeners
        this.loadMoreBtn?.addEventListener('click', () => {
          console.log('Load more button clicked!');
          this.loadMore();
        });
        
        // Test if button exists and is clickable
        if (this.loadMoreBtn) {
          console.log('Load more button found and event listener attached');
        } else {
          console.error('Load more button not found!');
        }
        
        // Set up infinite scroll (optional - uncomment to enable)
        // this.setupInfiniteScroll();
      }
      
      setupInfiniteScroll() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting && this.hasNextPage && !this.isLoading) {
                this.loadMore();
              }
            });
          },
          { threshold: 0.1 }
        );
        
        // Observe the loading indicator
        observer.observe(this.loadingIndicator);
      }
      
      async loadMore() {
        if (this.isLoading || !this.hasNextPage) {
          console.log('Load more blocked:', { isLoading: this.isLoading, hasNextPage: this.hasNextPage });
          return;
        }
        
        this.isLoading = true;
        this.showLoading();
        
        try {
          // Build the URL preserving filter, limit, categories, vendor; set page to next
          const url = new URL(window.location.pathname, window.location.origin);
          if (window.location.search) url.search = window.location.search;
          const nextPage = this.currentPage + 1;
          url.searchParams.set('page', nextPage);
          url.searchParams.set('_t', Date.now());
          
          console.log('Loading more products from:', url.toString());
          console.log('Current page:', this.currentPage, 'Next page:', nextPage);
          
          const response = await fetch(url, {
            method: 'GET',
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
              'Content-Type': 'application/json'
            },
            credentials: 'include'
          });
          
          console.log('Response status:', response.status);
          console.log('Response headers:', Object.fromEntries(response.headers.entries()));
          
          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }
          
          const contentType = response.headers.get('content-type');
          console.log('Content-Type:', contentType);
          
          let data;
          if (contentType && contentType.includes('application/json')) {
            data = await response.json();
          } else {
            // If not JSON, try to parse the HTML response
            const text = await response.text();
            console.log('Response text (first 500 chars):', text.substring(0, 500));
            throw new Error('Response is not JSON. Server might not be handling AJAX request correctly.');
          }
          
          console.log('Received data:', data);
          
          if (data.success && data.products && data.products.length > 0) {
            console.log('Appending', data.products.length, 'products');
            this.appendProducts(data.products);
            this.currentPage = data.currentPage;
            this.totalPages = data.totalPages;
            this.hasNextPage = data.hasNextPage;
            
            console.log('Updated page:', this.currentPage, 'hasNextPage:', this.hasNextPage);
            
            // Hide load more button if no more pages
            if (!this.hasNextPage) {
              this.loadMoreContainer.classList.add('d-none');
              console.log('No more pages, hiding load more button');
            }
          } else {
            console.log('No products in response or invalid response structure');
            console.log('Response structure:', {
              success: data.success,
              productsLength: data.products?.length,
              hasNextPage: data.hasNextPage,
              currentPage: data.currentPage,
              totalPages: data.totalPages
            });
            this.hasNextPage = false;
            this.loadMoreContainer.classList.add('d-none');
          }
        } catch (error) {
          console.error('Error loading products:', error);
          this.showError(`Failed to load products: ${error.message}`);
        } finally {
          this.isLoading = false;
          this.hideLoading();
        }
      }
      
      appendProducts(products) {
        // Convert products to HTML and append to table
        const tbody = document.getElementById('products-table-body');
        if (!tbody) {
          console.error('Table body not found');
          return;
        }
        
        console.log('Appending', products.length, 'products to table');
        
        products.forEach(product => {
          const row = this.createProductRow(product);
          tbody.appendChild(row);
        });
      }

      async applyFiltersAndUpdate(urlOrHref) {
        if (this.isLoading) return;
        const url = urlOrHref.startsWith('http') ? urlOrHref : (urlOrHref.startsWith('/') ? window.location.origin + urlOrHref : window.location.pathname + '?' + urlOrHref);
        this.isLoading = true;
        this.showLoading();
        try {
          const response = await fetch(url, {
            method: 'GET',
            headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'include'
          });
          if (!response.ok) throw new Error('Network error');
          const data = await response.json();
          if (!data.success) throw new Error(data.message || 'Invalid response');
          this.replaceProducts(data.products || []);
          this.currentPage = data.currentPage || 1;
          this.totalPages = data.totalPages || 1;
          this.hasNextPage = data.hasNextPage || false;
          this.setShowingCount(data.productCount, data.limit);
          this.updatePaginationBar(data);
          if (this.loadMoreContainer) {
            this.loadMoreContainer.classList.toggle('d-none', !this.hasNextPage);
          }
          if (this.loadMoreBtn) this.loadMoreBtn.dataset.nextPage = this.currentPage + 1;
          history.replaceState({}, '', url);
        } catch (err) {
          console.error('Filter error:', err);
          window.location.href = url;
        } finally {
          this.isLoading = false;
          this.hideLoading();
        }
      }

      setShowingCount(productCount, limit) {
        const el = document.getElementById('products-bulk-replace');
        if (!el) return;
        const start = (this.currentPage - 1) * (limit || 10) + 1;
        const end = Math.min(this.currentPage * (limit || 10), productCount || 0);
        const span = el.querySelector('span.text-body-secondary');
        if (span) {
          span.textContent = 'Showing ' + start + ' to ' + end + ' of ' + (productCount || 0) + ' products';
        } else {
          el.innerHTML = '<span class="text-body-secondary">Showing ' + start + ' to ' + end + ' of ' + (productCount || 0) + ' products</span>';
        }
      }

      updatePaginationBar(data) {
        const limit = data.limit || 10;
        const currentPage = data.currentPage || 1;
        const totalPages = data.totalPages || 1;
        const hasPrevPage = data.hasPrevPage || false;
        const hasNextPage = data.hasNextPage || false;
        const adminBase = window.location.pathname.split('?')[0] || '/admin/products';
        const base = (data.queryStringForPagination != null && data.queryStringForPagination !== '') ? (data.queryStringForPagination + '&') : '';
        let nav = document.querySelector('nav[aria-label="Product pagination"]');
        if (!nav && totalPages > 1) {
          nav = document.createElement('nav');
          nav.setAttribute('aria-label', 'Product pagination');
          nav.className = 'mt-4';
          const loadMore = document.getElementById('load-more-container');
          if (loadMore && loadMore.parentNode) loadMore.parentNode.insertBefore(nav, loadMore.nextSibling);
          else document.getElementById('products-container')?.appendChild(nav);
        }
        if (!nav) return;
        nav.classList.toggle('d-none', totalPages <= 1);
        const pageRange = data.pageRange || (totalPages >= 1 ? [1] : []);
        let html = '<ul class="pagination justify-content-center">';
        html += '<li class="page-item ' + (hasPrevPage ? '' : 'disabled') + '"><a class="page-link" href="' + (hasPrevPage ? adminBase + '?' + base + 'page=' + (currentPage - 1) : '#') + '" aria-label="Previous" data-page="' + (currentPage - 1) + '"><span aria-hidden="true">&laquo;</span></a></li>';
        pageRange.forEach(function(pageNum) {
          if (pageNum === '...') {
            html += '<li class="page-item disabled"><span class="page-link">&hellip;</span></li>';
          } else {
            html += '<li class="page-item ' + (pageNum === currentPage ? 'active' : '') + '"><a class="page-link" href="' + adminBase + '?' + base + 'page=' + pageNum + '" data-page="' + pageNum + '">' + pageNum + '</a></li>';
          }
        });
        html += '<li class="page-item ' + (hasNextPage ? '' : 'disabled') + '"><a class="page-link" href="' + (hasNextPage ? adminBase + '?' + base + 'page=' + (currentPage + 1) : '#') + '" aria-label="Next" data-page="' + (currentPage + 1) + '"><span aria-hidden="true">&raquo;</span></a></li>';
        html += '</ul>';
        nav.innerHTML = html;
        nav.querySelectorAll('.page-link[data-page]').forEach(link => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const page = link.getAttribute('data-page');
            if (page && !link.closest('.page-item.disabled')) {
              const u = new URL(window.location);
              u.searchParams.set('page', page);
              this.applyFiltersAndUpdate(u.toString());
            }
          });
        });
      }

      replaceProducts(products) {
        const tbody = document.getElementById('products-table-body');
        if (!tbody) return;
        tbody.innerHTML = '';
        if (!products || products.length === 0) {
          const colCount = 10;
          tbody.innerHTML = '<tr><td colspan="' + colCount + '" class="text-center py-4 text-body-secondary">No products available</td></tr>';
          return;
        }
        products.forEach(product => {
          tbody.appendChild(this.createProductRow(product));
        });
      }
      
      createProductRow(product) {
        const row = document.createElement('tr');
        row.className = 'position-static';
        row.setAttribute('data-product-id', product._id);
        
        // Price display (match admin ProductTableRow: range + discount or single + sale)
        let priceHtml = '';
        const isPriceRange = !!(product.hasPriceRange || (product.priceRange && String(product.priceRange).includes(' - ')));
        const hasDiscount = product.maxDiscountPercentage != null && product.maxDiscountPercentage !== undefined;
        const displayRegular = product.priceRange || product.price;
        if (displayRegular) {
          priceHtml = '<div class="d-flex flex-column align-items-end">';
          if (isPriceRange && hasDiscount) {
            priceHtml += '<span class="text-body-quaternary fs-9">$' + displayRegular + '</span>';
            priceHtml += '<span class="text-success fw-bold fs-9">up to ' + product.maxDiscountPercentage + '% off</span>';
          } else if (!isPriceRange && product.salePrice && parseFloat(product.salePrice) < parseFloat(product.price)) {
            priceHtml += '<span class="text-body-quaternary fs-9">$' + displayRegular + '</span>';
            priceHtml += '<span class="text-success fw-bold">$' + product.salePrice + '</span>';
          } else {
            priceHtml += '<span>$' + displayRegular + '</span>';
          }
          priceHtml += '</div>';
        } else {
          priceHtml = '<span class="text-body-quaternary">N/A</span>';
        }
        
        // Format category
        const categoryDisplay = product.category && product.category.length > 0 
          ? product.category.map(cat => `<a href="#!" class="text-decoration-none"><span class="badge badge-tag me-2 mb-2">${cat.name}</span></a>`).join('')
          : '';
        
        // Format tags
        const tagsDisplay = product.tags && product.tags.length > 0 
          ? product.tags.map(tag => `<a href="#!" class="text-decoration-none"><span class="badge badge-tag me-2 mb-2">${tag}</span></a>`).join('')
          : '';
        
        // Format vendor
        const vendorDisplay = product.vendor 
          ? `<a href="#!">${product.vendor.name}</a>`
          : '';
        
        // Format date
        const dateDisplay = product.dateCreated 
          ? new Intl.DateTimeFormat('en-US', { 
              year: 'numeric', 
              month: 'short', 
              day: 'numeric', 
              hour: '2-digit', 
              minute: '2-digit', 
              hour12: true 
            }).format(new Date(product.dateCreated))
          : 'N/A';
        
        row.innerHTML = `
          <td class="fs-9 align-middle">
