# Required for production - generate with: openssl rand -hex 32
JWT_SECRET=change-this-secret-in-production
SECRET_KEY=change-this-secret-in-production

NODE_ENV=
API_URL=

# Optional: parent hostname for storefront URLs ({slug}.{parent}, e.g. zairflow.com).
# Use in production when the admin Host is an apex (e.g. zairflow.com) so links are not derived as {slug}.com.
STORE_SUBDOMAIN_PARENT_HOST=

# Optional: Cloudinary for image uploads
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
Cloudinary_URL=

# Optional: use external MongoDB instead of Docker MongoDB
DB_URL=

REDIS_URL=