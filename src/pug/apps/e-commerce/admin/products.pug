      showLoading() {
        this.loadingIndicator.classList.remove('d-none');
        this.loadMoreBtn?.setAttribute('disabled', 'disabled');
      }
      
      hideLoading() {
        this.loadingIndicator.classList.add('d-none');
        this.loadMoreBtn?.removeAttribute('disabled');
      }
      
      showError(message) {
        // Create and show error message
        const errorDiv = document.createElement('div');
        errorDiv.className = 'alert alert-danger alert-dismissible fade show';
        errorDiv.innerHTML = `
          ${message}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        this.productsContainer.parentNode.insertBefore(errorDiv, this.productsContainer);
      }
    }
    
    // Initialize product loader and bulk actions when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
      console.log('DOM loaded, initializing ProductLoader...');
      window.productLoader = new ProductLoader();
      var bulkRemoveBtn = document.getElementById('bulk-remove-btn');
      if (bulkRemoveBtn) bulkRemoveBtn.addEventListener('click', bulkRemoveFromCatalogSelected);
      
      // AJAX filter: intercept filter links (tabs, category, vendor) so list updates without full reload
      const container = document.getElementById('products-container');
      if (container) {
        container.addEventListener('click', (e) => {
          const link = e.target.closest('a[href*="/admin/products"]');
          if (!link || link.getAttribute('target') === '_blank' || link.hasAttribute('data-no-ajax')) return;
          const href = link.getAttribute('href');
          if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;
          try {
            const u = new URL(href, window.location.origin);
            const listPath = window.location.pathname.split('?')[0];
            if (u.pathname !== listPath) return;
            e.preventDefault();
            window.productLoader.applyFiltersAndUpdate(href);
          } catch (_) {}
        });
      }
      const moreFiltersForm = document.getElementById('more-filters-form');
      if (moreFiltersForm) {
        moreFiltersForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const form = e.target;
          const action = form.getAttribute('action') || window.location.pathname;
          const params = new URLSearchParams(new FormData(form));
          const url = action + (params.toString() ? '?' + params.toString() : '');
          window.productLoader.applyFiltersAndUpdate(url);
        });
      }
      
      // Live search: apply search as user types (debounced)
      const searchInput = document.getElementById('products-search-input');
      if (searchInput) {
        const searchForm = searchInput.closest('form');
        if (searchForm) searchForm.addEventListener('submit', (e) => e.preventDefault());
        let searchDebounce;
        searchInput.addEventListener('input', () => {
          clearTimeout(searchDebounce);
          searchDebounce = setTimeout(() => {
            const u = new URL(window.location);
            const val = searchInput.value.trim();
            if (val) u.searchParams.set('search', val);
            else u.searchParams.delete('search');
            u.searchParams.set('page', '1');
            window.productLoader.applyFiltersAndUpdate(u.toString());
          }, 300);
        });
      }
      
      // Handle products per page dropdown
      const productsPerPageSelect = document.getElementById('products-per-page');
      if (productsPerPageSelect) {
        productsPerPageSelect.addEventListener('change', (e) => {
          const newLimit = e.target.value;
          const currentUrl = new URL(window.location);
          currentUrl.searchParams.set('limit', newLimit);
          currentUrl.searchParams.set('page', 1); // Reset to first page when changing limit
          window.location.href = currentUrl.toString();
        });
      }
    });
    
    // Remove product from catalog (soft delete – product is hidden, can be restored)
    function removeFromCatalog(productId) {
      if (confirm('Remove this product from the catalog? It will be hidden from the store and can be restored later.')) {
        fetch(`/admin/products/${productId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          },
          credentials: 'include'
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            const row = document.querySelector(`[data-product-id="${productId}"]`);
            row?.remove();
            alert('Product removed from catalog.');
          } else {
            alert(data.message || 'Failed to remove product from catalog.');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('Error removing product from catalog.');
        });
      }
    }
