block append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Auth is cookie-based: ensure all fetch use credentials; no Bearer token
      function ensureCredentials(options) {
        options = options || {};
        options.credentials = options.credentials || 'include';
        return options;
      }

      // Check if user is logged in (cookie); if not, redirect to sign-in
      (async function init() {
        try {
          const meRes = await fetch('/admin/me', ensureCredentials({ headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' } }));
          if (!meRes.ok) {
            window.location.href = '/admin/auth/sign-in';
            return;
          }
        } catch (e) {
          window.location.href = '/admin/auth/sign-in';
          return;
        }

        // Check if user has stores
        async function checkUserStores() {
          try {
            const response = await fetch('/admin/stores/my-stores', ensureCredentials());
            if (response.ok) {
              const data = await response.json();
              if (!data.success || !data.data || data.data.length === 0) {
                window.location.href = '/admin/create-store';
                return;
              }
            } else {
              window.location.href = '/admin/create-store';
              return;
            }
          } catch (error) {
            console.error('Error checking user stores:', error);
            window.location.href = '/admin/create-store';
            return;
          }
        }

        async function checkUserPermissions() {
          try {
            const userResponse = await fetch('/admin/me', ensureCredentials({ headers: { 'Accept': 'application/json' } }));
            if (userResponse.ok) {
              const userData = await userResponse.json();
              if (userData.success && userData.data) {
                const user = userData.data;
                const createAdminCard = document.getElementById('createAdminCard');
                if (createAdminCard) {
                  if (user.role === 'store_owner' || user.isPlatformAdmin) {
                    createAdminCard.classList.remove('d-none');
                  } else {
                    createAdminCard.classList.add('d-none');
                  }
                }
              }
            }
          } catch (error) {
            console.error('Error checking user permissions:', error);
          }
        }

        checkUserStores();
        checkUserPermissions();
      })();

      // Handle logout: clear server cookie then all admin client storage
      document.getElementById('logoutBtn').addEventListener('click', function() {
        function clearAdminStorage() {
          localStorage.removeItem('adminToken');
          localStorage.removeItem('adminUser');
          localStorage.removeItem('userEmail');
          localStorage.removeItem('userRole');
        }
        fetch('/admin/logout', { method: 'POST', credentials: 'include' })
          .then(function() {
            clearAdminStorage();
            window.location.href = '/admin/auth/sign-in';
          })
          .catch(function() {
            clearAdminStorage();
            window.location.href = '/admin/auth/sign-in';
          });
      });
    }); 