extends LayoutTheme
include ../mixins/navbars/Mixins
include ../mixins/e-commerce/Topbar
include ../mixins/e-commerce/Navbar
include ../mixins/e-commerce/homepage/Footer

append variables
  - var navRole = 'customer';
  - var attrsBody = {  };
  - var breakPoint = 'lg';
  - var attrsFooter = { class: 'position-relative'}

//- Sync customerToken from localStorage to cookie so next full page load shows customer name in navbar
append layoutScripts
  script.
    (function() {
      var token = typeof localStorage !== 'undefined' && localStorage.getItem('customerToken');
      if (token) {
        fetch('/api/customers/session', { method: 'GET', headers: { 'Authorization': 'Bearer ' + token }, credentials: 'same-origin' }).catch(function() {});
      }
    })();

block mainContent
  +Section(null,'container-small').py-0
    +Topbar
  +Navbar
  block ecomContent

  block supportChat
  +SupportChat

  +Section(null,'container-small').bg-body-highlight.dark__bg-gray-1100.py-9
    +EcomFooter
  +Footer
