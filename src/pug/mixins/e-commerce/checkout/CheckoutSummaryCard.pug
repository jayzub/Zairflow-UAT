mixin CheckoutSummaryCard(cartScopeType, cartStoreId)
  - var scopeType = typeof cartScopeType !== 'undefined' ? cartScopeType : 'marketplace';
  - var storeId = typeof cartStoreId !== 'undefined' ? cartStoreId : '';
  - var editCartHref = '/cart?scopeType=' + encodeURIComponent(scopeType) + (scopeType === 'store' && storeId ? '&storeId=' + encodeURIComponent(storeId) : '');
  .card.mt-3.mt-lg-0#checkoutSummaryCard
    .card-body
      .d-flex.align-items-center.justify-content-between
        h3.mb-0 Summary
        a#checkoutEditCartBtn.btn.btn-link.pe-0(href=editCartHref) Edit cart

      .border-dashed.border-bottom.border-translucent.mt-4
        .ms-n2#checkout-summary-items
          .text-body-tertiary.small.py-3(data-checkout-items-placeholder) Loading...

      .border-dashed.border-bottom.border-translucent.mt-4
        .d-flex.justify-content-between.mb-2
          h5.text-body.fw-semibold Items subtotal:
          h5.text-body.fw-semibold#checkout-summary-items-subtotal $0.00
        .d-flex.justify-content-between.mb-2
          h5.text-body.fw-semibold Sale discount:
          h5.text-danger.fw-semibold#checkout-summary-sale-discount $0.00
        .d-flex.justify-content-between.mb-2
          h5.text-body.fw-semibold Discount (promo):
          h5.text-danger.fw-semibold#checkout-summary-discount $0.00
        .d-flex.justify-content-between.mb-2
          h5.text-body.fw-semibold Tax:
          h5.text-body.fw-semibold#checkout-summary-tax $0.00
        .d-flex.justify-content-between.mb-2
          h5.text-body.fw-semibold Subtotal
          h5.text-body.fw-semibold#checkout-summary-subtotal $0.00
        .d-flex.justify-content-between.mb-3
          h5.text-body.fw-semibold Shipping Cost
          h5.text-body.fw-semibold#checkout-summary-shipping $0.00

      .d-flex.justify-content-between.border-dashed-y.pt-3
        h4.mb-0 Total :
        h4.mb-0#checkout-summary-total $0.00
