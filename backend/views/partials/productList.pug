.row.isotope-grid
  if products.length > 0
    each product in products
      div(class=`col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item ${product.category.length > 0 ? product.category.map(c => c.name.toLowerCase().replace(/\\s+/g, '')).join(' ') : ''}`)
        // Block2
        .block2(data-product-id=product._id)
          .block2-pic.hov-img0
            if product.image
              a(href=`${API_URL}/products/${product._id}`)
                img(src=`/${product.image}` alt=product.name)
            
            a.block2-btn.flex-c-m.stext-103.cl2.size-102.bg0.bor2.hov-btn1.p-lr-15.trans-04.js-show-modal1(href='#' data-product-id=product._id)
              | Quick View
          
          .block2-txt.flex-w.flex-t.p-t-14
            .block2-txt-child1.flex-col-l
              a.stext-104.cl4.hov-cl1.trans-04.js-name-b2.p-b-6(href=`/product/${product._id}`)
                = product.name
              
              span.stext-105.cl3
                | $#{product.price}
            
            .block2-txt-child2.flex-r.p-t-3
              a.btn-addwish-b2.dis-block.pos-relative.js-addwish-b2(href='#')
                img.icon-heart1.dis-block.trans-04(src='/images/icons/icon-heart-01.png' alt='ICON')
                img.icon-heart2.dis-block.trans-04.ab-t-l(src='/images/icons/icon-heart-02.png' alt='ICON')
  else
    p No products available at the moment. 