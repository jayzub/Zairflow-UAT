doctype html
html(lang="en")
  head
    title= title
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    include ../partials/links

  body.animsition
    // Header
    include ../partials/header
    
    // Cart
    include ../partials/cart

    // breadcrumb
    .container
      .bread-crumb.flex-w.p-l-25.p-r-15.p-t-30.p-lr-0-lg
        a.stext-109.cl8.hov-cl1.trans-04(href="index.html")
          | Home
          i.fa.fa-angle-right.m-l-9.m-r-10(aria-hidden="true")
        
        a.stext-109.cl8.hov-cl1.trans-04(href="product.html")
          | Men
          i.fa.fa-angle-right.m-l-9.m-r-10(aria-hidden="true")
        
        span.stext-109.cl4= product.name

    // Product Detail
    section.sec-product-detail.bg0.p-t-65.p-b-60
      .container
        .row
          .col-md-6.col-lg-7.p-b-30
            .p-l-25.p-r-30.p-lr-0-lg
              .wrap-slick3.flex-sb.flex-w
                .wrap-slick3-dots
                .wrap-slick3-arrows.flex-sb-m.flex-w
                .slick3.gallery-lb
                  each img, index in product.images
                    .item-slick3(data-thumb=`/${img}`)
                      .wrap-pic-w.pos-relative
                        img(src=`/${img}` alt=`IMG-PRODUCT-${index + 1}`)
                        a.flex-c-m.size-108.how-pos1.bor0.fs-16.cl10.bg0.hov-btn3.trans-04(href=`/${img}`)
                          i.fa.fa-expand

          .col-md-6.col-lg-5.p-b-30
            .p-r-50.p-t-5.p-lr-0-lg
              h4.mtext-105.cl2.js-name-detail.p-b-14= product.name
              span.mtext-106.cl2 $#{product.price}
              p.stext-102.cl3.p-t-23= product.description

              .p-t-33
                // Size Selection
                if product.size && product.size.length > 0
                  .flex-w.flex-r-m.p-b-10
                    .size-203.flex-c-m.respon6 Size
                    .size-204.respon6-next
                      .rs1-select2.bor8.bg0
                        select.js-select2(name="size")
                          option Choose an option
                          each size in product.size
                            option= size
                        .dropDownSelect2

                // Color Selection
                if product.color && product.color.length > 0
                  .flex-w.flex-r-m.p-b-10
                    .size-203.flex-c-m.respon6 Color
                    .size-204.respon6-next
                      .rs1-select2.bor8.bg0
                        select.js-select2(name="color")
                          option Choose an option
                          each color in product.color
                            option= color
                        .dropDownSelect2

                // Quantity Selection
                .flex-w.flex-r-m.p-b-10
                  .size-204.flex-w.flex-m.respon6-next
                    .wrap-num-product.flex-w.m-r-20.m-tb-10
                      .btn-num-product-down.cl8.hov-btn3.trans-04.flex-c-m
                        i.fs-16.zmdi.zmdi-minus
                      input.mtext-104.cl3.txt-center.num-product(type="number" name="num-product" value="1" min="1" max=product.countInStock)
                      .btn-num-product-up.cl8.hov-btn3.trans-04.flex-c-m
                        i.fs-16.zmdi.zmdi-plus
                    button.flex-c-m.stext-101.cl0.size-101.bg1.bor1.hov-btn1.p-lr-15.trans-04.js-addcart-detail
                      | Add to cart

              // Social Buttons
              .flex-w.flex-m.p-l-100.p-t-40.respon7
                .flex-m.bor9.p-r-10.m-r-11
                  a.fs-14.cl3.hov-cl1.trans-04.lh-10.p-lr-5.p-tb-2.js-addwish-detail.tooltip100(href="#" data-tooltip="Add to Wishlist")
                    i.zmdi.zmdi-favorite
                
                a.fs-14.cl3.hov-cl1.trans-04.lh-10.p-lr-5.p-tb-2.m-r-8.tooltip100(href="#" data-tooltip="Facebook")
                  i.fa.fa-facebook
                
                a.fs-14.cl3.hov-cl1.trans-04.lh-10.p-lr-5.p-tb-2.m-r-8.tooltip100(href="#" data-tooltip="Twitter")
                  i.fa.fa-twitter
                
                a.fs-14.cl3.hov-cl1.trans-04.lh-10.p-lr-5.p-tb-2.m-r-8.tooltip100(href="#" data-tooltip="Google Plus")
                  i.fa.fa-google-plus

        // Tabs Section
        .bor10.m-t-50.p-t-43.p-b-40
          .tab01
            // Nav tabs
            ul.nav.nav-tabs(role="tablist")
              li.nav-item.p-b-10
                a.nav-link.active(data-toggle="tab" href="#description" role="tab") Description
              li.nav-item.p-b-10
                a.nav-link(data-toggle="tab" href="#information" role="tab") Additional information
              li.nav-item.p-b-10
                a.nav-link(data-toggle="tab" href="#reviews" role="tab") Reviews (1)

            // Tab Content
            .tab-content.p-t-43
              #description.tab-pane.fade.show.active(role="tabpanel")
                .how-pos2.p-lr-15-md
                  //- p.stext-102.cl6= product.richDescription

              #information.tab-pane.fade(role="tabpanel")
                .row
                  .col-sm-10.col-md-8.col-lg-6.m-lr-auto
                    ul.p-lr-28.p-lr-15-sm
                      li.flex-w.flex-t.p-b-7
                        span.stext-102.cl3.size-205 Weight
                        span.stext-102.cl6.size-206 0.79 kg
                      // ... (rest of the information items)

              #reviews.tab-pane.fade(role="tabpanel")
                .row
                  .col-sm-10.col-md-8.col-lg-6.m-lr-auto
                    .p-b-30.m-lr-15-sm
                      // Review
                      .flex-w.flex-t.p-b-68
                        // ... (review content)

                      // Add review form
                      form.w-full
                        // ... (review form content)

        .bg6.flex-c-m.flex-w.size-302.m-t-73.p-tb-15
          span.stext-107.cl6.p-lr-25 SKU: JAK-01
          span.stext-107.cl6.p-lr-25
            | Categories: 
            if product.category && product.category.length > 0
              each cat, index in product.category
                = cat.name + (index < product.category.length - 1 ? ', ' : '')
            else
              | No categories available

    // Related Products
    include ../partials/relatedProducts

    // Footer
    include ../partials/footer

    // Back to top
    #myBtn.btn-back-to-top
      span.symbol-btn-back-to-top
        i.zmdi.zmdi-chevron-up

    // Modal1
    include ../partials/productModal

    // Scripts
    include ../partials/scripts 