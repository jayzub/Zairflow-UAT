include cart/CartDropdown

mixin Topbar
  .ecommerce-topbar
    nav.navbar.navbar-expand-lg.navbar-light.px-0
      .row.gx-0.gy-2.w-100.flex-between-center
        .col-auto
          -
            var homeHref = (typeof isCustomerStorefront !== 'undefined' && isCustomerStorefront)
              ? '/home'
              : `${CWD}${paths['default-dashboard']}`;
          a.text-decoration-none(href=homeHref)
            +Logo
        .col-auto.order-md-1
          ul.navbar-nav.navbar-nav-icons.flex-row.me-n2
            li.nav-item.d-flex.align-items-center
              +ToggleThemeBtn.px-2
            li.nav-item.dropdown
              a#navbarTopDropdownCart.nav-link.px-2.icon-indicator.icon-indicator-primary(href='#' role='button' data-bs-toggle='dropdown' data-bs-auto-close='outside' aria-haspopup='true' aria-expanded='false')
                span.text-body-tertiary(data-feather='shopping-cart' style="height:20px;width:20px;")
                span.icon-indicator-number#cartBadgeCount 0
              +CartDropdown.mt-2
            li.nav-item.dropdown
              a#navbarTopDropdownNotification.nav-link.px-2.icon-indicator.icon-indicator-sm.icon-indicator-danger(href='#' role='button' data-bs-toggle='dropdown' data-bs-auto-close="outside" aria-haspopup='true' aria-expanded='false')
                span.text-body-tertiary(data-feather='bell' style="height:20px;width:20px;")
              +NotificationDropdown.mt-2

            li.nav-item.dropdown
              a#navbarDropdownUser.nav-link.px-2(href='#' role='button' data-bs-toggle='dropdown' data-bs-auto-close="outside" aria-haspopup='true' aria-expanded='false')
                span.text-body-tertiary(data-feather='user' style="height:20px;width:20px;")
              +ProfileDropdown.mt-2
        .col-12.col-md-6
          .position-relative.ecommerce-search-wrapper
            +Search({placeholder: 'Search', inputClass: 'form-control-sm', inputId: 'customer-product-search-input'}).ecommerce-search-box.w-100
            #search-suggestions-dropdown.search-suggestions-dropdown.list-group.shadow-sm.border.rounded.d-none(style='position:absolute;top:100%;left:0;right:0;margin-top:0.25rem;max-height:20rem;overflow-y:auto;min-width:100%;z-index:1060;')
              .list-group-item.text-body-tertiary.py-2.small No suggestions