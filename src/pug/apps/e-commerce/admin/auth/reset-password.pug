extends ../../../../layouts/LayoutTheme
include ../../../../layouts/LayoutCardAuth

block wrapperContent
  +LayoutCardBasic({img:37, page: 'reset-password'})
    .auth-form-box
      .text-center.mb-7
        a(href=`${CWD}${paths['default-dashboard']}`).d-flex.flex-center.text-decoration-none.mb-4
          +Logo({text:false,width:58}).fw-bolder.fs-3.d-inline-block
        h3.text-body-highlight Reset Password
        p.text-body-tertiary Enter your new password below
      
      form#resetPasswordForm
        .mb-3
          label.form-label(for='newPassword') New Password
          .form-icon-container(data-password)
            input#newPassword.form-control.form-icon-input.pe-6(type='password' placeholder='New Password' data-password-input required)
            span.fas.fa-key.text-body.fs-9.form-icon
            button.btn.px-3.py-0.h-100.position-absolute.top-0.end-0.fs-7.text-body-tertiary(type='button' data-password-toggle)
              span.uil.uil-eye.show
              span.uil.uil-eye-slash.hide
        
        .mb-3
          label.form-label(for='confirmPassword') Confirm New Password
          .form-icon-container(data-password)
            input#confirmPassword.form-control.form-icon-input.pe-6(type='password' placeholder='Confirm New Password' data-password-input required)
            span.fas.fa-key.text-body.fs-9.form-icon
            button.btn.px-3.py-0.h-100.position-absolute.top-0.end-0.fs-7.text-body-tertiary(type='button' data-password-toggle)
              span.uil.uil-eye.show
              span.uil.uil-eye-slash.hide
        
        button.btn.btn-primary.w-100.mb-3(type='submit') Reset Password
        
        //- Loading spinner (hidden by default)
        .text-center.mb-3.d-none#loadingSpinner
          .spinner-border.spinner-border-sm.text-primary.me-2(role='status')
          span Resetting password...
        
        //- Error message container
        .alert.alert-danger.d-none#errorMessage(role='alert')
          span#errorText
        
        //- Success message container
        .alert.alert-success.d-none#successMessage(role='alert')
          span#successText
      
      .text-center
        a.fs-9.fw-bold(href=`${CWD}${paths['card-signin']}`) Back to Sign In

block append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('resetPasswordForm');
      const loadingSpinner = document.getElementById('loadingSpinner');
      const errorMessage = document.getElementById('errorMessage');
      const successMessage = document.getElementById('successMessage');
      const errorText = document.getElementById('errorText');
      const successText = document.getElementById('successText');
      
      // Get token from URL parameters
      const urlParams = new URLSearchParams(window.location.search);
      const token = urlParams.get('token');
      
      if (!token) {
        showError('Invalid reset link. Please request a new password reset.');
        form.style.display = 'none';
        return;
      }
      
      // Hide messages initially
      function hideMessages() {
        errorMessage.classList.add('d-none');
        successMessage.classList.add('d-none');
      }
      
      // Show error message
      function showError(message) {
        hideMessages();
        errorText.textContent = message;
        errorMessage.classList.remove('d-none');
      }
      
      // Show success message
      function showSuccess(message) {
        hideMessages();
        successText.textContent = message;
        successMessage.classList.remove('d-none');
      }
      
      // Show/hide loading spinner
      function setLoading(loading) {
        if (loading) {
          loadingSpinner.classList.remove('d-none');
          form.querySelector('button[type="submit"]').disabled = true;
        } else {
          loadingSpinner.classList.add('d-none');
          form.querySelector('button[type="submit"]').disabled = false;
        }
      }
      
      // Password validation
      function validatePassword(password) {
        const minLength = 6;
        const hasUpperCase = /[A-Z]/.test(password);
        const hasLowerCase = /[a-z]/.test(password);
        const hasNumbers = /\d/.test(password);
        
        if (password.length < minLength) {
          return 'Password must be at least 6 characters long';
        }
        if (!hasUpperCase || !hasLowerCase) {
          return 'Password must contain both uppercase and lowercase letters';
        }
        if (!hasNumbers) {
          return 'Password must contain at least one number';
        }
        return null;
      }
      
      // Handle form submission
      form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;
        
        // Basic validation
        if (!newPassword || !confirmPassword) {
          showError('Please fill in all fields');
          return;
        }
        
        if (newPassword !== confirmPassword) {
          showError('Passwords do not match');
          return;
        }
        
        const passwordError = validatePassword(newPassword);
        if (passwordError) {
          showError(passwordError);
          return;
        }
        
        setLoading(true);
        hideMessages();
        
        try {
          // Note: This endpoint would need to be implemented in the backend
          const response = await fetch('/api/v1/users/reset-password', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              token: token,
              newPassword: newPassword
            })
          });
          
          const data = await response.json();
          
          if (response.ok && data.success) {
            showSuccess('Password reset successfully! Redirecting to sign in...');
            
            // Redirect to sign in page after a short delay
            setTimeout(() => {
              window.location.href = '/admin/auth/sign-in';
            }, 2000);
            
          } else {
            showError(data.message || 'Password reset failed. Please try again.');
          }
          
        } catch (error) {
          console.error('Reset password error:', error);
          showError('Network error. Please try again.');
        } finally {
          setLoading(false);
        }
      });
    }); 