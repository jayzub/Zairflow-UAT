extends  layouts/LayoutShowcase
include  mixins/navbars/NavbarShowcase

append variables
	- var hideSettingPanel = true;
	- var attrsFooter = { class: 'd-flex justify-content-center bg-body border-0'}

append scripts
	script(src=`${CWD}assets/js/showcase.js`)

block mainContent
	+Navbar
	.container.py-8
		.row.justify-content-center
			.col-12.col-lg-8.text-center
				h1.mb-4 Showcase Page
				p.text-body-secondary.mb-6 This page has been simplified for the e-commerce focus.
				.btn-group
					a.btn.btn-primary.me-3(href="/") Go to Dashboard
					a.btn.btn-outline-primary(href="/api/v1/products") View Products
	+Footer
