extends ../../layouts/LayoutComponent

append variables
  -
    var pageHeader = {
      title: 'Font Awesome Icons',
      description: 'The web\'s most popular icon toolkit',
      url: `https://fontawesome.com/`,
      linkText: 'Font Awesome Documentation',
    }

block component
  .mb-9
    +ComponentCard({
      title: 'Font Awesome Icons',
      anchor: true,
      hideCopyCode: true,
      description: 'Font Awesome icon functionality has been simplified for e-commerce focus.'
    }).my-5
      .text-center.py-8
        h4.text-body-secondary Font Awesome Icons
        p.text-body-quaternary Icon functionality has been simplified for e-commerce focus.



